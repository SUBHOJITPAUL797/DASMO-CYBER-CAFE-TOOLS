<Window x:Class="SmartSaver.Views.ScanEnhancerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmartSaver.Converters"
        xmlns:services="clr-namespace:SmartSaver.Services"
        Title="DASMO CYBER COMPRESSOR — Document Scanner Enhancer" Height="630" Width="840"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanConverter x:Key="InverseBool"/>
        <local:StringEqualsConverter x:Key="StringEquals"/>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- Background Texture -->
            <Image Source="pack://application:,,,/Resources/background_photo.png" Stretch="UniformToFill" Opacity="0.25" IsHitTestVisible="False" Grid.RowSpan="3"/>

            <!-- Title Bar -->
            <Grid Background="{StaticResource SurfaceBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="⚡ " FontSize="14"/>
                    <TextBlock Text="DASMO CYBER COMPRESSOR — Document Scanner Enhancer" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🗕" Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" ToolTip="Minimize"/>
                    <Button Content="✕" Style="{StaticResource TitleBarCloseButton}" Click="CloseButton_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- Main Content: 2-Column Split -->
            <Grid Grid.Row="1" Margin="15,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Controls & Configuration -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,10,0">
                    <StackPanel>
                        <!-- File Info Card -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🖨️" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="Original Size: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                        <TextBlock Text="{Binding FileSizeFormatted}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Filter Selection -->
                        <GroupBox Header="1. Enhancement Filter Mode" Margin="0,0,0,8">
                            <StackPanel Margin="0,4">
                                <RadioButton IsChecked="{Binding SelectedFilter, Converter={StaticResource StringEquals}, ConverterParameter={x:Static services:ScanFilterType.MagicWhite}}" 
                                             FontWeight="SemiBold" Margin="0,2,0,6">
                                    <StackPanel>
                                        <TextBlock Text="✨ Magic White (Clean Shadows, Keep Color)" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="Whitens dark paper shadows while preserving ink signatures &amp; stamps." 
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton IsChecked="{Binding SelectedFilter, Converter={StaticResource StringEquals}, ConverterParameter={x:Static services:ScanFilterType.XeroxBlackAndWhite}}" 
                                             FontWeight="SemiBold" Margin="0,4,0,6">
                                    <StackPanel>
                                        <TextBlock Text="🖨️ Xerox Photocopier (Crisp Black &amp; White)" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="Converts to high-contrast crisp black &amp; white." 
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton IsChecked="{Binding SelectedFilter, Converter={StaticResource StringEquals}, ConverterParameter={x:Static services:ScanFilterType.GrayscaleClean}}" 
                                             FontWeight="SemiBold" Margin="0,4,0,2">
                                    <StackPanel>
                                        <TextBlock Text="📑 Clean Grayscale Document" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="Smooth grayscale tone with boosted text contrast." 
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </GroupBox>

                        <!-- Intensity & Whitening Slider -->
                        <GroupBox Header="2. Whitening &amp; Contrast Intensity" Margin="0,0,0,8">
                            <StackPanel Margin="0,4">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Intensity Level:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding IntensityText}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                </Grid>
                                
                                <Slider Minimum="10" Maximum="100" Value="{Binding Intensity, UpdateSourceTrigger=PropertyChanged}"
                                        SmallChange="5" LargeChange="10" TickFrequency="10" Margin="0,2,0,2"/>

                                <Grid Margin="0,2,0,0">
                                    <TextBlock Text="Soft" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Default (80%)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Ultra White" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- Compression & Portal Presets -->
                        <GroupBox Header="3. Target Size &amp; Portal Presets (Optional)" Margin="0,0,0,8">
                            <StackPanel Margin="0,4">
                                <CheckBox Content="Compress enhanced output to target file size" IsChecked="{Binding IsCompressEnabled}" FontWeight="SemiBold" Margin="0,0,0,6"/>

                                <StackPanel Visibility="{Binding IsCompressEnabled, Converter={StaticResource BoolToVis}}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="Portal Preset: " VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding PortalPresets}" SelectedItem="{Binding SelectedPortalPreset}" DisplayMemberPath="Name"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="65"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="Target Size:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding TargetSizeKB, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                                        <ComboBox Grid.Column="2" SelectedValue="{Binding TargetSizeUnit, Mode=TwoWay}" SelectedValuePath="Content">
                                            <ComboBoxItem Content="KB"/>
                                            <ComboBoxItem Content="MB"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- Destination -->
                        <GroupBox Header="4. Output Destination" Margin="0,0,0,8">
                            <StackPanel Margin="0,4">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="File Name:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding OutputFileName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="Save Folder:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="2" Content="📁 Browse..." Style="{StaticResource ChipButton}" Command="{Binding BrowseDirectoryCommand}"/>
                                </Grid>

                                <CheckBox Content="Open enhanced scan automatically when finished" IsChecked="{Binding OpenOnComplete}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Result Box -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="10" Margin="0,4,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Visibility="{Binding ResultText, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="📂 Open Image" Style="{StaticResource ChipButton}" Command="{Binding OpenResultCommand}" 
                                        Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right Column: Live Document Preview -->
                <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Live Preview Header & Toggle -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="👁️ Live Document Preview" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Updates in real-time as you tweak intensity" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="{Binding PreviewModeLabel}" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleCompareCommand}" Padding="10,4" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Viewport Canvas -->
                        <Border Grid.Row="1" Background="#141414" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                            <Grid>
                                <!-- Placeholder -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasFile, Converter={StaticResource InverseBool}}">
                                    <TextBlock Text="📄" FontSize="36" HorizontalAlignment="Center" Opacity="0.5"/>
                                    <TextBlock Text="No Image Loaded" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>

                                <!-- Live Preview Image -->
                                <Image Source="{Binding PreviewImageSource}" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom Action Bar -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="15,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>

                    <Button Grid.Column="1" Content="Cancel" Width="80" Margin="0,0,10,0" Command="{Binding CancelCommand}"/>
                    <Button Grid.Column="2" Content="✨ Enhance &amp; Save" Style="{StaticResource PrimaryButton}" Command="{Binding EnhanceCommand}" Width="160"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
