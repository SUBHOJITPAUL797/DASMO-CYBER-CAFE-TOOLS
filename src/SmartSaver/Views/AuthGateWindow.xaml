<Window x:Class="SmartSaver.Views.AuthGateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DASMO CYBER CAFE TOOLS — Cloud License Verification"
        Width="540" Height="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        MouseDown="Window_MouseDown">

    <Border Background="#161622" CornerRadius="12" BorderBrush="#2D2D44" BorderThickness="1.5">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar / Close -->
                <RowDefinition Height="Auto"/> <!-- Logo & Header -->
                <RowDefinition Height="Auto"/> <!-- Hardware Badge -->
                <RowDefinition Height="*"/>    <!-- Dynamic State Container -->
                <RowDefinition Height="Auto"/> <!-- Footer / Contact -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0">
                <TextBlock Text="DASMO SECURITY SHIELD" FontSize="11" FontWeight="Bold" Foreground="#6C7293" VerticalAlignment="Center"/>
                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" Click="Close_Click"
                        Background="Transparent" Foreground="#A0A0C0" BorderThickness="0" FontSize="14" Cursor="Hand"/>
            </Grid>

            <!-- Header Section -->
            <StackPanel Grid.Row="1" Margin="0,16,0,16" HorizontalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="32" Background="#1E293B" BorderBrush="#00BCD4" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="🛡️" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="DASMO CYBER CAFE TOOLS" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                <TextBlock Text="Cloud Licensing &amp; Physical Hardware Lock" FontSize="12" Foreground="#8F9CAE" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Physical PC Hardware Fingerprint Card -->
            <Border Grid.Row="2" Background="#1C1D2A" CornerRadius="8" Padding="12,10" Margin="0,0,0,16" BorderBrush="#2A2B3D" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PHYSICAL PC HARDWARE ID (1-DEVICE LOCK)" FontSize="10" FontWeight="Bold" Foreground="#00BCD4"/>
                        <TextBlock x:Name="TxtHardwareId" Text="PC-XXXX-XXXX-XXXX-XXXX" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,3,0,1"/>
                        <TextBlock x:Name="TxtDeviceModel" Text="Detected PC Model" FontSize="11" Foreground="#718096"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="📋 Copy" Click="CopyHwId_Click" VerticalAlignment="Center"
                            Background="#26283B" Foreground="#00BCD4" BorderThickness="0" Padding="10,6" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- Dynamic State Panes Container -->
            <Grid Grid.Row="3">
                <!-- 1. LOGIN / REGISTRATION PANE -->
                <StackPanel x:Name="PaneLogin" Visibility="Visible" VerticalAlignment="Center">
                    <TextBlock Text="Full Name:" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtName" Height="38" FontSize="13" VerticalContentAlignment="Center" Padding="10,0"
                             Background="#1F2033" Foreground="#FFFFFF" BorderBrush="#3B3D5B" BorderThickness="1.5" Margin="0,0,0,10">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <TextBlock Text="Email Address:" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtEmail" Height="38" FontSize="13" VerticalContentAlignment="Center" Padding="10,0"
                             Background="#1F2033" Foreground="#FFFFFF" BorderBrush="#3B3D5B" BorderThickness="1.5"
                             KeyDown="TxtEmail_KeyDown">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <Button x:Name="BtnLogin" Content="🔓 Connect &amp; Verify License" Click="Login_Click"
                            Height="42" Margin="0,14,0,0" FontSize="14" FontWeight="Bold" Cursor="Hand"
                            Background="#00BCD4" Foreground="#0F172A" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Contact Admin Card -->
                    <Border Background="#1C2438" CornerRadius="6" Padding="10,8" Margin="0,12,0,0" BorderBrush="#2563EB" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="📞 Admin Support:" FontSize="11" FontWeight="SemiBold" Foreground="#60A5FA" Margin="0,0,6,0"/>
                            <TextBlock Text="+91 8927408840" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Cursor="Hand" TextDecorations="Underline" MouseDown="PhoneContact_MouseDown" ToolTip="Click to WhatsApp or call Admin"/>
                            <TextBlock Text=" • " FontSize="11" Foreground="#64748B" Margin="6,0,6,0"/>
                            <TextBlock Text="subhojitpaul26042004@gmail.com" FontSize="11" Foreground="#38BDF8" Cursor="Hand" TextDecorations="Underline" MouseDown="EmailContact_MouseDown" ToolTip="Click to email admin"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="• Physical PC lock: 1 Account is tied to this computer." FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- 2. LOADING PANE -->
                <StackPanel x:Name="PaneLoading" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="6" Background="#26283B" Foreground="#00BCD4" Margin="0,0,16,0"/>
                    <TextBlock x:Name="TxtLoadingMessage" Text="Connecting to Firebase Cloud Security..." FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 3. PENDING APPROVAL PANE -->
                <Border x:Name="PanePending" Visibility="Collapsed" Background="#1E202F" CornerRadius="10" BorderBrush="#F59E0B" BorderThickness="1.5" Padding="20">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⏳" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="AWAITING ADMIN APPROVAL" FontSize="16" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtPendingEmail" Text="user@email.com" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Center" Margin="0,4,0,0"/>

                        <Border Background="#26273B" CornerRadius="6" Padding="12,10" Margin="0,14,0,14">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Account registered on this PC. Please contact Admin Subhojit Paul for approval:"
                                           FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="📱 Mobile / WhatsApp: " FontSize="12" Foreground="#94A3B8"/>
                                    <TextBlock Text="+91 8927408840" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Cursor="Hand" TextDecorations="Underline" MouseDown="PhoneContact_MouseDown" ToolTip="Click to WhatsApp Admin"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <TextBlock Text="✉️ Email: " FontSize="12" Foreground="#94A3B8"/>
                                    <TextBlock Text="subhojitpaul26042004@gmail.com" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Cursor="Hand" TextDecorations="Underline" MouseDown="EmailContact_MouseDown" ToolTip="Click to email admin"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="• Listening for admin approval in real-time..." FontSize="11" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="🔄 Refresh Status" Click="CheckStatusNow_Click"
                                    Background="#3B82F6" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,8" Margin="0,0,10,0" Cursor="Hand" BorderThickness="0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                            <Button Content="👤 Change Account" Click="SwitchAccount_Click"
                                    Background="#334155" Foreground="#CBD5E1" Padding="14,8" Cursor="Hand" BorderThickness="0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 4. DEVICE MISMATCH PANE -->
                <Border x:Name="PaneMismatch" Visibility="Collapsed" Background="#26161C" CornerRadius="10" BorderBrush="#EF4444" BorderThickness="1.5" Padding="20">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🚫" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="HARDWARE LOCK VIOLATION" FontSize="16" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center"/>
                        <TextBlock Text="This account is registered to a different physical computer." FontSize="12" Foreground="#FCA5A5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>

                        <Border Background="#331A21" CornerRadius="6" Padding="12,10" Margin="0,14,0,14">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="1 Account = 1 Physical PC. Account sharing is strictly prevented. Contact Subhojit Paul to reset or transfer your device:"
                                           FontSize="11" Foreground="#FECACA" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="📱 Mobile / WhatsApp: " FontSize="11" Foreground="#F87171"/>
                                    <TextBlock Text="+91 8927408840" FontSize="11" FontWeight="Bold" Foreground="#67E8F9" Cursor="Hand" TextDecorations="Underline" MouseDown="PhoneContact_MouseDown"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                                    <TextBlock Text="✉️ Email: " FontSize="11" Foreground="#F87171"/>
                                    <TextBlock Text="subhojitpaul26042004@gmail.com" FontSize="11" FontWeight="Bold" Foreground="#67E8F9" Cursor="Hand" TextDecorations="Underline" MouseDown="EmailContact_MouseDown"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button Content="👤 Use Different Account" Click="SwitchAccount_Click"
                                Background="#334155" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="16,8" Cursor="Hand" BorderThickness="0" HorizontalAlignment="Center">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 5. BANNED PANE -->
                <Border x:Name="PaneBanned" Visibility="Collapsed" Background="#26161C" CornerRadius="10" BorderBrush="#EF4444" BorderThickness="1.5" Padding="20">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⛔" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="ACCESS SUSPENDED" FontSize="16" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center"/>
                        <TextBlock Text="This account has been restricted by the administrator." FontSize="12" Foreground="#FCA5A5" TextAlignment="Center" Margin="0,8,0,0"/>

                        <Border Background="#331A21" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📞 Admin Support: " FontSize="11" Foreground="#F87171"/>
                                <TextBlock Text="+91 8927408840" FontSize="11" FontWeight="Bold" Foreground="#67E8F9" Cursor="Hand" TextDecorations="Underline" MouseDown="PhoneContact_MouseDown"/>
                            </StackPanel>
                        </Border>

                        <Button Content="👤 Try Another Account" Click="SwitchAccount_Click"
                                Margin="0,14,0,0" Background="#334155" Foreground="#FFFFFF" Padding="14,8" Cursor="Hand" BorderThickness="0" HorizontalAlignment="Center">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Footer / Developer Info -->
            <StackPanel Grid.Row="4" Margin="0,12,0,0" HorizontalAlignment="Center">
                <TextBlock Text="DASMO Cyber Cafe Suite • Cloud Security Protocol" FontSize="10" Foreground="#475569" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
