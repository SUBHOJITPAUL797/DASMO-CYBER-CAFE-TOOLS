<Window x:Class="SmartSaver.Views.ImageToPdfDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmartSaver.Converters"
        Title="DASMO CYBER COMPRESSOR — Convert Images to PDF (A4 Fit)" Height="620" Width="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" AllowDrop="True" Drop="Window_Drop">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- Background Texture -->
            <Image Source="pack://application:,,,/Resources/background_photo.png" Stretch="UniformToFill" Opacity="0.30" IsHitTestVisible="False" Grid.RowSpan="4"/>

            <!-- Title Bar -->
            <Grid Background="{StaticResource SurfaceBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="⚡ " FontSize="14"/>
                    <TextBlock Text="DASMO CYBER COMPRESSOR — Convert Images to A4 PDF" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🗕" Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" ToolTip="Minimize"/>
                    <Button Content="✕" Style="{StaticResource TitleBarCloseButton}" Click="CloseButton_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- Main Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,10">
                <StackPanel>
                    <!-- File List Card -->
                    <GroupBox Header="1. Selected Images (Drag &amp; Drop or Add)">
                        <Grid Margin="0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="140"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ListBox Grid.Row="0" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                                     Background="#181926" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🖼️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding FileSizeFormatted}" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- List Toolbar -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="➕ Add Images..." Style="{StaticResource ChipButton}" Command="{Binding AddFilesCommand}"/>
                                <Button Content="🗑️ Remove" Style="{StaticResource ChipButton}" Command="{Binding RemoveFileCommand}"/>
                                <Button Content="⬆ Move Up" Style="{StaticResource ChipButton}" Command="{Binding MoveUpCommand}"/>
                                <Button Content="⬇ Move Down" Style="{StaticResource ChipButton}" Command="{Binding MoveDownCommand}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Layout Options -->
                    <GroupBox Header="2. Page Layout" Margin="0,8,0,0">
                        <StackPanel Margin="0,4">
                            <CheckBox Content="Fit &amp; Center each image neatly onto standard A4 paper" IsChecked="{Binding FitToA4}" FontWeight="SemiBold"/>
                            <TextBlock Text="Automatically switches between Portrait and Landscape orientation based on image dimensions." 
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="24,2,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Target Compression -->
                    <GroupBox Header="3. Target Compression &amp; Portal Presets (Optional)" Margin="0,8,0,0">
                        <StackPanel Margin="0,4">
                            <CheckBox Content="Compress output PDF to exact target size" IsChecked="{Binding IsCompressEnabled}" FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <StackPanel Visibility="{Binding IsCompressEnabled, Converter={StaticResource BoolToVis}}">
                                <!-- Portal Presets Dropdown -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="Portal Preset: " VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding PortalPresets}" SelectedItem="{Binding SelectedPortalPreset}" DisplayMemberPath="Name"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="Target Size:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding TargetSizeKB, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                                    <ComboBox Grid.Column="2" SelectedValue="{Binding TargetSizeUnit, Mode=TwoWay}" SelectedValuePath="Content">
                                        <ComboBoxItem Content="KB"/>
                                        <ComboBoxItem Content="MB"/>
                                    </ComboBox>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Button Content="100 KB" Style="{StaticResource ChipButton}" Command="{Binding SetPresetSizeCommand}" CommandParameter="100"/>
                                    <Button Content="200 KB" Style="{StaticResource ChipButton}" Command="{Binding SetPresetSizeCommand}" CommandParameter="200"/>
                                    <Button Content="500 KB" Style="{StaticResource ChipButton}" Command="{Binding SetPresetSizeCommand}" CommandParameter="500"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Destination Folder -->
                    <GroupBox Header="4. Output Destination" Margin="0,8,0,0">
                        <StackPanel Margin="0,4">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="File Name:" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding OutputFileName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Save Folder:" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="2" Content="📁 Browse..." Style="{StaticResource ChipButton}" Command="{Binding BrowseDirectoryCommand}"/>
                            </Grid>

                            <CheckBox Content="Open PDF automatically when finished" IsChecked="{Binding OpenOnComplete}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Result Box -->
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="10" Margin="0,8,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Visibility="{Binding ResultText, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="📂 Open PDF" Style="{StaticResource ChipButton}" Command="{Binding OpenResultCommand}" 
                                    Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Action Bar -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="15,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>

                    <Button Grid.Column="1" Content="Cancel" Width="80" Margin="0,0,10,0" Command="{Binding CancelCommand}"/>
                    <Button Grid.Column="2" Content="📄 Convert to PDF" Style="{StaticResource PrimaryButton}" Command="{Binding ConvertCommand}" Width="160"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
