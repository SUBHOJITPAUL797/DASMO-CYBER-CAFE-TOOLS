<Window x:Class="SmartSaver.Views.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Software Update Available — DASMO CYBER CAFE TOOLS"
        Width="520" Height="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#0B0D14"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#161826"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1C1E2F"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A2C42"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00BCD4"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#26C6DA"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" CornerRadius="12" ClipToBounds="True">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title & Icon -->
                <RowDefinition Height="Auto"/> <!-- Version Badges & Admin Message -->
                <RowDefinition Height="*"/>    <!-- Changelog & Highlights (Scrollable) -->
                <RowDefinition Height="Auto"/> <!-- Download Progress / Action Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="#162B35" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Margin="0,0,12,0">
                    <TextBlock Text="🚀" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="SOFTWARE UPDATE AVAILABLE" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="A new optimized release is available for your cyber cafe." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Close / Later Button -->
                <Button Grid.Column="2" Content="✕" Width="28" Height="28" Background="Transparent" Foreground="#64748B" BorderThickness="0" FontSize="13" Cursor="Hand" Click="Close_Click" ToolTip="Dismiss (Remind Me Later)"/>
            </Grid>

            <!-- 2. Version Diff & Badges -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Current Version -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="CURRENT VERSION" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtCurrentVersion" Text="v1.5.29" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Arrow -->
                        <TextBlock Grid.Column="1" Text="➔" FontSize="15" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="10,0"/>

                        <!-- Latest Version -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="NEW VERSION" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtLatestVersion" Text="v1.5.30" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Admin Message (if any) -->
                <Border x:Name="BoxAdminMessage" Background="#1D1A22" CornerRadius="8" Padding="10,8" BorderBrush="#F59E0B" BorderThickness="1" Margin="0,8,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="📢 DEVELOPER NOTICE:" FontSize="10" FontWeight="Bold" Foreground="#F59E0B"/>
                        <TextBlock x:Name="TxtAdminMessage" Text="" FontSize="11" Foreground="#F1F5F9" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 3. Scrollable Changelog / Highlights Card -->
            <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,14" MaxHeight="170">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="✨ WHAT'S NEW IN THIS UPDATE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="TxtChangelog" 
                                   Text="• Performance improvements and bug fixes"
                                   FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="18"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 4. Downloader Progress & Action Buttons -->
            <StackPanel Grid.Row="3">
                <!-- Live Progress Section (Visible during download) -->
                <StackPanel x:Name="PanelProgress" Visibility="Collapsed" Margin="0,0,0,10">
                    <Grid Margin="0,0,0,5">
                        <TextBlock x:Name="TxtProgressStatus" Text="Downloading update installer..." FontSize="11" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock x:Name="TxtProgressStats" Text="0.0 MB / 0.0 MB • 0.0 MB/s" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar x:Name="ProgressBarDownload" Height="7" Minimum="0" Maximum="100" Value="0"
                                 Foreground="{StaticResource AccentBrush}" Background="#1E2033" BorderThickness="0">
                        <ProgressBar.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="3.5"/></Style>
                        </ProgressBar.Resources>
                    </ProgressBar>
                </StackPanel>

                <!-- Action Buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnDownloadUpdate" Content="🚀 Download &amp; Install Update Now" Click="DownloadUpdate_Click"
                            Background="{StaticResource AccentBrush}" Foreground="#0F172A" FontWeight="Bold" FontSize="12.5"
                            Height="40" Cursor="Hand" BorderThickness="0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>

                    <Button x:Name="BtnCancelDownload" Content="Cancel" Click="CancelDownload_Click" Visibility="Collapsed"
                            Background="#334155" Foreground="#E2E8F0" Height="40" Padding="14,0" Margin="8,0,0,0" Cursor="Hand" BorderThickness="0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>

                    <Button x:Name="BtnRemindLater" Content="Remind Me Later" Click="Close_Click"
                            Background="#1E2033" Foreground="{StaticResource TextSecondary}" Height="40" Padding="14,0" Margin="8,0,0,0" Cursor="Hand" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                            Grid.Column="1">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
