                            <StackPanel>
                                <TextBlock Text="Brother DCP-T530DW uses external ink bottles (BTD60BK / BT5000 C,M,Y) and does not have electronic liquid float sensors. If you refilled your tanks, set the visual ink level below to keep your meter audit 100% accurate without fake or hardcoded numbers."
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <!-- 1-Click Refill All Button -->
