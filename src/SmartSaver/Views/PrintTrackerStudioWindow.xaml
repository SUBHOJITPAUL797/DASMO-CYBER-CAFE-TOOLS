                                            ToolTip="Open full-featured Cash Drawer Window for cash in/out, expenses, customer borrow and float setup">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💰 " FontSize="12"/>
                                            <TextBlock Text="Launch Cash Drawer Window" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 7 Financial KPI Cards -->
                        <UniformGrid Columns="4" Rows="2" Margin="0,0,0,12">
