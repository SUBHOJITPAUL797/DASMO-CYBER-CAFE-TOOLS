                        <!-- Recent Cash Transactions Table -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="📜 TODAY'S REAL-TIME CASH &amp; UPI TRANSACTIONS" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Every print bill, Xerox, cash payment or expense appears here instantly" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Background="#191923" CornerRadius="6" Padding="4">
                                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding DrawerRecentTransactions}">
