                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🎛️ " FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="BROTHER DCP-T530DW — PHYSICAL INK REFILL &amp; CALIBRATION" FontWeight="Bold" FontSize="13" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Content="✕" HorizontalAlignment="Right" Command="{Binding CloseInkCalibrateModalCommand}"
                                        Style="{StaticResource StudioCloseButton}" Width="28" Height="28" FontSize="13"/>
                            </Grid>
                        </Border>

