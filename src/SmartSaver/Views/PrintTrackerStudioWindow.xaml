                                    <TextBlock Text="Shop bills &amp; payouts" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- 7. Customer Due -->
                            <Border Background="#1C1D27" CornerRadius="6" Padding="12,10" Margin="2,0,2,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="CUSTOMER BORROW / DUE" FontSize="10.5" FontWeight="Bold" Foreground="#FBBF24"/>
                                    <TextBlock Text="{Binding DrawerCustomerDue, StringFormat='₹{0:F2}'}" FontSize="18" FontWeight="Bold" Foreground="#FBBF24" Margin="0,2,0,0"/>
                                    <TextBlock Text="Unpaid customer balance" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- 8. Linked Excel Status -->
                            <Border Background="#1C1D27" CornerRadius="6" Padding="12,10" Margin="4,0,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="LINKED EXCEL WORKBOOK" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding AttachedExcelName}" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Content="🔗 Link" Command="{Binding LinkExcelFileCommand}" Style="{StaticResource CounterChipButton}" Padding="6,2" FontSize="10" Margin="0,0,4,0"/>
                                        <Button Content="📂 Open" Command="{Binding OpenAttachedExcelCommand}" Style="{StaticResource CounterChipButton}" Padding="6,2" FontSize="10"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
