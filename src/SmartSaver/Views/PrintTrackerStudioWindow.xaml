                                </StackPanel>
                            </Border>

                            <!-- 2. Cash In Drawer -->
                            <Border Background="#162920" CornerRadius="6" Padding="12,10" Margin="2,0,2,6" BorderBrush="#10B981" BorderThickness="1">
