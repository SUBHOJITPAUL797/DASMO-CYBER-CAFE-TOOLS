                                    <TextBlock Text="TOTAL CASH+UPI NET" FontSize="10.5" FontWeight="Bold" Foreground="#A78BFA"/>
                                    <TextBlock Text="{Binding DrawerTodayNet, StringFormat='₹{0:F2}'}" FontSize="18" FontWeight="Bold" Foreground="#A78BFA" Margin="0,2,0,0"/>
                                    <TextBlock Text="Cash + UPI combined" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- 5. Total Income -->
                            <Border Background="#1C1D27" CornerRadius="6" Padding="12,10" Margin="0,0,4,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
