                  Background="#D00A0B12" Grid.RowSpan="3" Panel.ZIndex="999">
                <Border Background="#1A1C2B" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="12"
                        Width="560" MaxHeight="540" HorizontalAlignment="Center" VerticalAlignment="Center"
                        SnapsToDevicePixels="True">
