                                    <TextBlock Text="TOTAL INCOME" FontSize="10.5" FontWeight="Bold" Foreground="#34D399"/>
                                    <TextBlock Text="{Binding DrawerTotalIncome, StringFormat='₹{0:F2}'}" FontSize="18" FontWeight="Bold" Foreground="#34D399" Margin="0,2,0,0"/>
