<Window x:Class="SmartSaver.Views.PrintTrackerStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartSaver.Converters"
        mc:Ignorable="d"
        Title="🖨️ DASMO CYBER CAFE — Automatic Print Counter &amp; Customer Billing Studio" 
        Height="660" Width="1160" MinHeight="460" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False" Background="{StaticResource BackgroundBrush}"
        ResizeMode="CanResize"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:StringEqualsConverter x:Key="StringEquals"/>
        <local:DoubleStringConverter x:Key="DoubleStr"/>

        <Style x:Key="StudioHeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StudioCloseButton" TargetType="Button" BasedOn="{StaticResource StudioHeaderButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E53935"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CounterChipButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WorkspaceTabBtn" TargetType="Button">
            <Setter Property="Background" Value="#1C1D27"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" x:FieldModifier="public" Background="{StaticResource BackgroundBrush}" 
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/> <!-- Custom Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Status Strip & Rates Toolbar -->
                <RowDefinition Height="*"/> <!-- Main Workspace -->
            </Grid.RowDefinitions>

            <!-- ── Top Title Bar ── -->
            <Grid Grid.Row="0" Background="{StaticResource SurfaceBrush}" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="🖨️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="DASMO CYBER CAFE" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text=" — Automatic Print Counter, Meter &amp; Customer Billing Studio" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <Border Background="#10B981" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ALL-IN-ONE V1.5.19" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="🗕" Style="{StaticResource StudioHeaderButton}" Click="Minimize_Click" ToolTip="Minimize"/>
                    <Button x:Name="BtnMaximize" Content="🗖" Style="{StaticResource StudioHeaderButton}" Click="Maximize_Click" ToolTip="Maximize / Restore"/>
                    <Button Content="✕" Style="{StaticResource StudioCloseButton}" Click="Close_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- ── Top Navigation Tabs & Brother Live Status Strip ── -->
            <StackPanel Grid.Row="1">
                <!-- 1. Segmented Navigation Tabs -->
                <Border Background="#181924" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,6,14,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <!-- Tab 0: Active Billing -->
                            <Button Content="📑 1. Active Counter &amp; Billing" Command="{Binding SwitchTabCommand}" CommandParameter="0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource WorkspaceTabBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTabBilling}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                <Setter Property="BorderThickness" Value="1.5,1.5,1.5,0"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Tab 1: Hardware Meter & Xerox Audit -->
                            <Button Content="📊 2. Hardware Meter &amp; Xerox Audit" Command="{Binding SwitchTabCommand}" CommandParameter="1">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource WorkspaceTabBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTabMeterAudit}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
                                                <Setter Property="Foreground" Value="#38BDF8"/>
                                                <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                <Setter Property="BorderThickness" Value="1.5,1.5,1.5,0"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Tab 2: Sales History -->
                            <Button Content="📜 3. Completed Bills &amp; Sales History" Command="{Binding SwitchTabCommand}" CommandParameter="2">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource WorkspaceTabBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTabSalesHistory}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
                                                <Setter Property="Foreground" Value="#10B981"/>
                                                <Setter Property="BorderBrush" Value="#10B981"/>
                                                <Setter Property="BorderThickness" Value="1.5,1.5,1.5,0"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Tab 3: Cash Drawer & Accounts -->
                            <Button Content="💰 4. Daily Cash Drawer &amp; Accounts" Command="{Binding SwitchTabCommand}" CommandParameter="3">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource WorkspaceTabBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTabCashDrawer}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                                <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                <Setter Property="BorderThickness" Value="1.5,1.5,1.5,0"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <!-- Quick Cash Drawer Launch on Right -->
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,4"
                                Command="{Binding OpenCashDrawerCommand}" Style="{StaticResource CounterChipButton}"
                                Background="#1A2036" BorderBrush="#F59E0B" Foreground="#F59E0B" FontWeight="Bold" Padding="10,3" FontSize="11"
                                ToolTip="Open Full Daily Cash Drawer, UPI &amp; Accounts Window">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💰 " FontSize="11"/>
                                <TextBlock Text="Open Cash Drawer Window" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Status Bar: Live Brother Hardware & Rate Card Quick Strip -->
                <Border Background="#23232C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Spooler + Brother Connection + Live Inks -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Windows Spooler -->
                            <TextBlock Text="{Binding SpoolerStatusIcon}" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SpoolerStatusText}" FontWeight="SemiBold" FontSize="11" Foreground="White" VerticalAlignment="Center"/>
                            <Button Content="🔄 Poll Spooler" Command="{Binding PollNowCommand}" 
                                    Style="{StaticResource CounterChipButton}" Margin="6,0,0,0" Padding="6,2" FontSize="10.5"
                                    ToolTip="Query Windows print queues immediately"/>

                            <Border Width="1" Height="16" Background="#444" Margin="8,0"/>

                            <!-- Brother Device Status -->
                            <TextBlock Text="{Binding DeviceStatusText}" FontWeight="SemiBold" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center"/>
                            
                            <!-- Smart Auto-Detect IP Button -->
                            <Button Content="🔍 Auto-Detect IP" Command="{Binding AutoDetectIpCommand}"
                                    Style="{StaticResource CounterChipButton}" Margin="6,0,0,0" Padding="7,2" FontSize="10.5"
                                    Background="#162938" BorderBrush="#38BDF8" Foreground="#38BDF8"
                                    ToolTip="Scan network subnets and ARP table to re-discover Brother printer if IP changed over Wi-Fi"/>

                            <Button Content="🔄 Refresh" Command="{Binding RefreshLiveStatusCommand}"
                                    Style="{StaticResource CounterChipButton}" Margin="4,0,0,0" Padding="6,2" FontSize="10.5"
                                    ToolTip="Fetch live printer status and ink levels over Wi-Fi"/>

                            <!-- Ink Gauges Strip -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="Ink: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,3,0"/>

                                <!-- BK -->
                                <Border Background="#1C1C24" CornerRadius="4" Padding="5,2" Margin="0,0,3,0" BorderBrush="#666" BorderThickness="1"
                                        ToolTip="Black Ink Tank (BTD60BK)">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="7" Height="7" Background="#111" CornerRadius="2" Margin="0,0,3,0" VerticalAlignment="Center" BorderBrush="#888" BorderThickness="1"/>
                                        <TextBlock Text="{Binding InkBlack, StringFormat='BK:{0}%', Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                </Border>

                                <!-- Cyan -->
                                <Border Background="#1C1C24" CornerRadius="4" Padding="5,2" Margin="0,0,3,0" BorderBrush="#00BCD4" BorderThickness="1"
                                        ToolTip="Cyan Ink Tank (BT5000C)">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="7" Height="7" Background="#00BCD4" CornerRadius="2" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding InkCyan, StringFormat='C:{0}%', Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#00BCD4"/>
                                    </StackPanel>
                                </Border>

                                <!-- Magenta -->
                                <Border Background="#1C1C24" CornerRadius="4" Padding="5,2" Margin="0,0,3,0" BorderBrush="#E91E63" BorderThickness="1"
                                        ToolTip="Magenta Ink Tank (BT5000M)">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="7" Height="7" Background="#E91E63" CornerRadius="2" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding InkMagenta, StringFormat='M:{0}%', Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#E91E63"/>
                                    </StackPanel>
                                </Border>

                                <!-- Yellow -->
                                <Border Background="#1C1C24" CornerRadius="4" Padding="5,2" Margin="0,0,4,0" BorderBrush="#FFEB3B" BorderThickness="1"
                                        ToolTip="Yellow Ink Tank (BT5000Y)">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="7" Height="7" Background="#FFEB3B" CornerRadius="2" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding InkYellow, StringFormat='Y:{0}%', Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#FFEB3B"/>
                                    </StackPanel>
                                </Border>

                                <!-- Calibrated / Refill Button -->
                                <Button Content="🎛️ Refill / Calibrate" Command="{Binding OpenInkCalibrateModalCommand}"
                                        Style="{StaticResource CounterChipButton}" Margin="2,0,0,0" Padding="6,2" FontSize="10"
                                        Background="#262238" BorderBrush="#A78BFA" Foreground="#C4B5FD"
                                        ToolTip="Calibrate physical tank levels or set to 100% after pouring ink bottles"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: Rate Card Badges & Custom Prices Editor Trigger -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Rate Card: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <Button Content="{Binding BwSingleSideRate, StringFormat='⚫ ₹{0:0.##}'}" Click="OpenRateSettings_Click"
                                    Style="{StaticResource CounterChipButton}" Margin="0,0,3,0" Padding="6,2" FontSize="10" ToolTip="Click to customize B&amp;W print price"/>
                            <Button Content="{Binding BwDuplexRate, StringFormat='📑 ₹{0:0.##}'}" Click="OpenRateSettings_Click"
                                    Style="{StaticResource CounterChipButton}" Margin="0,0,3,0" Padding="6,2" FontSize="10" Foreground="#10B981" BorderBrush="#10B981" ToolTip="Click to customize Duplex print price"/>
                            <Button Content="{Binding ColorSingleSideRate, StringFormat='🌈 ₹{0:0.##}'}" Click="OpenRateSettings_Click"
                                    Style="{StaticResource CounterChipButton}" Margin="0,0,3,0" Padding="6,2" FontSize="10" Foreground="#00BCD4" BorderBrush="#00BCD4" ToolTip="Click to customize Color print price"/>
                            <Button Content="{Binding PhotoGlossyRate, StringFormat='📸 ₹{0:0.##}'}" Click="OpenRateSettings_Click"
                                    Style="{StaticResource CounterChipButton}" Margin="0,0,4,0" Padding="6,2" FontSize="10" Foreground="#FF9800" BorderBrush="#FF9800" ToolTip="Click to customize Photo print price"/>
                            <Button Content="⚙️ Set Rates" Click="OpenRateSettings_Click"
                                    Style="{StaticResource CounterChipButton}" Margin="2,0,0,0" Padding="8,2" FontSize="10.5"
                                    Background="#1A2E26" BorderBrush="#10B981" Foreground="#10B981" FontWeight="Bold"
                                    ToolTip="Customize B&amp;W, Color, Duplex &amp; Photo print rates"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ── Main Workspace: 4 Integrated Views ── -->
            <Grid Grid.Row="2">
                <!-- ════ TAB 0: ACTIVE CUSTOMER BILLING CART (2-Column Layout) ════ -->
                <Grid Visibility="{Binding IsTabBilling, Converter={StaticResource BoolToVis}}" Margin="14">
                    <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" MinWidth="480"/> <!-- Left: Active Customer Billing Station -->
                    <ColumnDefinition Width="12"/> <!-- Splitter / Gap -->
                    <ColumnDefinition Width="5*" MinWidth="400"/> <!-- Right: Daily Sales, History & Rates -->
                </Grid.ColumnDefinitions>

                <!-- ════ LEFT COLUMN: ACTIVE CUSTOMER BILLING CART ════ -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Customer Info Bar -->
                        <RowDefinition Height="Auto"/> <!-- Live Grand Total Banner -->
                        <RowDefinition Height="*"/>    <!-- Print Jobs Table -->
                        <RowDefinition Height="Auto"/> <!-- Quick Rush-Hour Photocopy Pad -->
                        <RowDefinition Height="Auto"/> <!-- Bottom Finish Bill Actions -->
                    </Grid.RowDefinitions>

                    <!-- Customer Info Header & Live Alert Banner -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,6">
                        <!-- Live Detected Print Toast Banner -->
                        <Border Background="#1A2E26" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="6"
                                Padding="10,6" Margin="0,0,0,6"
                                Visibility="{Binding HasRecentDetectedJob, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding RecentDetectedJobText}" FontWeight="Bold" FontSize="11.5" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Content="✕" HorizontalAlignment="Right" Command="{Binding DismissDetectedJobBannerCommand}"
                                        Style="{StaticResource StudioHeaderButton}" Width="24" Height="22" FontSize="11" Foreground="#A0AEC0" ToolTip="Dismiss"/>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="8,6"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Customer Name -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Customer Name / Ref:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" 
                                         Padding="8,5" FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>

                            <!-- Customer Mobile (for WhatsApp) -->
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Mobile No. (for WhatsApp Bill):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}" 
                                         Padding="8,5" FontSize="13" ToolTip="10-digit customer WhatsApp number"/>
                            </StackPanel>

                            <!-- Payment Mode -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Payment Mode:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding PaymentMode}" SelectedValuePath="Content" Height="30">
                                    <ComboBoxItem Content="Cash" IsSelected="True"/>
                                    <ComboBoxItem Content="UPI / QR Code"/>
                                    <ComboBoxItem Content="Due / Account"/>
                                    <ComboBoxItem Content="Card"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>
                    </StackPanel>

                    <!-- Big Live Total Banner -->
                    <Border Grid.Row="1" CornerRadius="8" Margin="0,0,0,6" Padding="12,8"
                            Background="#1A2E26" BorderBrush="#10B981" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="CURRENT CUSTOMER TOTAL" FontSize="11" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ActiveCartTotalCostDisplay}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text=" INR" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📄 " FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ActiveCartTotalPages, StringFormat='{}{0} Pages'}" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock Text=" • " Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="📑 " FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ActiveCartTotalSheets, StringFormat='{}{0} Sheets'}" FontWeight="Bold" FontSize="13" Foreground="#10B981" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Active Print Jobs Table -->
                    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" 
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="4">
                        <Grid>
                            <!-- Empty State -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"
                                        Visibility="{Binding HasActiveJobs, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                <TextBlock Text="🖨️" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.6"/>
                                <TextBlock Text="Waiting for Print Jobs..." FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Print from Chrome, Adobe Reader, Word, or DASMO Tools to your Brother DCP-T530DW." 
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="The print counter will automatically detect page count, duplex &amp; price!" 
                                           Foreground="#10B981" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Jobs List -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding ActiveJobs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#2A2A38" CornerRadius="6" Padding="12,10" Margin="4,3"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Document Info -->
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding DocumentName}" FontWeight="Bold" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <TextBlock Text="{Binding PrinterName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Text=" • " Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:hh:mm tt}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Text=" • " Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="#00BCD4" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Pages Stepper -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <Button Content="−" Width="26" Height="26" Padding="0" FontSize="14" FontWeight="Bold"
                                                                Command="{Binding DataContext.DecrementPagesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource CounterChipButton}" Margin="0,0,4,0" ToolTip="Decrease page count"/>
                                                        <Border Background="{StaticResource BackgroundBrush}" CornerRadius="4" Padding="8,3" MinWidth="34">
                                                            <TextBlock Text="{Binding Pages}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Button Content="+" Width="26" Height="26" Padding="0" FontSize="14" FontWeight="Bold"
                                                                Command="{Binding DataContext.IncrementPagesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource CounterChipButton}" Margin="4,0,0,0" ToolTip="Increase page count"/>
                                                    </StackPanel>

                                                    <!-- 1-Click Duplex Toggle -->
                                                    <Button Grid.Column="2" 
                                                            Command="{Binding DataContext.ToggleDuplexCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand" Margin="0,0,8,0" Padding="8,4"
                                                            ToolTip="Click to toggle between Single-Sided (1 sheet = 1 page) and Double-Sided Duplex (1 sheet = 2 pages)">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource CounterChipButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDuplex}" Value="True">
                                                                        <Setter Property="Background" Value="#1A3324"/>
                                                                        <Setter Property="BorderBrush" Value="#10B981"/>
                                                                        <Setter Property="Foreground" Value="#10B981"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsDuplex}" Value="False">
                                                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📑 " FontSize="11"/>
                                                            <TextBlock Text="{Binding IsDuplex, Converter={StaticResource StringEquals}, ConverterParameter='True', FallbackValue='Single'}" Visibility="Collapsed"/>
                                                            <TextBlock Text="Duplex (2-in-1)" FontWeight="SemiBold" FontSize="11"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- 1-Click Color Toggle -->
                                                    <Button Grid.Column="3" 
                                                            Command="{Binding DataContext.ToggleColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand" Margin="0,0,12,0" Padding="8,4"
                                                            ToolTip="Click to toggle between Black &amp; White and Color">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource CounterChipButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsColor}" Value="True">
                                                                        <Setter Property="Background" Value="#1A2D3D"/>
                                                                        <Setter Property="BorderBrush" Value="#00BCD4"/>
                                                                        <Setter Property="Foreground" Value="#00BCD4"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsColor}" Value="False">
                                                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🌈 " FontSize="11"/>
                                                            <TextBlock Text="Color" FontWeight="SemiBold" FontSize="11"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Amount & Delete -->
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TotalCost, StringFormat='₹{0:F2}'}" FontWeight="Bold" FontSize="14" Foreground="White" Width="65" TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <Button Content="✕" Width="26" Height="26" Padding="0" FontSize="12" Foreground="#F44336"
                                                                Command="{Binding DataContext.RemoveJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource CounterChipButton}" ToolTip="Remove this job"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Rush-Hour Quick Photocopy / Manual Pad -->
                    <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="10,8" Margin="0,6,0,6"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="⚡ Quick Manual Counter (Photocopy / Xerox / Offline Add):" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <WrapPanel Orientation="Horizontal">
                                <Button Content="➕ +1 B&amp;W (₹2)" Command="{Binding AddQuickPhotocopyBwCommand}" CommandParameter="1" Style="{StaticResource CounterChipButton}" Margin="0,0,4,4"/>
                                <Button Content="➕ +5 B&amp;W (₹10)" Command="{Binding AddQuickPhotocopyBwCommand}" CommandParameter="5" Style="{StaticResource CounterChipButton}" Margin="0,0,4,4"/>
                                <Button Content="➕ +10 B&amp;W (₹20)" Command="{Binding AddQuickPhotocopyBwCommand}" CommandParameter="10" Style="{StaticResource CounterChipButton}" Margin="0,0,4,4"/>
                                <Button Content="📑 +1 Duplex (₹3)" Command="{Binding AddQuickDuplexBwCommand}" CommandParameter="1" Style="{StaticResource CounterChipButton}" Foreground="#10B981" Margin="0,0,4,4"/>
                                <Button Content="📑 +5 Duplex (₹15)" Command="{Binding AddQuickDuplexBwCommand}" CommandParameter="5" Style="{StaticResource CounterChipButton}" Foreground="#10B981" Margin="0,0,4,4"/>
                                <Button Content="🌈 +1 Color (₹10)" Command="{Binding AddQuickPhotocopyColorCommand}" CommandParameter="1" Style="{StaticResource CounterChipButton}" Foreground="#00BCD4" Margin="0,0,4,4"/>
                                <Button Content="📸 Passport Photo (₹20)" Command="{Binding AddQuickPhotoCommand}" Style="{StaticResource CounterChipButton}" Foreground="#FF9800" Margin="0,0,4,4"/>
                                <Button Content="🛡️ Lamination (₹20)" Command="{Binding AddQuickLaminationCommand}" Style="{StaticResource CounterChipButton}" Margin="0,0,4,4"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Bottom Action Buttons: Finish Bill / Next Customer -->
                    <Grid Grid.Row="4" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="✕ Clear" Command="{Binding ClearCartCommand}" 
                                Style="{StaticResource CounterChipButton}" Padding="8,8" Margin="0,0,5,0"
                                ToolTip="Clear active unbilled jobs"/>

                        <Button Grid.Column="1" Command="{Binding SaveBillPdfCommand}"
                                Style="{StaticResource CounterChipButton}" Padding="8,8" Margin="0,0,5,0"
                                Background="#1A2238" BorderBrush="#00BCD4" Foreground="#00BCD4"
                                ToolTip="Generate professional PDF bill receipt to view or share">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄 " FontSize="12"/>
                                <TextBlock Text="Bill PDF" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Command="{Binding ShareWhatsAppCommand}"
                                Style="{StaticResource CounterChipButton}" Padding="8,8" Margin="0,0,5,0"
                                ToolTip="Send bill details to customer WhatsApp">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📱 " FontSize="12"/>
                                <TextBlock Text="WhatsApp" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- BIG FINISH BILL BUTTON -->
                        <Button Grid.Column="3" Command="{Binding CompleteBillCommand}"
                                Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="13"
                                Padding="14,10" Cursor="Hand" BorderThickness="0"
                                ToolTip="Finalizes bill, saves into daily sales history, and clears for next customer! Shortcut: Enter / Space">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="✅ " FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="BILL DONE &amp; NEXT CUSTOMER (Enter / Space)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <!-- ════ RIGHT COLUMN: DAILY SALES, HISTORY & RATES ════ -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Daily Analytics Summary Cards -->
                        <RowDefinition Height="Auto"/> <!-- Search & Date Filter Bar -->
                        <RowDefinition Height="*"/>    <!-- Completed Bills / Job Log -->
                    </Grid.RowDefinitions>

                    <!-- Daily Analytics Cards -->
                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="📊 TODAY'S CYBER CAFE PRINT COUNTER STATS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>

                            <UniformGrid Grid.Row="1" Columns="4" Rows="1">
                                <!-- Revenue -->
                                <Border Background="#1A2E26" CornerRadius="6" Padding="8,6" Margin="0,0,4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="REVENUE" FontSize="10" Foreground="#10B981" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TodayRevenue, StringFormat='₹{0:F0}'}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                </Border>
                                <!-- Total Pages -->
                                <Border Background="{StaticResource BackgroundBrush}" CornerRadius="6" Padding="8,6" Margin="2,0,2,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="PAGES" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TodayPages}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                </Border>
                                <!-- Duplex Sheets -->
                                <Border Background="{StaticResource BackgroundBrush}" CornerRadius="6" Padding="8,6" Margin="2,0,2,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="DUPLEX" FontSize="10" Foreground="#10B981" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TodayDuplexSheets}" FontSize="18" FontWeight="Bold" Foreground="#10B981"/>
                                    </StackPanel>
                                </Border>
                                <!-- Color Pages -->
                                <Border Background="{StaticResource BackgroundBrush}" CornerRadius="6" Padding="8,6" Margin="4,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="COLOR" FontSize="10" Foreground="#00BCD4" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TodayColorPages}" FontSize="18" FontWeight="Bold" Foreground="#00BCD4"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <!-- Filter & Search Bar -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,10"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Date Filter ComboBox -->
                            <ComboBox Grid.Column="0" SelectedValue="{Binding HistoryDateFilter}" SelectedValuePath="Content" Width="105" Height="28" Margin="0,0,8,0">
                                <ComboBoxItem Content="Today" IsSelected="True"/>
                                <ComboBoxItem Content="Yesterday"/>
                                <ComboBoxItem Content="Last 7 Days"/>
                                <ComboBoxItem Content="All Time"/>
                            </ComboBox>

                            <!-- Search Box -->
                            <TextBox Grid.Column="1" Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="6,3" VerticalContentAlignment="Center" FontSize="12" Margin="0,0,8,0"
                                     ToolTip="Search by customer name, mobile, document, or bill number"/>

                            <!-- Export Excel, CSV & Set Prices Buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Command="{Binding ExportExcelCommand}"
                                        Style="{StaticResource CounterChipButton}" Padding="8,4" Margin="0,0,5,0"
                                        Background="#162920" BorderBrush="#10B981" Foreground="#10B981" FontWeight="Bold"
                                        ToolTip="Export comprehensive finance Excel (.xlsx) spreadsheet">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📊 " FontSize="11"/>
                                        <TextBlock Text="Excel" FontWeight="Bold" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ExportCsvCommand}"
                                        Style="{StaticResource CounterChipButton}" Padding="8,4" Margin="0,0,5,0"
                                        ToolTip="Export sales report to CSV">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📥 " FontSize="11"/>
                                        <TextBlock Text="CSV" FontWeight="SemiBold" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding LinkExcelFileCommand}"
                                        Style="{StaticResource CounterChipButton}" Padding="7,4" Margin="0,0,5,0"
                                        Background="#151A2E" BorderBrush="#38BDF8" Foreground="#38BDF8" FontWeight="SemiBold"
                                        ToolTip="{Binding AttachedExcelPath, StringFormat='Linked Excel: {0} (Click to link or attach .xlsx workbook)'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔗 " FontSize="11"/>
                                        <TextBlock Text="{Binding AttachedExcelName}" MaxWidth="110" TextTrimming="CharacterEllipsis" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SyncExcelNowCommand}"
                                        Style="{StaticResource CounterChipButton}" Padding="7,4" Margin="0,0,5,0"
                                        Background="#152E28" BorderBrush="#10B981" Foreground="#34D399" FontWeight="SemiBold"
                                        ToolTip="Manually sync all bills and cash drawer ledger into linked Excel workbook">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡ " FontSize="11"/>
                                        <TextBlock Text="Sync" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="⚙️ Set Prices" Click="OpenRateSettings_Click"
                                        Style="{StaticResource CounterChipButton}" Padding="8,4" Margin="0"
                                        Background="#1A2E26" BorderBrush="#10B981" Foreground="#10B981" FontWeight="Bold"
                                        ToolTip="Set custom rates for B&amp;W, Duplex, Color, and Photos"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Completed Bills History List -->
                    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" 
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="4">
                        <Grid>
                            <!-- Empty History -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"
                                        Visibility="{Binding FilteredBills.Count, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                <TextBlock Text="📋" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6" Opacity="0.5"/>
                                <TextBlock Text="No Customer Bills Yet Today" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Completed customer bills will be neatly listed here." 
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Bills List -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FilteredBills}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#252532" CornerRadius="6" Padding="10,8" Margin="3,3"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Bill Info -->
                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding BillNumber}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                                                            <TextBlock Text=" • " Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                                                        </StackPanel>
                                                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                            <Run Text="{Binding BilledAt, Mode=OneWay, StringFormat='{}{0:hh:mm tt}'}"/>
                                                            <Run Text=" • "/>
                                                            <Run Text="{Binding TotalPages, Mode=OneWay, StringFormat='{}{0} pages'}"/>
                                                            <Run Text=" ("/>
                                                            <Run Text="{Binding TotalSheets, Mode=OneWay, StringFormat='{}{0} sheets'}"/>
                                                            <Run Text=") • "/>
                                                            <Run Text="{Binding PaymentMode, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- Total Amount -->
                                                    <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat='₹{0:F2}'}" 
                                                               FontWeight="Bold" FontSize="14" Foreground="#10B981" 
                                                               VerticalAlignment="Center" Margin="10,0"/>

                                                    <!-- Actions (PDF, WhatsApp, Copy, Delete) -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="📄" Width="26" Height="26" Padding="0" FontSize="11" Margin="0,0,3,0"
                                                                Command="{Binding DataContext.SaveBillPdfCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource CounterChipButton}" ToolTip="View &amp; Save PDF Bill receipt"/>
                                                        <Button Content="📱" Width="26" Height="26" Padding="0" FontSize="11" Margin="0,0,3,0"
                                                                Command="{Binding DataContext.ShareWhatsAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource CounterChipButton}" ToolTip="Share bill on WhatsApp"/>
                                                        <Button Content="📋" Width="26" Height="26" Padding="0" FontSize="11" Margin="0,0,3,0"
                                                                Command="{Binding DataContext.CopyReceiptCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource CounterChipButton}" ToolTip="Copy thermal receipt slip text"/>
                                                        <Button Content="🗑️" Width="26" Height="26" Padding="0" FontSize="11"
                                                                Command="{Binding DataContext.DeleteBillCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent" BorderThickness="0" Foreground="#F87171"
                                                                Cursor="Hand" ToolTip="Delete bill from history"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>

            <!-- ════ TAB 1: HARDWARE METER & WALK-UP XEROX AUDIT ════ -->
                <ScrollViewer Visibility="{Binding IsTabMeterAudit, Converter={StaticResource BoolToVis}}" 
                              VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel MaxWidth="1100" HorizontalAlignment="Center">
                        <!-- Top Hardware Info Bar -->
                        <Border Background="#1C1D2B" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" BorderBrush="#38BDF8" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖨️ " FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="Brother DCP-T530DW" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock Text=" • Dual-Mode USB/Wi-Fi Active" FontWeight="SemiBold" FontSize="12" Foreground="#38BDF8" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="⚡ High-speed printing over USB Spooler + Live ink &amp; meter tracking over Wi-Fi. If IP changes, click Auto-Detect below." 
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PrinterIp, StringFormat='IP: {0}'}" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button Content="🔍 Auto-Detect IP" Command="{Binding AutoDetectIpCommand}"
                                            Style="{StaticResource CounterChipButton}" Margin="0,0,6,0" Padding="10,4" FontSize="11"
                                            Background="#15283C" BorderBrush="#38BDF8" Foreground="#38BDF8" FontWeight="SemiBold"
                                            ToolTip="Scan Wi-Fi subnets and ARP table to find Brother printer if IP changed"/>
                                    <Button Content="🔄 Refresh Status" Command="{Binding RefreshLiveStatusCommand}"
                                            Style="{StaticResource CounterChipButton}" Padding="10,4" FontSize="11"
                                            ToolTip="Query Brother embedded status page"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Section 1: Physical Meter Reconciliation -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,12"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📊 PHYSICAL HARDWARE METER RECONCILIATION" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Compares actual paper sheets moved through printer hardware against software PC spooler prints to find unbilled walk-up Xerox copies." 
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,0,0,12"/>

                                <!-- Meter Inputs Grid -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Opening Meter (Morning) -->
                                    <Border Grid.Column="0" Background="#262635" CornerRadius="6" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="🌅 Morning Opening Meter Reading:" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding OpeningMeter, UpdateSourceTrigger=PropertyChanged}" 
                                                         FontSize="15" FontWeight="Bold" Padding="8,4" VerticalContentAlignment="Center"/>
                                                <Button Grid.Column="1" Content="💾 Set Morning" Command="{Binding SaveOpeningMeterCommand}" 
                                                        Style="{StaticResource CounterChipButton}" Margin="6,0,0,0" Padding="10,4" Background="#162920" Foreground="#10B981" BorderBrush="#10B981"/>
                                            </Grid>
                                            <TextBlock Text="Start of day counter (carried over from yesterday)." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Closing / Current Meter (Now) -->
                                    <Border Grid.Column="2" Background="#262635" CornerRadius="6" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="🌙 Current / Closing Meter Reading:" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                                <Button Content="⚡ Auto-Read Wi-Fi" Command="{Binding AutoReadHardwareMeterCommand}" 
                                                        Style="{StaticResource CounterChipButton}" HorizontalAlignment="Right" Margin="0" Padding="8,2" FontSize="10.5"
                                                        Background="#1A2E26" Foreground="#10B981" BorderBrush="#10B981" FontWeight="Bold"
                                                        ToolTip="Fetch live hardware page count directly from Brother DCP-T530DW over Wi-Fi (No LCD screen check needed!)"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding CurrentHardwareMeter, UpdateSourceTrigger=PropertyChanged}" 
                                                         FontSize="15" FontWeight="Bold" Padding="8,4" VerticalContentAlignment="Center"/>
                                                <Button Grid.Column="1" Content="💾 Set Closing" Command="{Binding SaveClosingMeterCommand}" 
                                                        Style="{StaticResource CounterChipButton}" Margin="6,0,0,0" Padding="10,4" Background="#152636" Foreground="#00BCD4" BorderBrush="#00BCD4"/>
                                            </Grid>
                                            <TextBlock Text="⚡ Auto-read live over Wi-Fi directly from Brother hardware (0 manual typing)." FontSize="10.5" Foreground="#10B981" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Calculation Cards -->
                                <UniformGrid Columns="4" Rows="1" Margin="0,0,0,12">
                                    <!-- 1. Hardware Sheets -->
                                    <Border Background="#1E1E2C" CornerRadius="6" Padding="10,8" Margin="0,0,4,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="HARDWARE PAGES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding TotalHardwareSheets}" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                                            <TextBlock Text="Closing - Opening" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 2. PC Prints -->
                                    <Border Background="#1E1E2C" CornerRadius="6" Padding="10,8" Margin="2,0,2,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="PC SPOOLER PRINTS" FontSize="10" FontWeight="Bold" Foreground="#00BCD4"/>
                                            <TextBlock Text="{Binding TotalPcSpoolerPages}" FontSize="20" FontWeight="Bold" Foreground="#00BCD4" Margin="0,2,0,0"/>
                                            <TextBlock Text="From computer apps" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 3. Physical Xerox Made -->
                                    <Border Background="#1E1E2C" CornerRadius="6" Padding="10,8" Margin="2,0,2,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="ACTUAL XEROX" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                            <TextBlock Text="{Binding ActualPhysicalXerox}" FontSize="20" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0"/>
                                            <TextBlock Text="Machine - PC Prints" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 4. Unrecorded Discrepancy -->
                                    <Border Background="#1E1E2C" CornerRadius="6" Padding="10,8" Margin="4,0,0,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="UNRECORDED XEROX" FontSize="10" FontWeight="Bold" Foreground="#F43F5E"/>
                                            <TextBlock Text="{Binding UnrecordedXeroxCopies}" FontSize="20" FontWeight="Bold" Foreground="#F43F5E" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding UnrecordedXeroxAmount, StringFormat='₹{0:F2}'}" FontSize="10.5" FontWeight="Bold" Foreground="#F43F5E"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Unrecorded Alert & Auto-Add Action -->
                                <Border Background="#2B1D20" BorderBrush="#F43F5E" BorderThickness="1.5" CornerRadius="6" Padding="12,10"
                                        Visibility="{Binding HasUnrecordedXerox, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="⚠️ Unrecorded Physical Xerox Copies Detected!" FontWeight="Bold" FontSize="12.5" Foreground="#F43F5E"/>
                                            <TextBlock Text="{Binding UnrecordedXeroxCopies, StringFormat='The Brother machine produced {0} physical copies that were not recorded in the active register.'}" 
                                                       FontSize="11" Foreground="White" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Medium Choice -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                            <TextBlock Text="Deposit to: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <RadioButton Content="💵 Cash" IsChecked="{Binding SelectedMedium, Converter={StaticResource StringEquals}, ConverterParameter='Cash'}" 
                                                         Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <RadioButton Content="📱 UPI" IsChecked="{Binding SelectedMedium, Converter={StaticResource StringEquals}, ConverterParameter='UPI'}" 
                                                         Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Command="{Binding AutoLogMissingXeroxCommand}"
                                                Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="12" Padding="12,8" BorderThickness="0" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡ " FontSize="12"/>
                                                <TextBlock Text="{Binding UnrecordedXeroxAmount, StringFormat='Auto-Add ₹{0:F2} to Cash Drawer &amp; Excel'}"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Section 2: Rush-Hour 1-Click Physical Xerox Counter -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,12"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="⚡ RUSH-HOUR 1-CLICK PHYSICAL XEROX COUNTER" FontWeight="Bold" FontSize="12.5" Foreground="#10B981" Margin="0,0,0,4"/>
                                <TextBlock Text="Customer came for quick Xerox and paid cash? Click any button to instantly log into Cash Drawer &amp; Excel with ZERO typing!" 
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,0,0,10"/>

                                <WrapPanel Orientation="Horizontal">
                                    <Button Command="{Binding QuickLogWalkupXeroxCommand}" CommandParameter="1|false|false" Style="{StaticResource CounterChipButton}" Margin="0,0,6,6" Padding="12,8">
                                        <TextBlock Text="➕ 1 B&amp;W Xerox (₹2)" FontWeight="Bold" Foreground="White"/>
                                    </Button>
                                    <Button Command="{Binding QuickLogWalkupXeroxCommand}" CommandParameter="2|false|false" Style="{StaticResource CounterChipButton}" Margin="0,0,6,6" Padding="12,8">
                                        <TextBlock Text="➕ 2 B&amp;W Xerox (₹4)" FontWeight="Bold" Foreground="White"/>
                                    </Button>
                                    <Button Command="{Binding QuickLogWalkupXeroxCommand}" CommandParameter="5|false|false" Style="{StaticResource CounterChipButton}" Margin="0,0,6,6" Padding="12,8">
                                        <TextBlock Text="➕ 5 B&amp;W Xerox (₹10)" FontWeight="Bold" Foreground="White"/>
                                    </Button>
                                    <Button Command="{Binding QuickLogWalkupXeroxCommand}" CommandParameter="10|false|false" Style="{StaticResource CounterChipButton}" Margin="0,0,6,6" Padding="12,8">
                                        <TextBlock Text="➕ 10 B&amp;W Xerox (₹20)" FontWeight="Bold" Foreground="White"/>
                                    </Button>
                                    <Button Command="{Binding QuickLogWalkupXeroxCommand}" CommandParameter="1|true|false" Style="{StaticResource CounterChipButton}" Margin="0,0,6,6" Padding="12,8" BorderBrush="#10B981">
                                        <TextBlock Text="📑 1 Duplex B&amp;W (₹3)" FontWeight="Bold" Foreground="#10B981"/>
                                    </Button>
                                    <Button Command="{Binding QuickLogWalkupXeroxCommand}" CommandParameter="2|true|false" Style="{StaticResource CounterChipButton}" Margin="0,0,6,6" Padding="12,8" BorderBrush="#10B981">
                                        <TextBlock Text="📑 2 Duplex B&amp;W (₹6)" FontWeight="Bold" Foreground="#10B981"/>
                                    </Button>
                                    <Button Command="{Binding QuickLogWalkupXeroxCommand}" CommandParameter="1|false|true" Style="{StaticResource CounterChipButton}" Margin="0,0,6,6" Padding="12,8" BorderBrush="#00BCD4">
                                        <TextBlock Text="🌈 1 Color Xerox (₹10)" FontWeight="Bold" Foreground="#00BCD4"/>
                                    </Button>
                                    <Button Command="{Binding QuickLogWalkupXeroxCommand}" CommandParameter="2|false|true" Style="{StaticResource CounterChipButton}" Margin="0,0,6,6" Padding="12,8" BorderBrush="#00BCD4">
                                        <TextBlock Text="🌈 2 Color Xerox (₹20)" FontWeight="Bold" Foreground="#00BCD4"/>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Section 3: Live Ink Tank Status & Physical Calibration -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🎨 " FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="BROTHER DCP-T530DW INK TANK SENSORS &amp; PHYSICAL HEALTH" FontWeight="Bold" FontSize="12.5" Foreground="#A78BFA" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="⚡ Refill All 100%" Command="{Binding RefillAllTanks100Command}"
                                                Style="{StaticResource CounterChipButton}" Margin="0,0,6,0" Padding="10,4" FontSize="11"
                                                Background="#162920" BorderBrush="#10B981" Foreground="#10B981" FontWeight="Bold"
                                                ToolTip="Instantly mark all 4 tanks as 100% full"/>
                                        <Button Content="🎛️ Calibrate / Visual Sliders" Command="{Binding OpenInkCalibrateModalCommand}"
                                                Style="{StaticResource CounterChipButton}" Padding="10,4" FontSize="11"
                                                Background="#262238" BorderBrush="#A78BFA" Foreground="#C4B5FD" FontWeight="Bold"
                                                ToolTip="Adjust visual tank levels for Black, Cyan, Magenta, Yellow"/>
                                    </StackPanel>
                                </Grid>

                                <UniformGrid Grid.Row="1" Columns="4" Rows="1">
                                    <!-- BK -->
                                    <Border Background="#1C1D27" CornerRadius="6" Padding="12" Margin="0,0,4,0" BorderBrush="#666" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="BLACK (BTD60BK)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ProgressBar Value="{Binding InkBlack, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" Margin="0,8,0,6" Foreground="White" Background="#2A2A38" BorderThickness="0"/>
                                            <TextBlock Text="{Binding InkBlack, StringFormat='{}{0}%', Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Cyan -->
                                    <Border Background="#1C1D27" CornerRadius="6" Padding="12" Margin="2,0,2,0" BorderBrush="#00BCD4" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="CYAN (BT5000C)" FontSize="10.5" FontWeight="Bold" Foreground="#00BCD4"/>
                                            <ProgressBar Value="{Binding InkCyan, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" Margin="0,8,0,6" Foreground="#00BCD4" Background="#2A2A38" BorderThickness="0"/>
                                            <TextBlock Text="{Binding InkCyan, StringFormat='{}{0}%', Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#00BCD4"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Magenta -->
                                    <Border Background="#1C1D27" CornerRadius="6" Padding="12" Margin="2,0,2,0" BorderBrush="#E91E63" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="MAGENTA (BT5000M)" FontSize="10.5" FontWeight="Bold" Foreground="#E91E63"/>
                                            <ProgressBar Value="{Binding InkMagenta, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" Margin="0,8,0,6" Foreground="#E91E63" Background="#2A2A38" BorderThickness="0"/>
                                            <TextBlock Text="{Binding InkMagenta, StringFormat='{}{0}%', Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#E91E63"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Yellow -->
                                    <Border Background="#1C1D27" CornerRadius="6" Padding="12" Margin="4,0,0,0" BorderBrush="#FFEB3B" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="YELLOW (BT5000Y)" FontSize="10.5" FontWeight="Bold" Foreground="#FFEB3B"/>
                                            <ProgressBar Value="{Binding InkYellow, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" Margin="0,8,0,6" Foreground="#FFEB3B" Background="#2A2A38" BorderThickness="0"/>
                                            <TextBlock Text="{Binding InkYellow, StringFormat='{}{0}%', Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#FFEB3B"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ════ TAB 2: COMPLETED BILLS & SALES HISTORY ════ -->
                <Grid Visibility="{Binding IsTabSalesHistory, Converter={StaticResource BoolToVis}}" Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Analytics Cards -->
                        <RowDefinition Height="Auto"/> <!-- Search & Filter -->
                        <RowDefinition Height="*"/>    <!-- Full Bills Table -->
                    </Grid.RowDefinitions>

                    <!-- Daily Analytics Cards -->
                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="📊 TODAY'S CYBER CAFE SALES &amp; PRINT METRICS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>

                            <UniformGrid Grid.Row="1" Columns="6" Rows="1">
                                <!-- Revenue -->
                                <Border Background="#1A2E26" CornerRadius="6" Padding="8,6" Margin="0,0,3,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="REVENUE" FontSize="10" Foreground="#10B981" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TodayRevenue, StringFormat='₹{0:F0}'}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                </Border>
                                <!-- Total Pages -->
                                <Border Background="{StaticResource BackgroundBrush}" CornerRadius="6" Padding="8,6" Margin="3,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="PAGES" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TodayPages}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                </Border>
                                <!-- Total Sheets -->
                                <Border Background="{StaticResource BackgroundBrush}" CornerRadius="6" Padding="8,6" Margin="3,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="SHEETS" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TodaySheets}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                </Border>
                                <!-- Duplex Sheets -->
                                <Border Background="{StaticResource BackgroundBrush}" CornerRadius="6" Padding="8,6" Margin="3,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="DUPLEX" FontSize="10" Foreground="#10B981" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TodayDuplexSheets}" FontSize="18" FontWeight="Bold" Foreground="#10B981"/>
                                    </StackPanel>
                                </Border>
                                <!-- B&W Pages -->
                                <Border Background="{StaticResource BackgroundBrush}" CornerRadius="6" Padding="8,6" Margin="3,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="B&amp;W" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TodayBwPages}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                </Border>
                                <!-- Color Pages -->
                                <Border Background="{StaticResource BackgroundBrush}" CornerRadius="6" Padding="8,6" Margin="3,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="COLOR" FontSize="10" Foreground="#00BCD4" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TodayColorPages}" FontSize="18" FontWeight="Bold" Foreground="#00BCD4"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <!-- Filter & Search Bar -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,10"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" SelectedValue="{Binding HistoryDateFilter}" SelectedValuePath="Content" Width="110" Height="28" Margin="0,0,8,0">
                                <ComboBoxItem Content="Today" IsSelected="True"/>
                                <ComboBoxItem Content="Yesterday"/>
                                <ComboBoxItem Content="Last 7 Days"/>
                                <ComboBoxItem Content="All Time"/>
                            </ComboBox>

                            <TextBox Grid.Column="1" Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="6,3" VerticalContentAlignment="Center" FontSize="12" Margin="0,0,8,0"
                                     ToolTip="Search by customer name, mobile, document, or bill number"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Command="{Binding ExportExcelCommand}"
                                        Style="{StaticResource CounterChipButton}" Padding="8,4" Margin="0,0,5,0"
                                        Background="#162920" BorderBrush="#10B981" Foreground="#10B981" FontWeight="Bold"
                                        ToolTip="Export comprehensive finance Excel (.xlsx) spreadsheet">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📊 " FontSize="11"/>
                                        <TextBlock Text="Excel" FontWeight="Bold" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ExportCsvCommand}"
                                        Style="{StaticResource CounterChipButton}" Padding="8,4" Margin="0,0,5,0"
                                        ToolTip="Export sales report to CSV">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📥 " FontSize="11"/>
                                        <TextBlock Text="CSV" FontWeight="SemiBold" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding LinkExcelFileCommand}"
                                        Style="{StaticResource CounterChipButton}" Padding="7,4" Margin="0,0,5,0"
                                        Background="#151A2E" BorderBrush="#38BDF8" Foreground="#38BDF8" FontWeight="SemiBold"
                                        ToolTip="{Binding AttachedExcelPath, StringFormat='Linked Excel: {0}'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔗 " FontSize="11"/>
                                        <TextBlock Text="{Binding AttachedExcelName}" MaxWidth="110" TextTrimming="CharacterEllipsis" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SyncExcelNowCommand}"
                                        Style="{StaticResource CounterChipButton}" Padding="7,4" Margin="0"
                                        Background="#152E28" BorderBrush="#10B981" Foreground="#34D399" FontWeight="SemiBold"
                                        ToolTip="Manually sync all bills and cash ledger into linked Excel workbook">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡ " FontSize="11"/>
                                        <TextBlock Text="Sync" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Full Bills List -->
                    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" 
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredBills}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#252532" CornerRadius="6" Padding="12,10" Margin="4,3"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Bill Info -->
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding BillNumber}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource AccentBrush}"/>
                                                        <TextBlock Text=" • " Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold" FontSize="12.5" Foreground="White"/>
                                                        <TextBlock Text="{Binding CustomerPhone, StringFormat=' ({0})'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5"/>
                                                    </StackPanel>
                                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0">
                                                        <Run Text="{Binding BilledAt, Mode=OneWay, StringFormat='{}{0:dd MMM yyyy • hh:mm tt}'}"/>
                                                        <Run Text=" • "/>
                                                        <Run Text="{Binding TotalPages, Mode=OneWay, StringFormat='{}{0} pages'}"/>
                                                        <Run Text=" ("/>
                                                        <Run Text="{Binding TotalSheets, Mode=OneWay, StringFormat='{}{0} sheets'}"/>
                                                        <Run Text=") • Payment: "/>
                                                        <Run Text="{Binding PaymentMode, Mode=OneWay}" FontWeight="SemiBold" Foreground="White"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Total Amount -->
                                                <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat='₹{0:F2}'}" 
                                                           FontWeight="Bold" FontSize="16" Foreground="#10B981" 
                                                           VerticalAlignment="Center" Margin="16,0"/>

                                                <!-- Actions (PDF, WhatsApp, Copy, Delete) -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="📄 PDF" Padding="8,4" FontSize="11" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.SaveBillPdfCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource CounterChipButton}" ToolTip="View &amp; Save PDF Bill receipt"/>
                                                    <Button Content="📱 WhatsApp" Padding="8,4" FontSize="11" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.ShareWhatsAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource CounterChipButton}" ToolTip="Share bill on WhatsApp"/>
                                                    <Button Content="📋 Thermal Slip" Padding="8,4" FontSize="11" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.CopyReceiptCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource CounterChipButton}" ToolTip="Copy thermal receipt slip text"/>
                                                    <Button Content="🗑️" Width="28" Height="28" Padding="0" FontSize="11"
                                                            Command="{Binding DataContext.DeleteBillCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderThickness="0" Foreground="#F87171"
                                                            Cursor="Hand" ToolTip="Delete bill from history"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ════ TAB 3: DAILY CASH DRAWER & ACCOUNTS ════ -->
                <ScrollViewer Visibility="{Binding IsTabCashDrawer, Converter={StaticResource BoolToVis}}" 
                              VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel MaxWidth="1100" HorizontalAlignment="Center">
                        <!-- Top Summary Header -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,12"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💰 " FontSize="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="DAILY CASH DRAWER &amp; CYBER CAFE FINANCIAL OVERVIEW" FontWeight="Bold" FontSize="13.5" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="✨ 3-Way Synchronized: Print Counter, Cash Drawer, and attached Excel workbook are 100% connected in real-time."
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,3,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding RefreshDrawerStatsCommand}" Style="{StaticResource CounterChipButton}" Margin="0,0,6,0" Padding="10,4" FontSize="11" ToolTip="Refresh cash drawer balances">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔄 " FontSize="11"/>
                                            <TextBlock Text="Refresh Stats" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SyncExcelNowCommand}" Style="{StaticResource CounterChipButton}" Margin="0,0,6,0" Padding="10,4" FontSize="11"
                                            Background="#152E28" BorderBrush="#10B981" Foreground="#34D399" FontWeight="SemiBold" ToolTip="Sync all sales and cash ledger to Excel">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡ " FontSize="11"/>
                                            <TextBlock Text="Sync Excel" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding OpenCashDrawerCommand}" Style="{StaticResource CounterChipButton}" Padding="12,5" FontSize="11.5"
