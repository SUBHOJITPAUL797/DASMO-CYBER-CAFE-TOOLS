                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="10" Height="10" Background="#111" BorderBrush="#888" BorderThickness="1" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Black (BTD60BK)" FontWeight="SemiBold" FontSize="11" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CalibBlack}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CalibBlack, StringFormat='{}{0}%'}" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Cyan -->
                                <Border Background="#141520" CornerRadius="6" Padding="10,8" Margin="0,0,0,6" BorderBrush="#00BCD4" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="10" Height="10" Background="#00BCD4" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Cyan (BT5000C)" FontWeight="SemiBold" FontSize="11" Foreground="#00BCD4" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CalibCyan}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CalibCyan, StringFormat='{}{0}%'}" FontWeight="Bold" FontSize="12" Foreground="#00BCD4" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Magenta -->
                                <Border Background="#141520" CornerRadius="6" Padding="10,8" Margin="0,0,0,6" BorderBrush="#E91E63" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="10" Height="10" Background="#E91E63" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Magenta (BT5000M)" FontWeight="SemiBold" FontSize="11" Foreground="#E91E63" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CalibMagenta}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CalibMagenta, StringFormat='{}{0}%'}" FontWeight="Bold" FontSize="12" Foreground="#E91E63" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Yellow -->
                                <Border Background="#141520" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" BorderBrush="#FFEB3B" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="10" Height="10" Background="#FFEB3B" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Yellow (BT5000Y)" FontWeight="SemiBold" FontSize="11" Foreground="#FFEB3B" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CalibYellow}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CalibYellow, StringFormat='{}{0}%'}" FontWeight="Bold" FontSize="12" Foreground="#FFEB3B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Prefer Visual Level Checkbox -->
                                <CheckBox IsChecked="{Binding PreferVisualTanks}" Margin="0,4,0,0">
                                    <TextBlock Text="Prefer visual tank levels over printer ROM chip estimation (Recommended for manual bottle refills)" 
                                               FontSize="11" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                </CheckBox>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Footer -->
                        <Border Grid.Row="2" Background="#222538" CornerRadius="0,0,10,10" Padding="16,12" BorderBrush="#2D314A" BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="✕ Cancel" Command="{Binding CloseInkCalibrateModalCommand}" Width="90" Height="34" Margin="0,0,10,0"/>
                                <Button Content="✅ Save &amp; Apply Calibration" Command="{Binding SaveInkCalibrationCommand}"
                                        Background="#38BDF8" Foreground="#0B132B" FontWeight="Bold" FontSize="12"
                                        Width="190" Height="34" Cursor="Hand" BorderThickness="0">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
