                                                                <TextBlock Text="{Binding Category}" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="11.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="8,0"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Medium}" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding Amount, StringFormat='₹{0:F2}'}" FontSize="12.5" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
