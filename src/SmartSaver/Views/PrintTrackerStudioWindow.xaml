                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="⚡ Just Poured In Fresh Ink Bottles?" FontWeight="Bold" FontSize="12" Foreground="#10B981"/>
                                            <TextBlock Text="Click this button to set all 4 tanks (Black, Cyan, Magenta, Yellow) to 100% Full." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="⚡ Refill All 100%" Command="{Binding RefillAllTanks100Command}"
                                                Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="12" Padding="14,7" BorderThickness="0" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- 4 Color Sliders -->
                                <TextBlock Text="Adjust Individual Tank Levels:" FontWeight="Bold" FontSize="11.5" Foreground="White" Margin="0,0,0,8"/>

                                <!-- Black -->
