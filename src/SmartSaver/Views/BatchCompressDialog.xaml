<Window x:Class="SmartSaver.Views.BatchCompressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmartSaver.Converters"
        Title="DASMO CYBER COMPRESSOR — Batch Compress" Height="540" Width="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:StringEqualsConverter x:Key="StringEquals"/>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="10" BorderBrush="#444455" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="65"/>
            </Grid.RowDefinitions>

            <!-- Photo Background Layer -->
            <Image Source="pack://application:,,,/Resources/background_photo.png" Stretch="UniformToFill" Opacity="0.35" IsHitTestVisible="False" Grid.RowSpan="3"/>

            <!-- Custom Title Bar -->
            <Grid Background="{StaticResource SurfaceBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="⚡" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0" FontSize="14"/>
                    <TextBlock Text="DASMO CYBER COMPRESSOR — Batch Compress Files" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🗕" Width="35" Height="40" Background="Transparent" BorderThickness="0" Click="MinimizeButton_Click" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Button Content="✕" Width="40" Height="40" Background="Transparent" BorderThickness="0" Click="CloseButton_Click" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="20,15,20,15">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Batch Files Header Summary -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📁 Selected Files: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding TotalFileCount}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text=" files (" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding TotalOriginalSizeFormatted}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text=" total)" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Files ListBox -->
                        <ListBox ItemsSource="{Binding Items}" Height="120" Margin="0,0,0,12" Background="#181926" BorderBrush="{StaticResource BorderBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding OriginalSizeFormatted}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 1. Target Max File Size Group -->
                        <GroupBox Header="1. Target File Size">
                            <StackPanel Margin="0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="Compress to: " VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding TargetSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding SizeUnits}" SelectedItem="{Binding TargetSizeUnit}"/>
                                </Grid>

                                <!-- Preset Quick Size Chips -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Presets:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                    <Button Content="50 KB" Style="{StaticResource ChipButton}" Command="{Binding SetPresetSizeCommand}" CommandParameter="50"/>
                                    <Button Content="100 KB" Style="{StaticResource ChipButton}" Command="{Binding SetPresetSizeCommand}" CommandParameter="100"/>
                                    <Button Content="200 KB" Style="{StaticResource ChipButton}" Command="{Binding SetPresetSizeCommand}" CommandParameter="200"/>
                                    <Button Content="500 KB" Style="{StaticResource ChipButton}" Command="{Binding SetPresetSizeCommand}" CommandParameter="500"/>
                                    <Button Content="1 MB" Style="{StaticResource ChipButton}" Command="{Binding SetPresetSizeCommand}" CommandParameter="1024"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- 2. Output Destination & Format -->
                        <GroupBox Header="2. Save Location &amp; Format" Margin="0,12,0,0">
                            <StackPanel Margin="0,6">
                                <RadioButton Content="📁 Save in '_Compressed' subfolder (Originals stay untouched &amp; safe)" 
                                             IsChecked="{Binding OutputMode, Converter={StaticResource StringEquals}, ConverterParameter=subfolder}" 
                                             FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"
                                             ToolTip="Creates a '_Compressed' folder right beside the original files so your originals remain safe!"/>
                                <RadioButton Content="⚠️ Replace original files in-place" 
                                             IsChecked="{Binding OutputMode, Converter={StaticResource StringEquals}, ConverterParameter=replace}" 
                                             Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Save Format: " Width="100" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding OutputFormats}" SelectedItem="{Binding SelectedOutputFormat}" Width="150"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- ═══════════════════════════════════════════════════ -->
                        <!-- PDF MERGE PANEL — only visible when all files are PDF -->
                        <!-- ═══════════════════════════════════════════════════ -->
                        <Border Visibility="{Binding IsPdfOnlyBatch, Converter={StaticResource BoolToVis}}"
                                Background="#1A1D2E" CornerRadius="8" Padding="14,10"
                                BorderBrush="#6C63FF" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="🔗" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Merge All PDFs into One File" FontWeight="Bold" FontSize="13"
                                                   Foreground="#A09CF7"/>
                                        <TextBlock Text="Combine all selected PDFs into a single document"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Output file name -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Output name: " VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                               Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding MergedOutputName, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" Padding="8,5"
                                             Background="#0D0F1A" BorderBrush="#6C63FF" BorderThickness="1"/>
                                </Grid>

                                <!-- Merge button & result -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="🔗 Merge PDFs Now"
                                            Command="{Binding MergePdfsCommand}"
                                            IsEnabled="{Binding CanMerge}"
                                            Background="#6C63FF" Foreground="White"
                                            FontWeight="Bold" Padding="16,7" BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#6C63FF"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#8075FF"/>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Background" Value="#3D3A6B"/>
                                                                    <Setter Property="Foreground" Value="#888"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <!-- Merge progress indicator -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding IsMerging, Converter={StaticResource BoolToVis}}">
                                    <ProgressBar IsIndeterminate="True" Width="130" Height="4"
                                                 Foreground="#6C63FF" Background="#2A2540"
                                                 BorderThickness="0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Merging PDFs..." Foreground="#A09CF7"
                                               FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Merge result -->
                                <TextBlock Text="{Binding MergeResultText}"
                                           Visibility="{Binding HasMergeResult, Converter={StaticResource BoolToVis}}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>


                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Value="{Binding ProgressPercent}" Height="6" Margin="0,0,0,6" 
                                         Foreground="{StaticResource AccentBrush}" 
                                         Background="{StaticResource SurfaceBrush}" BorderThickness="0"/>
                            <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" 
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        </StackPanel>

                        <!-- Results Summary -->
                        <TextBlock Text="{Binding ResultSummaryText}" HorizontalAlignment="Center" Margin="0,12,0,0" 
                                   FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}"
                                   Visibility="{Binding HasResultSummary, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Soft Background Owner Portrait Watermark -->
            <Grid Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.06" IsHitTestVisible="False" Margin="0,0,15,15">
                <Image Source="pack://application:,,,/Resources/owner_portrait.png" Width="200" Height="200" Stretch="UniformToFill">
                    <Image.Clip>
                        <EllipseGeometry Center="100,100" RadiusX="95" RadiusY="95"/>
                    </Image.Clip>
                </Image>
            </Grid>

            <!-- Bottom Action Toolbar -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="0,0,10,10" 
                    BorderBrush="#444455" BorderThickness="0,1,0,0">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Close" Command="{Binding CancelCommand}" Width="80" Margin="0,0,10,0"/>
                        <Button Command="{Binding OpenFileLocationCommand}" Width="120"
                                ToolTip="Open containing folder in File Explorer">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📂 " FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="Open Folder" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Content="⚡ Compress All Files" Command="{Binding CompressAllCommand}" 
                            Style="{StaticResource PrimaryButton}" Width="160" HorizontalAlignment="Right"
                            IsEnabled="{Binding CanCompress}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
