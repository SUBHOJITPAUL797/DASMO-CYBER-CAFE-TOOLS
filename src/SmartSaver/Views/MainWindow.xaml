                                        <Border Width="46" Height="46" CornerRadius="12" Background="#2B1F0E" BorderBrush="#D97706" BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="✨" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Document Scanner Enhancer" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                                <Border Background="#D97706" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="MAGIC WHITE" FontSize="8.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Magic White shadow cleanup, Xerox high-contrast B&amp;W, and Grayscale filters." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Card: Today's Output History -->
                                <Button Style="{StaticResource HubCardButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="46" Height="46" CornerRadius="12" Background="#18202C" BorderBrush="#64748B" BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="🕒" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Today's Output History" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="Quickly access, open in folder, or copy path of all today's processed documents." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                    <!-- TAB 1: MERGE PDFS EMBEDDED VIEW -->
                    <Grid Visibility="{Binding DataContext.IsMergeTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" DataContext="{Binding MergePdfVm}" Style="{StaticResource ContentFadeStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header & Actions -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="📑 Merge Multiple PDF Files" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Binding TotalFilesInfo}" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="➕ Add PDF Files" Style="{StaticResource SecondaryButton}" Command="{Binding AddFilesCommand}" Margin="0,0,8,0"/>
                                <Button Content="🗑️ Remove" Style="{StaticResource SecondaryButton}" Command="{Binding RemoveFileCommand}" Margin="0,0,8,0"/>
                                <Button Content="▲ Move Up" Style="{StaticResource SecondaryButton}" Command="{Binding MoveUpCommand}" Margin="0,0,6,0"/>
                                <Button Content="▼ Move Down" Style="{StaticResource SecondaryButton}" Command="{Binding MoveDownCommand}"/>
                            </StackPanel>
                        </Grid>

                        <!-- File List -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6">
                            <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#25273C" CornerRadius="4" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding OrderNumber}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding PageCount, StringFormat='{}{0} pages'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="16,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding FileSizeFormatted}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Options -->
                        <Grid Grid.Row="2" Margin="0,12,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="Compress merged output to target size:" IsChecked="{Binding IsCompressEnabled}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Text="{Binding TargetSize}" Width="60" IsEnabled="{Binding IsCompressEnabled}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox SelectedValue="{Binding TargetSizeUnit}" SelectedValuePath="Content" Width="70" IsEnabled="{Binding IsCompressEnabled}" VerticalAlignment="Center">
                                    <ComboBoxItem Content="KB"/>
                                    <ComboBoxItem Content="MB"/>
                                </ComboBox>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Content="Open file upon completion" IsChecked="{Binding OpenOnComplete}" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Action Bar -->
                        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="🚀 Merge PDFs Now" Style="{StaticResource AccentButton}" Command="{Binding MergeCommand}" Padding="24,10" FontWeight="Bold"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- TAB 2: VISUAL PDF PAGE ORGANIZER & SPLITTER EMBEDDED VIEW -->
                    <Grid Visibility="{Binding DataContext.IsSplitTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" DataContext="{Binding SplitPdfVm}" Style="{StaticResource ContentFadeStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Top Bar: Document Info & Batch Actions -->
                            <RowDefinition Height="Auto"/> <!-- Dedicated Drag to Delete Zone -->
                            <RowDefinition Height="*"/>    <!-- Visual Page Grid -->
                            <RowDefinition Height="Auto"/> <!-- Settings & Compression Bar -->
                            <RowDefinition Height="Auto"/> <!-- Bottom Action & Status Bar -->
                        </Grid.RowDefinitions>

                        <!-- Top Header: File Info & Batch Actions -->
                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✂️ PDF Page Organizer &amp; Splitter" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                        <Border Background="#2A2D45" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasPages, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding PagesSummaryText}" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding MultiPdfNames, StringFormat='Files: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="520" Visibility="{Binding HasMultiplePdfs, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding FileName, StringFormat='File: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="520" Visibility="{Binding HasMultiplePdfs, Converter={StaticResource BoolToVis}, ConverterParameter=inverse}"/>
                                </StackPanel>

                                <!-- Header Action Buttons -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="📂 Open PDF" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.SelectToolFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="split" ToolTip="Select or open another PDF file" Margin="0,0,6,0" Padding="12,6"/>
                                    <Button Content="➕ Add PDF File" Style="{StaticResource AccentButton}" Command="{Binding AddPdfCommand}" ToolTip="Insert pages from another PDF into this organizer" Margin="0,0,10,0" Padding="14,6"/>
                                    <Button Content="☑️ Select All" Style="{StaticResource ChipButton}" Command="{Binding SelectAllCommand}" ToolTip="Select all pages for export" Margin="0,0,4,0"/>
                                    <Button Content="⬜ Clear All" Style="{StaticResource ChipButton}" Command="{Binding DeselectAllCommand}" ToolTip="Deselect all pages" Margin="0,0,4,0"/>
                                    <Button Content="🔄 Reset Order" Style="{StaticResource ChipButton}" Command="{Binding ResetPagesCommand}" ToolTip="Restore pages to original sequence" Margin="0,0,4,0"/>
                                    <Button Content="↻ Rotate 90°" Style="{StaticResource ChipButton}" Command="{Binding RotateAllSelectedCommand}" ToolTip="Rotate all selected pages 90° clockwise" Margin="0,0,4,0"/>
                                    <Button Content="🗑️ Delete Selected" Style="{StaticResource ChipButton}" Command="{Binding DeleteSelectedCommand}" ToolTip="Remove selected pages" Foreground="#FF6B81"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Dedicated Drag to Delete Zone Banner -->
                        <Border x:Name="SplitDeleteZone" Grid.Row="1" Background="#261822" BorderBrush="#772033" BorderThickness="1.5" CornerRadius="8" Padding="12,8" Margin="0,0,0,10" AllowDrop="True" DragOver="SplitDeleteZone_DragOver" DragLeave="SplitDeleteZone_DragLeave" Drop="SplitDeleteZone_Drop" Cursor="Hand" Visibility="{Binding HasPages, Converter={StaticResource BoolToVis}}">
                            <Grid HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🗑️" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="DRAG PAGE HERE TO DELETE / REMOVE" FontWeight="Bold" FontSize="11.5" Foreground="#FF6B81" VerticalAlignment="Center"/>
                                    <TextBlock Text="  —  Hold &amp; drop any page card onto this bar to delete it immediately" FontSize="11" Foreground="#AA8899" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Visual Grid of Pages (with Empty State & Drag/Drop Reordering) -->
                        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" AllowDrop="True" DragOver="SplitPageContainer_DragOver" Drop="SplitPageContainer_Drop">
                            <Grid>
                                <!-- Empty State when no pages loaded -->
                                <Border Visibility="{Binding HasPages, Converter={StaticResource BoolToVis}, ConverterParameter=inverse}" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" Opacity="0.6"/>
                                        <TextBlock Text="No PDF Pages Loaded" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                        <TextBlock Text="Click '📂 Open PDF' or '➕ Add PDF File' (or drag and drop PDF files here) to visually arrange, rotate, and extract pages." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="440" Margin="0,0,0,16"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="📂 Browse &amp; Open PDF" Style="{StaticResource AccentButton}" Command="{Binding DataContext.SelectToolFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="split" Padding="20,8" Margin="0,0,10,0"/>
                                            <Button Content="➕ Add Multiple PDFs" Style="{StaticResource SecondaryButton}" Command="{Binding AddPdfCommand}" Padding="20,8"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Pages Grid -->
                                <ScrollViewer Visibility="{Binding HasPages, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4">
                                    <ItemsControl ItemsSource="{Binding Pages}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Individual Page Card -->
                                                <Border Width="160" Margin="6" CornerRadius="8" BorderThickness="2" Cursor="Hand"
                                                        AllowDrop="True"
                                                        PreviewMouseLeftButtonDown="SplitPageCard_PreviewMouseLeftButtonDown"
                                                        MouseMove="SplitPageCard_MouseMove"
                                                        DragOver="SplitPageCard_DragOver"
                                                        DragLeave="SplitPageCard_DragLeave"
                                                        Drop="SplitPageCard_Drop">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#25273C"/>
                                                            <Setter Property="BorderBrush" Value="#383A59"/>
                                                            <Style.Triggers>
                                                                <!-- Highlight when dragging another page over this card -->
                                                                <DataTrigger Binding="{Binding IsDraggingOver}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                                    <Setter Property="Background" Value="#2D3252"/>
                                                                </DataTrigger>
                                                                <!-- Dim when page is unselected / excluded -->
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.45"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Grid Margin="6">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/> <!-- Card Top Header: Checkbox + Badge + Rotate badge -->
                                                            <RowDefinition Height="140"/>  <!-- Thumbnail Image -->
                                                            <RowDefinition Height="Auto"/> <!-- Source Info / Subtitle -->
                                                            <RowDefinition Height="Auto"/> <!-- Bottom Buttons: ◀, ▶, ↺, ↻, 🗑️ -->
                                                        </Grid.RowDefinitions>

                                                        <!-- Top Header -->
                                                        <Grid Grid.Row="0" Margin="0,0,0,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Selection Checkbox -->
                                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" ToolTip="Include or exclude this page from export"/>

                                                            <!-- Page Badge -->
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="5,1">
                                                                    <TextBlock Text="{Binding PageTitle}" FontWeight="Bold" FontSize="10.5" Foreground="#0F172A"/>
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- Rotation angle tag if rotated -->
                                                            <Border Grid.Column="2" Background="#3A3D58" CornerRadius="4" Padding="4,1" Visibility="{Binding HasRotation, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding RotationLabel}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Thumbnail Box with Click-to-Preview -->
                                                        <Border Grid.Row="1" Background="#181926" CornerRadius="6" BorderBrush="#303248" BorderThickness="1" ClipToBounds="True">
                                                            <Button Command="{Binding PreviewCommand}" ToolTip="Click to preview &amp; inspect full page content"
                                                                    Background="Transparent" BorderThickness="0" Padding="0" Margin="0" Cursor="Hand"
                                                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Grid Background="Transparent">
                                                                            <TextBlock Text="Loading..." FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                <Image.LayoutTransform>
                                                                                    <RotateTransform Angle="{Binding Rotation}"/>
                                                                                </Image.LayoutTransform>
                                                                            </Image>

                                                                            <!-- Hover Preview Badge -->
                                                                            <Border x:Name="PreviewBadge" Background="#E6161726" CornerRadius="12" Padding="8,3"
                                                                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                                                                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Opacity="0">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="🔍" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                                    <TextBlock Text="Click to Preview" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="PreviewBadge" Property="Opacity" Value="1"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </Border>

                                                        <!-- Source Info Subtitle -->
                                                        <TextBlock Grid.Row="2" Text="{Binding SourceInfo}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,4" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="146" ToolTip="{Binding SourceInfo}"/>

                                                        <!-- Action Buttons Bar -->
                                                        <Border Grid.Row="3" Background="#1E2032" CornerRadius="5" Padding="2">
                                                            <UniformGrid Columns="6">
                                                                <Button Content="◀" ToolTip="Move Page Left" Command="{Binding MoveLeftCommand}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" FontSize="11" Height="24" Padding="0"/>
                                                                <Button Content="▶" ToolTip="Move Page Right" Command="{Binding MoveRightCommand}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" FontSize="11" Height="24" Padding="0"/>
                                                                <Button Content="↺" ToolTip="Rotate 90° CCW" Command="{Binding RotateCcwCommand}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}" FontSize="11" Height="24" Padding="0"/>
                                                                <Button Content="↻" ToolTip="Rotate 90° CW" Command="{Binding RotateCwCommand}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}" FontSize="11" Height="24" Padding="0"/>
                                                                <Button Content="🔍" ToolTip="Preview &amp; Inspect Page Content" Command="{Binding PreviewCommand}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}" FontSize="11.5" Height="24" Padding="0"/>
                                                                <Button Content="🗑️" ToolTip="Delete Page" Command="{Binding DeleteCommand}" Background="Transparent" BorderThickness="0" Foreground="#FF6B81" FontSize="11" Height="24" Padding="0"/>
                                                            </UniformGrid>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Settings & Compression Bar -->
                        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Compression & Portal Preset -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Content="Compress output to target size:" IsChecked="{Binding IsCompressEnabled}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding TargetSizeKB, UpdateSourceTrigger=PropertyChanged}" Width="75" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="4,0" IsEnabled="{Binding IsCompressEnabled}" Margin="0,0,6,0"/>
                                    <ComboBox SelectedValue="{Binding TargetSizeUnit, Mode=TwoWay}" SelectedValuePath="Content" Width="68" Height="32" IsEnabled="{Binding IsCompressEnabled}" Margin="0,0,16,0">
                                        <ComboBoxItem Content="KB"/>
                                        <ComboBoxItem Content="MB"/>
                                    </ComboBox>
                                    <TextBlock Text="Govt Preset:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,0,6,0"/>
                                    <ComboBox ItemsSource="{Binding PortalPresets}" SelectedItem="{Binding SelectedPortalPreset}" DisplayMemberPath="Name" Height="32" Width="220" ToolTip="Quick target size presets for Govt/Exam portal uploads"/>
                                </StackPanel>

                                <!-- Right: Destination Folder -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Save to:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,0,6,0"/>
                                    <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" Width="240" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,6,0" ToolTip="{Binding OutputDirectory}"/>
                                    <Button Content="📁 Browse" Style="{StaticResource ChipButton}" Command="{Binding BrowseDirectoryCommand}" Height="32" Padding="10,0" VerticalAlignment="Center"/>
                                    <CheckBox Content="Auto-Open" IsChecked="{Binding OpenOnComplete}" VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="Open the output PDF automatically when export finishes"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Action Bar & Export Button -->
                        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding ResultText}" FontSize="12" Foreground="#4CAF50" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Content="{Binding OpenResultButtonText}" Style="{StaticResource ChipButton}" Command="{Binding OpenResultCommand}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ResultText}" FontSize="12" Foreground="#FF6B81" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <!-- Export Mode Switcher -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Mode:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,0,8,0"/>
                                    <RadioButton Content="📑 Combined PDF" IsChecked="{Binding IsRangeMode}" GroupName="SplitExportModeMain" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12" FontWeight="SemiBold"/>
                                    <RadioButton Content="📄 Separate Files" IsChecked="{Binding IsRangeMode, Converter={StaticResource InverseBool}}" GroupName="SplitExportModeMain" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>

                                <Button Grid.Column="2" Style="{StaticResource AccentButton}" Command="{Binding ExecuteCommand}" Padding="24,10" FontWeight="Bold" FontSize="14" IsEnabled="{Binding HasPages}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ExportButtonText}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding SelectedPagesCount, StringFormat='({0} pages)'}" Opacity="0.85"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- TAB 3: IMAGES TO PDF EMBEDDED VIEW -->
                    <Grid Visibility="{Binding DataContext.IsImg2PdfTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" DataContext="{Binding Img2PdfVm}" Style="{StaticResource ContentFadeStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="🖼️ Convert Images to Multi-Page PDF" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Binding Files.Count, StringFormat='{}{0} image(s) loaded'}" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="➕ Add Images" Style="{StaticResource SecondaryButton}" Command="{Binding AddFilesCommand}" Margin="0,0,8,0"/>
                                <Button Content="🗑️ Remove" Style="{StaticResource SecondaryButton}" Command="{Binding RemoveFileCommand}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Image List -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6">
                            <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FileSizeFormatted}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Actions -->
                        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Content="Fit Images to Standard A4 Page" IsChecked="{Binding FitToA4}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="🖼️ Convert Images to PDF" Style="{StaticResource AccentButton}" Command="{Binding ConvertCommand}" Padding="24,10" FontWeight="Bold"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- TAB 4: PDF TO JPG IMAGES EMBEDDED VIEW -->
                    <Grid Visibility="{Binding DataContext.IsPdf2ImgTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" DataContext="{Binding Pdf2ImgVm}" Style="{StaticResource ContentFadeStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- File Picker Banner -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Selected PDF File:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding TotalPages, StringFormat='Total Pages: {0}'}" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="📂 Browse PDF File" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.SelectToolFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="pdf2img" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Settings -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Output Image Format:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" Height="34" Width="180" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Resolution (DPI Quality):" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding DpiOptions}" SelectedItem="{Binding SelectedDpi}" Height="34" Width="180" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Output Destination -->
                                <TextBlock Text="Export Location (Optional):" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="📁 Browse Folder..." Style="{StaticResource SecondaryButton}" Command="{Binding BrowseDirectoryCommand}" Padding="14,0" Height="34" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Content="↺ Reset" Style="{StaticResource SecondaryButton}" Command="{Binding ResetDirectoryCommand}" ToolTip="Reset to PDF source folder" Padding="12,0" Height="34"/>
                                </Grid>

                                <CheckBox Content="{Binding SubfolderNamePreview, StringFormat='📁 Create dedicated subfolder for images ({0})'}" 
                                          IsChecked="{Binding CreateSubfolder}" Margin="0,0,0,12" FontWeight="SemiBold"
                                          ToolTip="Prevents cluttering by saving all pages inside a clean subfolder"/>

                                <CheckBox Content="Open folder and select / highlight output file in Explorer" IsChecked="{Binding OpenFolderOnComplete}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                                <CheckBox Content="Automatically copy output file path to Clipboard (For instant portal upload)" IsChecked="{Binding AutoCopyPathToClipboard}" Foreground="{StaticResource AccentBrush}"/>

                                <!-- Result notification and actions -->
                                <Border Background="#1E2333" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,14,0,0"
                                        Visibility="{Binding ResultText, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding ResultText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVis}}">
                                            <Button Content="📋 Copy Path" Style="{StaticResource SecondaryButton}" Command="{Binding CopyPathCommand}" Padding="12,6" Margin="0,0,8,0"/>
                                            <Button Content="📂 Select in Explorer" Style="{StaticResource PrimaryButton}" Command="{Binding SelectInExplorerCommand}" Padding="12,6"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Action Bar -->
                        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="📄 Convert PDF to Images" Style="{StaticResource AccentButton}" Command="{Binding ConvertCommand}" Padding="24,10" FontWeight="Bold"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- TAB 5: SCANNER ENHANCER EMBEDDED VIEW WITH REAL-TIME LIVE PREVIEW -->
                    <Grid Visibility="{Binding DataContext.IsEnhanceTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" DataContext="{Binding EnhancerVm}" Style="{StaticResource ContentFadeStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- File Picker Banner -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Selected Image / Phone Scan:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding FileSizeFormatted}" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="📂 Browse Image..." Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.SelectToolFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="enhance" VerticalAlignment="Center" Padding="16,8"/>
                            </Grid>
                        </Border>

                        <!-- 2-Column Split: Controls on Left, Live Preview on Right -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="380"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Column: Settings & Actions -->
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,10,0">
                                <StackPanel>
                                    <!-- Filter Selection -->
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="1. Enhancement Filter Mode:" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                                            
                                            <RadioButton IsChecked="{Binding SelectedFilter, Converter={StaticResource StringEquals}, ConverterParameter={x:Static services:ScanFilterType.MagicWhite}}" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="✨ Magic White (Whiten Paper &amp; Color Ink)" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                    <TextBlock Text="Whitens dark camera shadows while keeping blue/red signatures sharp." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </RadioButton>

                                            <RadioButton IsChecked="{Binding SelectedFilter, Converter={StaticResource StringEquals}, ConverterParameter={x:Static services:ScanFilterType.XeroxBlackAndWhite}}" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="🖨️ Xerox B&amp;W (Photocopy Crisp Text)" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                    <TextBlock Text="Pure high-contrast black &amp; white binarization." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </RadioButton>

                                            <RadioButton IsChecked="{Binding SelectedFilter, Converter={StaticResource StringEquals}, ConverterParameter={x:Static services:ScanFilterType.GrayscaleClean}}">
                                                <StackPanel>
                                                    <TextBlock Text="📑 Clean Grayscale Document" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                    <TextBlock Text="Smooth grayscale tone with boosted text contrast." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </StackPanel>
                                    </Border>

                                    <!-- Intensity & Whitening Slider -->
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="2. Whitening &amp; Contrast Intensity:" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Text="{Binding IntensityText}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="13"/>
                                            </Grid>
                                            
                                            <Slider Minimum="10" Maximum="100" Value="{Binding Intensity, UpdateSourceTrigger=PropertyChanged}" 
                                                    SmallChange="5" LargeChange="10" TickFrequency="10" IsSnapToTickEnabled="False"
                                                    Margin="0,4,0,4"/>
                                            
                                            <Grid Margin="0,2,0,0">
                                                <TextBlock Text="Soft (Gentle)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="Default (80%)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Ultra White (100%)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Optional Compression & Portal Preset -->
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <CheckBox Content="Compress enhanced output to target size" IsChecked="{Binding IsCompressEnabled}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            
                                            <StackPanel Visibility="{Binding IsCompressEnabled, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Govt / Exam Portal Preset:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding PortalPresets}" SelectedItem="{Binding SelectedPortalPreset}" DisplayMemberPath="Name" Margin="0,0,0,8"/>

                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="65"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Label Content="Target Size:" VerticalAlignment="Center" Padding="0,0,8,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding TargetSizeKB, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                                                    <ComboBox Grid.Column="2" SelectedValue="{Binding TargetSizeUnit, Mode=TwoWay}" SelectedValuePath="Content">
                                                        <ComboBoxItem Content="KB"/>
                                                        <ComboBoxItem Content="MB"/>
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Action Button & Results -->
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="✨ Enhance &amp; Save" Style="{StaticResource AccentButton}" Command="{Binding EnhanceCommand}" Padding="0,10" FontWeight="Bold" FontSize="13" Margin="0,0,6,0"/>
                                                <Button Grid.Column="1" Content="🖨️ Print Now" Style="{StaticResource PrimaryButton}" Command="{Binding PrintCommand}" Padding="14,10" FontWeight="Bold" FontSize="13"/>
                                            </Grid>
                                            
                                            <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0" 
                                                       Visibility="{Binding ProgressText, Converter={StaticResource BoolToVis}}" TextAlignment="Center"/>

                                            <Border Background="#1E2333" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0"
                                                    Visibility="{Binding ResultText, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ResultText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                                    <Button Content="📂 Open Enhanced File" Style="{StaticResource PrimaryButton}" Command="{Binding OpenResultCommand}" 
                                                            Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0" Padding="0,6"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Right Column: Live Interactive Viewport -->
                            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Preview Header & Compare Toggle -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="👁️ Live Document Preview (Real-Time)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="Adjust the intensity slider on the left to see live background whitening!" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="{Binding PreviewModeLabel}" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleCompareCommand}" Padding="12,6" VerticalAlignment="Center" ToolTip="Click to switch between Original (Before) and Enhanced (After)"/>
                                    </Grid>

                                    <!-- Image Viewport Canvas -->
                                    <Border Grid.Row="1" Background="#161616" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                        <Grid>
                                            <!-- Empty Placeholder -->
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                        Visibility="{Binding HasFile, Converter={StaticResource InverseBool}, ConverterParameter=invert}">
                                                <TextBlock Text="📄" FontSize="42" HorizontalAlignment="Center" Opacity="0.5"/>
                                                <TextBlock Text="No Image Loaded" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                <TextBlock Text="Click 'Browse Image' above to load a phone scan and view real-time whitening!" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <!-- Live Enhanced Image Preview -->
                                            <Image Source="{Binding PreviewImageSource}" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- TAB 6: PHOTO NAME & DATE STAMP EMBEDDED VIEW -->
                    <Grid Visibility="{Binding DataContext.IsStampTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" DataContext="{Binding PhotoStampVm}" Style="{StaticResource ContentFadeStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- File Picker Banner -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Selected Candidate Photo:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding FileSizeFormatted}" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="📂 Browse Photo" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.SelectToolFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="stamp" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Stamp Settings -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Candidate Full Name (in CAPITAL letters):" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding CandidateName, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="10,8" Margin="0,0,0,14"/>

                                <TextBlock Text="Date of Photograph (D.O.P):" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding DateOfPhoto, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="10,8" Margin="0,0,0,14"/>

                                <CheckBox Content="Compress stamped photo to SSC/Govt Portal specification (20KB - 50KB)" IsChecked="{Binding IsCompressEnabled}" Margin="0,0,0,14"/>

                                <TextBlock Text="Govt / SSC Portal Preset:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding PortalPresets}" SelectedItem="{Binding SelectedPortalPreset}" DisplayMemberPath="Name" Height="34"/>
                            </StackPanel>
                        </Border>

                        <!-- Action Bar with Direct Print and Passport Studio Grid -->
                        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="🖨️ 1 Photo" Style="{StaticResource SecondaryButton}" Command="{Binding PrintPhotoCommand}" Padding="12,10" Margin="0,0,6,0" ToolTip="Print 1 single 3.5cm x 4.5cm passport photo"/>
                                <Button Grid.Column="2" Content="📸 4×6 Sheet (8 Copies)" Style="{StaticResource SecondaryButton}" Command="{Binding PrintSheetCommand}" CommandParameter="8" Padding="12,10" Margin="0,0,6,0" ToolTip="Generate and print 8 passport photos on 4x6 photo paper"/>
                                <Button Grid.Column="3" Content="📄 A4 Sheet (30 Copies)" Style="{StaticResource SecondaryButton}" Command="{Binding PrintSheetCommand}" CommandParameter="30" Padding="12,10" Margin="0,0,8,0" ToolTip="Generate and print 30 passport photos on A4 sheet paper"/>
                                <Button Grid.Column="4" Content="🏷️ Generate &amp; Save Stamp" Style="{StaticResource AccentButton}" Command="{Binding StampCommand}" Padding="18,10" FontWeight="Bold"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- TAB 7: TODAY'S OUTPUT HISTORY EMBEDDED VIEW -->
                    <Grid Visibility="{Binding DataContext.IsHistoryTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" DataContext="{Binding HistoryVm}" Style="{StaticResource ContentFadeStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header & Search Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="🕒 Today's Output Files &amp; Activity History" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Binding TotalSavedSummary}" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            
                            <!-- Live Search Input -->
                            <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="10,0" Tag="🔍 Search history..."/>
                        </Grid>

                        <!-- Filter Chips & Actions Bar -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Label Content="Time Period:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding FilterTime}" VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="2" Text="{Binding TotalProcessedText}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>

                                <Button Grid.Column="3" Content="🔄 Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" Padding="10,4"/>
                                <Button Grid.Column="4" Content="🗑️ Clear All History" Style="{StaticResource SecondaryButton}" Command="{Binding ClearHistoryCommand}" Padding="10,4"/>
                            </Grid>
                        </Border>

                        <!-- Activity Records List -->
                        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6">
                            <ListBox ItemsSource="{Binding FilteredRecords}" SelectedItem="{Binding SelectedRecord}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="2,2" Background="#1C1C1C" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Operation Badge -->
                                                <Border Background="#252F3E" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Operation}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                </Border>

                                                <!-- File Details -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding FilePath}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Size -->
                                                <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>

                                                <!-- Time & Date -->
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding TimeFormatted}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding DateFormatted}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Right"/>
                                                </StackPanel>

                                                <!-- Actions -->
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="{Binding ResumeButtonText}" 
                                                            Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}"
                                                            Style="{StaticResource PrimaryButton}" 
                                                            Background="#2E7D32" BorderBrush="#388E3C"
                                                            Command="{Binding DataContext.ResumeInEditorCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                            CommandParameter="{Binding}" Padding="8,4" Margin="0,0,6,0"
                                                            ToolTip="Resume or continue work (restores all filters, ranges, or edits)"/>
                                                    <Button Content="📂 Open" Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Padding="8,4" Margin="0,0,6,0"/>
                                                    <Button Content="📁 Folder" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Padding="8,4" Margin="0,0,6,0"/>
                                                    <Button Content="📋 Copy" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Padding="8,4"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>

                    <!-- TAB 8: SETTINGS & FOLDERS EMBEDDED VIEW -->
                    <Grid Visibility="{Binding DataContext.IsSettingsTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" DataContext="{Binding SettingsVm}" Style="{StaticResource ContentFadeStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TabControl Grid.Row="0" Margin="0,0,0,10">
                            <!-- Tab 1: Auto-Compress -->
                            <TabItem Header="⚙️ Auto-Compress">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <Grid Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Enable Auto-Compress Toggle Card -->
                                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <CheckBox Content="Enable Automatic Background Compression" 
                                                          IsChecked="{Binding AutoCompressEnabled}" 
                                                          FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                                                <TextBlock Text="When enabled, files placed in watched folders or system drives are automatically compressed in the background."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="24,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Action Mode Group -->
                                        <GroupBox Grid.Row="1" Header="Action on New Download / File Detection">
                                            <StackPanel Margin="0,6">
                                                <TextBlock Text="Choose what happens when a new document or image is downloaded or created on any drive (C:\, D:\, Downloads):"
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                                
                                                <RadioButton Content="⚡ Prompt Me Interactively On New Downloads (Ask for Target Size &amp; Format)" 
                                                             IsChecked="{Binding ActionOnNewFile, Converter={StaticResource StringEquals}, ConverterParameter=prompt}" 
                                                             FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"
                                                             ToolTip="Pops up an interactive dialog with preset target size chips (50KB, 100KB, 200KB, 500KB) whenever a new file is downloaded!"/>
                                                <RadioButton Content="🤖 Auto-Compress Automatically in Background (Silent)" 
                                                             IsChecked="{Binding ActionOnNewFile, Converter={StaticResource StringEquals}, ConverterParameter=silent}" 
                                                             Margin="0,0,0,8"
                                                             ToolTip="Automatically compresses files to the default target size in the background without prompting."/>
                                                <RadioButton Content="🛑 Turn Off Download Auto-Detection (Do Not Detect or Prompt)" 
                                                             IsChecked="{Binding ActionOnNewFile, Converter={StaticResource StringEquals}, ConverterParameter=off}" 
                                                             Margin="0,0,0,6"
                                                             Foreground="{StaticResource TextSecondaryBrush}"
                                                             ToolTip="Disables the automatic popup and background compression for newly downloaded files. You can still right-click files to compress manually."/>
                                            </StackPanel>
                                        </GroupBox>

                                        <!-- Target File Size Group -->
                                        <GroupBox Grid.Row="2" Header="Default Target Size">
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Label Content="Target Max File Size:" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding TargetSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                                                <ComboBox Grid.Column="2" SelectedValue="{Binding TargetSizeUnit}" SelectedValuePath="Content">
                                                    <ComboBoxItem Content="KB"/>
                                                    <ComboBoxItem Content="MB"/>
                                                </ComboBox>

                                                <CheckBox Grid.Column="3" Content="Keep Backup in '_Originals' folder" 
                                                          IsChecked="{Binding KeepOriginalBackup}" VerticalAlignment="Center" Margin="15,0,0,0"/>
                                            </Grid>
                                        </GroupBox>

                                        <!-- Supported File Types Group -->
                                        <GroupBox Grid.Row="3" Header="Supported File Extensions">
                                            <WrapPanel Margin="0,4">
                                                <CheckBox Content="PDF Documents (.pdf)" IsChecked="{Binding CompressPdf}" Margin="0,0,20,8"/>
                                                <CheckBox Content="JPEG Images (.jpg, .jpeg)" IsChecked="{Binding CompressJpeg}" Margin="0,0,20,8"/>
                                                <CheckBox Content="PNG Images (.png)" IsChecked="{Binding CompressPng}" Margin="0,0,20,8"/>
                                                <CheckBox Content="Word Documents (.docx)" IsChecked="{Binding CompressDocx}" Margin="0,0,20,8"/>
                                                <CheckBox Content="Excel Spreadsheets (.xlsx)" IsChecked="{Binding CompressXlsx}" Margin="0,0,20,8"/>
                                            </WrapPanel>
                                        </GroupBox>
                                    </Grid>
                                </ScrollViewer>
                            </TabItem>

                            <!-- Tab 2: Image Resize -->
                            <TabItem Header="🖼️ Image Resize">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <Grid Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Default Resize Mode Group -->
                                        <GroupBox Grid.Row="0" Header="Default Resize Mode">
                                            <StackPanel Margin="0,4">
                                                <RadioButton Content="Always ask when opening image" 
                                                             IsChecked="{Binding DefaultMode, Converter={StaticResource StringEquals}, ConverterParameter=ask}" 
                                                             Margin="0,0,0,6"/>
                                                <RadioButton Content="Default to File Size reduction" 
                                                             IsChecked="{Binding DefaultMode, Converter={StaticResource StringEquals}, ConverterParameter=fileSize}" 
                                                             Margin="0,0,0,6"/>
                                                <RadioButton Content="Default to Dimension (Width/Height) reduction" 
                                                             IsChecked="{Binding DefaultMode, Converter={StaticResource StringEquals}, ConverterParameter=dimensions}"/>
                                            </StackPanel>
                                        </GroupBox>

                                        <!-- Default Dimensions Group -->
                                        <GroupBox Grid.Row="1" Header="Default Target Dimensions">
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Label Content="Width (px):" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding DefaultWidth, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" VerticalContentAlignment="Center"/>

                                                <Label Grid.Column="2" Content="Height (px):" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="3" Text="{Binding DefaultHeight, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" VerticalContentAlignment="Center"/>

                                                <CheckBox Grid.Column="4" Content="Maintain Aspect Ratio" 
                                                          IsChecked="{Binding MaintainAspectRatio}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </Grid>
                                        </GroupBox>

                                        <!-- Output Settings Group -->
                                        <GroupBox Grid.Row="2" Header="Quality &amp; Output Settings">
                                            <StackPanel Margin="0,4">
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="40"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Label Content="Min Quality Floor:" VerticalAlignment="Center"/>
                                                    <Slider Grid.Column="1" Minimum="10" Maximum="60" Value="{Binding MinimumJpegQuality, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding MinimumJpegQuality}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                </Grid>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Label Content="Output Suffix: " VerticalAlignment="Center" Width="140"/>
                                                    <TextBox Text="{Binding OutputSuffix, UpdateSourceTrigger=PropertyChanged}" Width="120" VerticalContentAlignment="Center"/>
                                                    <TextBlock Text="(Used when creating a new file e.g., _resized)" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </GroupBox>
                                    </Grid>
                                </ScrollViewer>
                            </TabItem>

                            <!-- Tab 3: General Settings -->
                            <TabItem Header="🔧 General">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <Grid Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- System Behavior Group -->
                                        <GroupBox Grid.Row="0" Header="Startup &amp; System Tray">
                                            <StackPanel Margin="0,4">
                                                <CheckBox Content="Start DASMO CYBER CAFE TOOLS automatically with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,8"/>
                                                <CheckBox Content="Show icon in System Tray (bottom right near clock)" IsChecked="{Binding ShowTrayIcon}" Margin="0,0,0,8"/>
                                                <CheckBox Content="Show Toast Notifications on compression" IsChecked="{Binding EnableNotifications}" Margin="0,0,0,8"/>
                                                <CheckBox Content="Enable Explorer Live PDF Preview Pane (Renders PDF Page 1 inside File Explorer)" IsChecked="{Binding EnableExplorerPdfPreview}"/>
                                            </StackPanel>
                                        </GroupBox>

                                        <!-- Logging & Diagnostic Group -->
                                        <GroupBox Grid.Row="1" Header="Diagnostics &amp; Logs">
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Label Content="Log Level:" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}"/>
                                                <Button Grid.Column="2" Content="📁 Open Log Folder" Command="{Binding OpenLogFolderCommand}" HorizontalAlignment="Right" Width="140"/>
                                            </Grid>
                                        </GroupBox>

                                        <!-- About & Developer Profile Group -->
                                        <GroupBox Grid.Row="2" Header="About &amp; Developer Profile">
                                            <StackPanel Margin="0,4">
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="DASMO CYBER CAFE TOOLS v1.4.9" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                                                        <TextBlock Text="All-in-one cyber cafe management, PDF cropping &amp; printing, photo stamping, and document resizing suite."
                                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                     <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,0,0,0">
                                                         <Button Content="⚡ Fix Explorer PDF Preview" Command="{Binding FixPdfPreviewCommand}" Style="{StaticResource PrimaryButton}" Width="170" Margin="0,0,8,0" ToolTip="Fixes Explorer Preview Pane so PDF pages render live on the right side pane without security warnings!"/>
                                                         <Button Content="🔄 Reset Defaults" Command="{Binding ResetToDefaultsCommand}" VerticalAlignment="Center" Width="120"/>
                                                     </StackPanel>
                                                 </Grid>

                                                <!-- Owner Glassmorphic Badge -->
                                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="65"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                         
                                                        <!-- Circular Portrait -->
                                                        <Border Width="52" Height="52" CornerRadius="26" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Border.Background>
                                                                <ImageBrush Stretch="UniformToFill" ImageSource="pack://application:,,,/Resources/owner_portrait.png"/>
                                                            </Border.Background>
                                                        </Border>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                                            <TextBlock Text="DASMO CYBER CAFE OFFICIAL SUITE" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentBrush}"/>
                                                            <TextBlock Text="Professional Edition • Developed for High-Speed Cyber Cafe Operations" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                            <TextBlock Text="Supports Govt Portal Document Sizing &amp; Crisp 4:4:4 Text Preservation" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,2,0,0" Opacity="0.8"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </GroupBox>
                                    </Grid>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>

                        <!-- Soft Background Owner Portrait Watermark -->
                        <Grid Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.15" IsHitTestVisible="False" Margin="0,0,20,20">
                            <Image Width="260" Height="260" Stretch="UniformToFill" Source="pack://application:,,,/Resources/owner_portrait.png">
                                <Image.Clip>
                                    <EllipseGeometry Center="130,130" RadiusX="120" RadiusY="120"/>
                                </Image.Clip>
                            </Image>
                        </Grid>

                        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="15">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource OutlineButton}" Width="100" Margin="0,0,10,0"/>
                                <Button Content="💾 Save Settings" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Width="140"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- TAB 9: E-RATION / AADHAAR / PAN A4 MULTI-PRINT GENERATOR EMBEDDED VIEW -->
                    <Grid Visibility="{Binding DataContext.IsGovtCardTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" DataContext="{Binding GovtCardVm}" Style="{StaticResource ContentFadeStyle}" AllowDrop="True" Drop="GovtCardTab_Drop" DragOver="GovtCardTab_DragOver">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Top Header Banner -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="💳" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="e-Ration • Aadhaar • PAN • Voter ID A4 Multi-Card Print Sheet Generator" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="{Binding SheetSummaryText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="📂 Add PDFs / Images..." Style="{StaticResource PrimaryButton}" Command="{Binding AddFilesCommand}" Padding="14,7" Margin="0,0,8,0" ToolTip="Select 1 to 20+ e-Ration, Aadhaar, PAN, or Voter ID PDFs"/>
                                    <Button Content="🗑️ Clear All" Style="{StaticResource OutlineButton}" Command="{Binding ClearAllCommand}" Padding="12,7"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 2-Column Split: Options & Cards on Left, Live A4 Sheet Preview on Right -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="430"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Column: Settings, Card List & Export -->
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,10,0">
                                <StackPanel>
                                    <!-- 1. Document Preset & Fine-Tuning -->
                                    <GroupBox Header="1. Document Preset &amp; Smart AI Auto-Crop" Margin="0,0,0,8">
                                        <StackPanel Margin="0,4">
                                            <ComboBox SelectedValue="{Binding SelectedDocType}" SelectedValuePath="Tag" Height="32">
                                                <ComboBoxItem Content="🤖 Smart Auto-Detect per Document (Mix Ration, Aadhaar, PAN, Voter)" Tag="{x:Static services:GovtDocumentType.AutoDetect}"/>
                                                <ComboBoxItem Content="🍚 e-Ration Card (West Bengal / NFSA)" Tag="{x:Static services:GovtDocumentType.RationCardWB}"/>
                                                <ComboBoxItem Content="🆔 e-Aadhaar PDF (UIDAI Official)" Tag="{x:Static services:GovtDocumentType.AadhaarCard}"/>
                                                <ComboBoxItem Content="💳 e-PAN Card (NSDL / UTIITSL)" Tag="{x:Static services:GovtDocumentType.PanCard}"/>
                                                <ComboBoxItem Content="🗳️ e-EPIC Voter Card (ECI)" Tag="{x:Static services:GovtDocumentType.VoterCard}"/>
                                                <ComboBoxItem Content="🏥 Ayushman Bharat (PM-JAY)" Tag="{x:Static services:GovtDocumentType.AyushmanCard}"/>
                                                <ComboBoxItem Content="📄 Full Page / Pre-Cropped ID Image" Tag="{x:Static services:GovtDocumentType.FullPageCard}"/>
                                            </ComboBox>
                                            <TextBlock Text="{Binding DocTypeDescription}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,4,0,4" TextWrapping="Wrap"/>

                                            <!-- Optional Fine-Tuning Sliders -->
                                            <Expander Header="✂️ Fine-Tune Crop Margins (Optional)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0">
                                                <StackPanel Margin="4,6,4,2">
                                                    <TextBlock Text="ℹ️ Adjust top/bottom trim if your scanned document has unwanted website headers, page numbers, or scanner margins." FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>

                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Top Header Trim (from PDF):" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding TopTrimText}" FontSize="10" Foreground="{StaticResource AccentBrush}"/>
                                                    </Grid>
                                                    <Slider Minimum="0" Maximum="25" Value="{Binding TopTrimPercent}" SmallChange="1" LargeChange="5" Margin="0,0,0,4"/>

                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Bottom Margin Trim:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding BottomTrimPercent, StringFormat='{}{0:F1}%'}" FontSize="10" Foreground="{StaticResource AccentBrush}"/>
                                                    </Grid>
                                                    <Slider Minimum="0" Maximum="25" Value="{Binding BottomTrimPercent}" SmallChange="1" LargeChange="5" Margin="0,0,0,6"/>

                                                    <Button Content="🔄 Re-Detect &amp; Crop Cards" Style="{StaticResource OutlineButton}" Command="{Binding ReCropAllCommand}" Height="28" FontSize="11"/>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </GroupBox>

                                    <!-- 2. A4 Sheet Layout, Paper Saver Alignment & Scissor Spacing -->
                                    <GroupBox Header="2. A4 Sheet Layout &amp; Paper Saver Mode" Margin="0,0,0,8">
                                        <StackPanel Margin="0,4">
                                            <!-- Card Dimensions / Pouch Standard Preset -->
                                            <TextBlock Text="Card Size &amp; Pouch Preset:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedIndex="{Binding CardSizePresetIndex}" Height="30" Margin="0,0,0,6">
                                                <ComboBoxItem Content="💳 8.00 cm × 5.40 cm (Cyber Cafe Wallet / Pouch - Recommended)"/>
                                                <ComboBoxItem Content="📏 8.56 cm × 5.40 cm (Standard ID-1 / CR-80 ISO Strict)"/>
                                                <ComboBoxItem Content="📐 7.80 cm × 5.20 cm (Compact Pocket Card)"/>
                                                <ComboBoxItem Content="⚙️ Custom Card Dimensions (Fine-Tune with Sliders)"/>
                                            </ComboBox>

                                            <!-- Advanced Custom Card Width & Height Adjustment Sliders -->
                                            <Expander Header="⚙️ Custom Card Width &amp; Height (Advance Size)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,6">
                                                <Border Background="#141622" CornerRadius="6" Padding="8,6" Margin="0,4,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Card Width (cm):" FontSize="10" Foreground="{StaticResource TextBrush}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding CardWidthCm, StringFormat='{}{0:F2} cm'}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                                                        </Grid>
                                                        <Slider Minimum="6.0" Maximum="{Binding MaxCardWidthCm}" Value="{Binding CardWidthCm}" IsMoveToPointEnabled="True" SmallChange="0.05" LargeChange="0.2" Margin="0,0,0,6"/>

                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Card Height (cm):" FontSize="10" Foreground="{StaticResource TextBrush}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding CardHeightCm, StringFormat='{}{0:F2} cm'}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                                                        </Grid>
                                                        <Slider Minimum="4.0" Maximum="8.0" Value="{Binding CardHeightCm}" IsMoveToPointEnabled="True" SmallChange="0.05" LargeChange="0.2" Margin="0,0,0,6"/>

                                                        <!-- Quick Preset Shortcut Chips -->
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                                            <Button Content="8.00 × 5.40 cm" Style="{StaticResource ChipButton}" Height="22" Padding="6,1" FontSize="9.5" Margin="0,0,4,0"
                                                                    Command="{Binding SetPresetCommand}" CommandParameter="0" ToolTip="Wallet / Pouch Standard"/>
                                                            <Button Content="8.56 × 5.40 cm" Style="{StaticResource ChipButton}" Height="22" Padding="6,1" FontSize="9.5"
                                                                    Command="{Binding SetPresetCommand}" CommandParameter="1" ToolTip="Strict ISO CR-80"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Expander>

                                            <!-- Layout Choice -->
                                            <TextBlock Text="Card Arrangement:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedLayout}" SelectedValuePath="Tag" Height="30" Margin="0,0,0,6">
                                                 <ComboBoxItem Content="⚡ 5 Cards / 10 Sides per A4 (Max Paper Saver)" Tag="{x:Static services:CardSheetLayout.FiveCardsA4PaperSaver}"/>
                                                <ComboBoxItem Content="📄 2 Cards / 4 Sides per A4 Sheet" Tag="{x:Static services:CardSheetLayout.TwoCardsA4}"/>
                                                <ComboBoxItem Content="📑 1 Card Side-by-Side (Center Fold Laminate)" Tag="{x:Static services:CardSheetLayout.SingleCardSideBySide}"/>
                                                <ComboBoxItem Content="⬇️ 1 Card Top / Bottom (Standard Stack)" Tag="{x:Static services:CardSheetLayout.SingleCardTopBottom}"/>
                                            </ComboBox>

                                            <!-- Paper Saver Alignment (Top-to-Bottom vs Center) -->
                                            <TextBlock Text="Paper Saving Mode:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedAlignment}" SelectedValuePath="Tag" Height="30" Margin="0,0,0,6">
                                                <ComboBoxItem Content="⬆️ Top-to-Bottom (Paper Re-Use: Cut &amp; Save unused bottom)" Tag="{x:Static services:CardSheetAlignment.TopToBottomPaperSaver}"/>
                                                <ComboBoxItem Content="↕️ Centered on Page" Tag="{x:Static services:CardSheetAlignment.CenterOfPage}"/>
                                            </ComboBox>
                                            <TextBlock Text="{Binding AlignmentDescription}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" Margin="0,0,0,6" TextWrapping="Wrap"/>

                                            <!-- Top Header Gap (Page Top Margin) Slider -->
                                            <Grid Margin="0,4,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="🔝 Top Header Margin / Gap (Tight to Edge):" FontSize="11" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TopMarginText}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                                            </Grid>
                                            <Slider Minimum="0.0" Maximum="25.0" Value="{Binding TopMarginMm}" IsMoveToPointEnabled="True" SmallChange="0.5" LargeChange="2.0" Margin="0,0,0,4"/>

                                            <!-- Quick Preset Chips for Top Margin -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                                <Button Content="0.0 mm (Tight - No Gap)" Style="{StaticResource ChipButton}" Height="20" Padding="5,1" FontSize="9" Margin="0,0,3,0"
                                                        Command="{Binding SetTopMarginPresetCommand}" CommandParameter="0.0" ToolTip="Cards touch the very top edge of A4 sheet (Maximum paper saver, zero gap)"/>
                                                <Button Content="2.0 mm" Style="{StaticResource ChipButton}" Height="20" Padding="5,1" FontSize="9" Margin="0,0,3,0"
                                                        Command="{Binding SetTopMarginPresetCommand}" CommandParameter="2.0" ToolTip="2 mm safe margin"/>
                                                <Button Content="5.0 mm" Style="{StaticResource ChipButton}" Height="20" Padding="5,1" FontSize="9" Margin="0,0,3,0"
                                                        Command="{Binding SetTopMarginPresetCommand}" CommandParameter="5.0" ToolTip="5 mm standard margin"/>
                                                <Button Content="10.0 mm" Style="{StaticResource ChipButton}" Height="20" Padding="5,1" FontSize="9"
                                                        Command="{Binding SetTopMarginPresetCommand}" CommandParameter="10.0" ToolTip="10 mm wide margin"/>
                                            </StackPanel>

                                            <!-- Scissor Gap Slider -->
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="✂️ Scissor Cutting Gap between Cards:" FontSize="11" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ScissorGapMm, StringFormat='{}{0:F1} mm'}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                                            </Grid>
                                            <Slider Minimum="2" Maximum="15" Value="{Binding ScissorGapMm}" SmallChange="0.5" LargeChange="1" Margin="0,0,0,6"/>

                                            <CheckBox Content="Auto-Whiten Background (Save printer ink &amp; crisp text)" IsChecked="{Binding AutoWhiten}" Margin="0,0,0,3" FontWeight="SemiBold"/>
                                            <CheckBox Content="Select output file in Explorer when finished" IsChecked="{Binding OpenFolderOnComplete}" Margin="0,0,0,3"/>
                                            <CheckBox Content="Copy output file path to Clipboard" IsChecked="{Binding AutoCopyPathToClipboard}" Foreground="{StaticResource AccentBrush}"/>
                                        </StackPanel>
                                    </GroupBox>

                                    <!-- 3. Loaded Documents List with Order Controls & Thumbnails -->
                                    <GroupBox Header="3. Loaded Customer Documents" Margin="0,0,0,8">
                                        <StackPanel Margin="0,4">
                                            <ListBox ItemsSource="{Binding Cards}" Height="165" Background="#12131C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#1A1C2A" CornerRadius="6" Padding="6" Margin="0,2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="22"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Text="{Binding ItemIndex, StringFormat='{}{0}.'}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>

                                                                <!-- Card Thumbnails (Front & Back) -->
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0">
                                                                    <Border Width="44" Height="28" CornerRadius="3" Background="#222" BorderBrush="#444" BorderThickness="1" ClipToBounds="True" Margin="0,0,3,0">
                                                                        <Image Source="{Binding FrontImagePath}" Stretch="UniformToFill"/>
                                                                    </Border>
                                                                    <Border Width="44" Height="28" CornerRadius="3" Background="#222" BorderBrush="#444" BorderThickness="1" ClipToBounds="True" Visibility="{Binding HasBack, Converter={StaticResource BoolToVis}}">
                                                                        <Image Source="{Binding BackImagePath}" Stretch="UniformToFill"/>
                                                                    </Border>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0">
                                                                    <TextBlock Text="{Binding SourceFileName}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                                        <Border Background="#10B981" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                                                                            <TextBlock Text="{Binding DocTypeDisplayName}" FontSize="8.5" Foreground="White" FontWeight="Bold"/>
                                                                        </Border>
                                                                        <Border Background="#3B82F6" CornerRadius="3" Padding="4,1">
                                                                            <TextBlock Text="{Binding TargetPageNumber, StringFormat='{}Page {0}'}" FontSize="8.5" Foreground="White"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <!-- Re-Order Buttons -->
                                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                                                                    <Button Content="▲" Style="{StaticResource ChipButton}" 
                                                                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                                            CommandParameter="{Binding}" Width="20" Height="22" Padding="0" Margin="0,0,2,0" ToolTip="Move Up"/>
                                                                    <Button Content="▼" Style="{StaticResource ChipButton}" 
                                                                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                                            CommandParameter="{Binding}" Width="20" Height="22" Padding="0" ToolTip="Move Down"/>
                                                                </StackPanel>

                                                                <Button Grid.Column="4" Content="✕" Style="{StaticResource TitleBarCloseButton}" 
                                                                        Command="{Binding DataContext.RemoveCardCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                                        CommandParameter="{Binding}" Width="22" Height="22" ToolTip="Remove card" Margin="4,0,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </GroupBox>

                                    <!-- Status Message -->
                                    <Border Background="#161926" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                    </Border>

                                    <!-- Action Buttons -->
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- PDF & DOCX -->
                                            <Button Grid.Row="0" Grid.Column="0" Content="📄 Export PDF" Style="{StaticResource PrimaryButton}" Command="{Binding ExportPdfCommand}" Height="36" Margin="0,0,4,6" FontWeight="Bold"/>
                                            <Button Grid.Row="0" Grid.Column="1" Content="📝 Export Word (.docx)" Style="{StaticResource SecondaryButton}" Command="{Binding ExportDocxCommand}" Height="36" Margin="4,0,0,6" FontWeight="Bold" Background="#2B579A" Foreground="White"/>

                                            <!-- Image & Direct Print -->
                                            <Button Grid.Row="1" Grid.Column="0" Content="🖼️ Export Image" Style="{StaticResource ChipButton}" Command="{Binding ExportImageCommand}" Height="34" Margin="0,0,4,0"/>
                                            <Button Grid.Row="1" Grid.Column="1" Content="🖨️ Direct Print" Style="{StaticResource AccentButton}" Command="{Binding DirectPrintCommand}" Height="34" Margin="4,0,0,0" FontWeight="Bold"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Right Column: Live A4 Sheet Preview with Multi-Page Navigation -->
                            <Border Grid.Column="1" Background="#0E0F17" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Multi-Page Pagination Header -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="👁️ Live A4 Print Preview" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="{Binding CardDimensionsText, StringFormat='{} • {0} • Top-to-Bottom Paper Saver'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="6,0,0,0"/>
                                        </StackPanel>

                                        <!-- Page Switcher Buttons -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="◀ Prev Page" Style="{StaticResource ChipButton}" Command="{Binding PrevPageCommand}" Height="26" Padding="8,2" Margin="0,0,4,0"/>
                                            <Border Background="#1E2235" CornerRadius="4" Padding="8,4" Margin="0,0,4,0">
                                                <TextBlock Text="{Binding PageSummaryText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                            </Border>
                                            <Button Content="Next Page ▶" Style="{StaticResource ChipButton}" Command="{Binding NextPageCommand}" Height="26" Padding="8,2"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- A4 Preview Canvas / Container: Responsive Viewbox with HighQuality Crisp Rendering -->
                                    <Grid Grid.Row="1" Margin="6">
                                        <Border Background="White" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="4" ClipToBounds="True">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="Black"/>
                                            </Border.Effect>
                                            <Viewbox Stretch="Uniform">
                                                <Grid Width="2480" Height="3508" Background="White">
                                                    <Image Source="{Binding PreviewImage}" 
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           RenderOptions.EdgeMode="Aliased"/>

                                                    <!-- Placeholder text when empty -->
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoCards, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="💳" FontSize="180" HorizontalAlignment="Center" Opacity="0.2"/>
                                                        <TextBlock Text="Add e-Ration / Aadhaar / PAN / Ayushman PDFs" FontWeight="Bold" FontSize="64" Foreground="#444444" HorizontalAlignment="Center" Margin="0,30,0,0"/>
                                                        <TextBlock Text="Live top-to-bottom paper-saving layout will render here" FontSize="44" Foreground="#888888" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Viewbox>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- TAB 10: RESIZE SIGNATURE & PHOTO (PI7-STYLE RESIZER) EMBEDDED VIEW -->
                    <Grid Visibility="{Binding DataContext.IsResizeSignatureTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" 
                          DataContext="{Binding SignatureResizeVm}" 
                          Style="{StaticResource ContentFadeStyle}"
                          AllowDrop="True" Drop="SignatureTab_Drop" DragOver="SignatureTab_DragOver">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="490" MinWidth="440" MaxWidth="540"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: SETTINGS & CONTROLS -->
                        <Grid Grid.Column="0" Margin="0,0,16,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,4,8">
                                    <!-- File Dropzone & Selection Header -->
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Select Or Drag &amp; Drop Signature / Photo Here" FontSize="12.5" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="📂 Select Images" Style="{StaticResource AccentButton}" Command="{Binding BrowseCommand}" 
                                                        Padding="14,6" Margin="0,0,8,0" FontWeight="Bold"/>
                                                <Button Content="📋 Paste Image" Style="{StaticResource SecondaryButton}" Command="{Binding PasteClipboardCommand}" 
                                                        Padding="12,6" Margin="0,0,8,0" ToolTip="Paste image from clipboard (Ctrl+V)"/>
                                                <Button Content="✍️ Resize" Style="{StaticResource PrimaryButton}" Command="{Binding ResizeCommand}" 
                                                        IsEnabled="{Binding CanResize}" Padding="12,6" Margin="0,0,8,0" FontWeight="Bold" 
                                                        Visibility="{Binding HasInputImage, Converter={StaticResource BoolToVis}}" ToolTip="Resize and save signature"/>
                                                <Button Content="🔄 Reset" Style="{StaticResource ChipButton}" Command="{Binding ResetCommand}" 
                                                        Padding="10,6" ToolTip="Reset to defaults"/>
                                            </StackPanel>

                                        <!-- Selected File Info -->
                                        <Border Background="#12131D" CornerRadius="6" Padding="10,6" Margin="0,10,0,0" 
                                                Visibility="{Binding HasInputImage, Converter={StaticResource BoolToVis}}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="12" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding OriginalDimensionsText, StringFormat='{}Original Dimensions: {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10.5" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding OriginalFileSizeFormatted}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 1. Dimension Units (Pixel vs Centimeter) -->
                                <GroupBox Header="1. Dimension Units (Pixel or Centimeter)" Margin="0,0,0,10">
                                    <StackPanel Margin="0,6">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,8">
                                            <RadioButton Content="Pixel (px)" IsChecked="{Binding IsPixelMode}" Margin="0,0,24,0" FontWeight="Bold" FontSize="13"/>
                                            <RadioButton Content="Centimeter (cm)" IsChecked="{Binding IsCentimeterMode}" FontWeight="Bold" FontSize="13"/>
                                        </StackPanel>

                                        <!-- Pixel Input Mode -->
                                        <Grid Visibility="{Binding IsPixelMode, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Width (px):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="26"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding WidthPxText, UpdateSourceTrigger=PropertyChanged}" LostFocus="SignatureDimensionTextBox_LostFocus" Height="32" FontSize="14" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                                    <Grid Grid.Column="1" Margin="2,0,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Button Content="▲" Command="{Binding IncrementWidthCommand}" Style="{StaticResource SpinnerButtonStyle}" Margin="0,0,0,1"/>
                                                        <Button Grid.Row="1" Content="▼" Command="{Binding DecrementWidthCommand}" Style="{StaticResource SpinnerButtonStyle}" Margin="0,1,0,0"/>
                                                    </Grid>
                                                </Grid>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="✕" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="14,14,14,0"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Height (px):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="26"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding HeightPxText, UpdateSourceTrigger=PropertyChanged}" LostFocus="SignatureDimensionTextBox_LostFocus" Height="32" FontSize="14" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                                    <Grid Grid.Column="1" Margin="2,0,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Button Content="▲" Command="{Binding IncrementHeightCommand}" Style="{StaticResource SpinnerButtonStyle}" Margin="0,0,0,1"/>
                                                        <Button Grid.Row="1" Content="▼" Command="{Binding DecrementHeightCommand}" Style="{StaticResource SpinnerButtonStyle}" Margin="0,1,0,0"/>
                                                    </Grid>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Centimeter Input Mode -->
                                        <Grid Visibility="{Binding IsCentimeterMode, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Width (cm):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="26"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding WidthCmText, UpdateSourceTrigger=PropertyChanged}" LostFocus="SignatureDimensionTextBox_LostFocus" Height="32" FontSize="14" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                                    <Grid Grid.Column="1" Margin="2,0,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Button Content="▲" Command="{Binding IncrementWidthCommand}" Style="{StaticResource SpinnerButtonStyle}" Margin="0,0,0,1"/>
                                                        <Button Grid.Row="1" Content="▼" Command="{Binding DecrementWidthCommand}" Style="{StaticResource SpinnerButtonStyle}" Margin="0,1,0,0"/>
                                                    </Grid>
                                                </Grid>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="✕" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,14,10,0"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Height (cm):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="26"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding HeightCmText, UpdateSourceTrigger=PropertyChanged}" LostFocus="SignatureDimensionTextBox_LostFocus" Height="32" FontSize="14" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                                    <Grid Grid.Column="1" Margin="2,0,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Button Content="▲" Command="{Binding IncrementHeightCommand}" Style="{StaticResource SpinnerButtonStyle}" Margin="0,0,0,1"/>
                                                        <Button Grid.Row="1" Content="▼" Command="{Binding DecrementHeightCommand}" Style="{StaticResource SpinnerButtonStyle}" Margin="0,1,0,0"/>
                                                    </Grid>
                                                </Grid>
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="@" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,14,10,0"/>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="DPI:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding DpiOptions}" SelectedItem="{Binding SelectedDpi}" Height="32"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Dynamic Equivalent Size Readout -->
                                        <TextBlock Text="{Binding EquivalentPixelsText}" Foreground="{StaticResource AccentBrush}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- 2. Target File Size & Enhancement -->
                                <GroupBox Header="2. Target File Size &amp; Enhancement" Margin="0,0,0,10">
                                    <StackPanel Margin="0,6">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Column 0: Max Size -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Max File Size (KB):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="26"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding TargetSizeKBText, UpdateSourceTrigger=PropertyChanged}" 
                                                             LostFocus="SignatureDimensionTextBox_LostFocus"
                                                             Height="32" FontSize="14" FontWeight="Bold" 
                                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                                    <Grid Grid.Column="1" Margin="2,0,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Button Content="▲" Command="{Binding IncrementSizeCommand}" Style="{StaticResource SpinnerButtonStyle}" Margin="0,0,0,1"/>
                                                        <Button Grid.Row="1" Content="▼" Command="{Binding DecrementSizeCommand}" Style="{StaticResource SpinnerButtonStyle}" Margin="0,1,0,0"/>
                                                    </Grid>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Column 1: Min Size -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Min Size (0 = No Min):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" 
                                                           ToolTip="Minimum size requirement (e.g. SSC requires 10-20 KB)"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="26"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding MinSizeKBText, UpdateSourceTrigger=PropertyChanged}" 
                                                             LostFocus="SignatureDimensionTextBox_LostFocus"
                                                             Height="32" FontSize="14" FontWeight="Bold" 
                                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                                                             ToolTip="Set to 0 if no minimum requirement"/>
                                                    <Grid Grid.Column="1" Margin="2,0,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Button Content="▲" Command="{Binding IncrementMinSizeCommand}" Style="{StaticResource SpinnerButtonStyle}" Margin="0,0,0,1"/>
                                                        <Button Grid.Row="1" Content="▼" Command="{Binding DecrementMinSizeCommand}" Style="{StaticResource SpinnerButtonStyle}" Margin="0,1,0,0"/>
                                                    </Grid>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>

                                        <CheckBox IsChecked="{Binding CleanBackground}" Margin="0,0,0,6">
