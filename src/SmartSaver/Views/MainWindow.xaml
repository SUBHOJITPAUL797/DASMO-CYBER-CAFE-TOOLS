<Window x:Class="SmartSaver.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SmartSaver.Converters"
        xmlns:services="clr-namespace:SmartSaver.Services"
        Title="DASMO CYBER CAFE TOOLS" 
        Height="720" Width="1120"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False" Background="{StaticResource BackgroundBrush}"
        ResizeMode="CanResize">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InverseBool"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <converters:FileSizeFormatConverter x:Key="FileSizeConverter"/>
        <converters:StringEqualsConverter x:Key="StringEquals"/>

        <!-- Sidebar Navigation Button Style with Active Indicator Pill -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="6,1.5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Main Background Container -->
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 3.5px Active Left Accent Pill -->
                                    <Border x:Name="activePill" Width="3.5" Height="18" Background="{StaticResource AccentBrush}"
                                            CornerRadius="2" HorizontalAlignment="Left" Margin="-7,0,8,0" Visibility="Collapsed"/>
                                    <ContentPresenter Grid.Column="1" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border x:Name="hoverOverlay" Background="{StaticResource AccentBrush}" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Selected / Active Tab Trigger via Tag binding -->
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter TargetName="activePill" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hoverOverlay" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="hoverOverlay" Property="Opacity" Value="0.16"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Hub Tool Card Style -->
        <Style x:Key="HubCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="12" Effect="{StaticResource SoftDropShadow}"/>
                            <Border x:Name="cardBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="hoverOverlay" Background="{StaticResource TextBrush}" CornerRadius="12" Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
                            </Trigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hoverOverlay" Storyboard.TargetProperty="Opacity" To="0.04" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="hoverOverlay" Property="Opacity" Value="0.08"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Page Transition Animation Style -->
        <Style x:Key="ContentFadeStyle" TargetType="Grid">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="15"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="15" To="0" Duration="0:0:0.35">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- Outer Window Content (No border radius needed since WindowChrome handles the edges natively) -->
    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= TOP WINDOW TITLE BAR ================= -->
            <Grid Background="{StaticResource BackgroundBrush}" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Path Data="M 12 0 L 24 24 L 0 24 Z" Fill="{StaticResource AccentBrush}" Width="12" Height="10" Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock Text="DASMO CYBER CAFE TOOLS" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Professional Edition" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="12,2,0,0"/>
                    <!-- Super Admin Only Button -->
                    <Button x:Name="BtnTopAdminPanel" Content="🛡️ Admin Panel" Click="AdminPanel_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" Visibility="Collapsed"
                            Background="{StaticResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"
                            Padding="10,3" Margin="16,0,0,0" Cursor="Hand" BorderThickness="0"
                            ToolTip="Cloud Licensing &amp; Hardware Lock Control Center (Subhojit Paul Only)">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>
                </StackPanel>

                <!-- WindowChrome.IsHitTestVisibleInChrome="True" allows buttons to be clicked inside the caption area -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Top Update Notification Button -->
                    <Button Command="{Binding OpenUpdateDialogCommand}"
                            Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVis}}"
                            Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="11"
                            Padding="10,3" Margin="0,0,10,0" Cursor="Hand" BorderThickness="0"
                            ToolTip="New software update is available! Click to view details and install.">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚀 " FontSize="11"/>
                            <TextBlock Text="{Binding LatestVersionText, StringFormat='Update {0} Ready!'}" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Top Auto-Detect Capsule & Size Selector -->
                    <Grid x:Name="AutoDetectCapsuleContainer" Margin="0,0,12,0" VerticalAlignment="Center">
                        <!-- Capsule Border with Glowing Drop Shadow -->
                        <Border x:Name="BtnAutoDetectCapsule" CornerRadius="14" BorderThickness="1.5"
                                Effect="{StaticResource SoftDropShadow}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <!-- Prompt mode default: vibrant emerald gradient -->
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#059669" Offset="0"/>
                                                <GradientStop Color="#0D9488" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="BorderBrush" Value="#34D399"/>
                                    <Style.Triggers>
                                        <!-- Silent mode: electric violet to cobalt gradient -->
                                        <DataTrigger Binding="{Binding IsSilentMode}" Value="True">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#7C3AED" Offset="0"/>
                                                        <GradientStop Color="#2563EB" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="BorderBrush" Value="#A78BFA"/>
                                        </DataTrigger>
                                        <!-- Off mode: dark slate with red warning border -->
                                        <DataTrigger Binding="{Binding IsOffMode}" Value="True">
                                            <Setter Property="Background" Value="#1E202E"/>
                                            <Setter Property="BorderBrush" Value="#EF4444"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Mode Cycle Button (Left side of capsule) -->
                                <Button Command="{Binding ToggleAutoDetectCommand}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Padding="10,4,6,4" ToolTip="{Binding AutoDetectTooltip}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AutoDetectStatusIcon}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding AutoDetectStatusText}" FontWeight="Bold" FontSize="11" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Dropdown Arrow / Quick Size Picker Button (Right side of capsule) -->
                                <Button Command="{Binding OpenSilentSizePopupCommand}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Padding="2,4,8,4" ToolTip="Choose Auto-Compress File Size &amp; Settings">
                                    <Border Background="#25FFFFFF" CornerRadius="8" Padding="5,1">
                                        <TextBlock Text="▾" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Glassmorphic Size Selector Popup -->
                        <Popup x:Name="SilentSizePopup" 
                               IsOpen="{Binding IsSilentSizePopupOpen, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=BtnAutoDetectCapsule}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Slide"
                               VerticalOffset="6">
                            <Border Background="#161826" BorderBrush="#8B5CF6" BorderThickness="1.5" CornerRadius="12"
                                    Width="340" Padding="14" Effect="{StaticResource SoftDropShadow}">
                                <StackPanel>
                                    <!-- Header -->
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🤖" FontSize="14" Margin="0,0,6,0"/>
                                            <TextBlock Text="Silent Auto-Compress Size" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                        </StackPanel>
                                        <Button Content="✕" Command="{Binding CloseSilentSizePopupCommand}"
                                                HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                                                Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Cursor="Hand" Padding="4"/>
                                    </Grid>

                                    <!-- Description -->
                                    <TextBlock Text="Files downloaded in background will be compressed directly to this target size:"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                    <!-- Quick Preset Buttons -->
                                    <TextBlock Text="PRESET TARGET SIZES:" FontSize="10" FontWeight="Bold" Foreground="#A78BFA" Margin="0,0,0,6"/>
                                    <WrapPanel Margin="0,0,0,10">
                                        <Button Content="50 KB" Command="{Binding SetSilentTargetSizeCommand}" CommandParameter="50"
                                                Style="{StaticResource ChipButton}" Margin="0,0,6,6"
                                                ToolTip="Ideal for candidate photos &amp; signatures (Govt portals)"/>
                                        <Button Content="100 KB" Command="{Binding SetSilentTargetSizeCommand}" CommandParameter="100"
                                                Style="{StaticResource ChipButton}" Margin="0,0,6,6"
                                                ToolTip="State portal online application limit"/>
                                        <Button Content="150 KB" Command="{Binding SetSilentTargetSizeCommand}" CommandParameter="150"
                                                Style="{StaticResource ChipButton}" Margin="0,0,6,6"
                                                ToolTip="WBCSC / SSC standard document limit"/>
                                        <Button Content="200 KB (Govt Std)" Command="{Binding SetSilentTargetSizeCommand}" CommandParameter="200"
                                                Style="{StaticResource ChipButton}" Margin="0,0,6,6"
                                                FontWeight="Bold" Foreground="#10B981"
                                                ToolTip="Standard Central Govt &amp; SSC online portal default"/>
                                        <Button Content="300 KB" Command="{Binding SetSilentTargetSizeCommand}" CommandParameter="300"
                                                Style="{StaticResource ChipButton}" Margin="0,0,6,6"
                                                ToolTip="High clarity scans &amp; colour certificates"/>
                                        <Button Content="500 KB" Command="{Binding SetSilentTargetSizeCommand}" CommandParameter="500"
                                                Style="{StaticResource ChipButton}" Margin="0,0,6,6"
                                                ToolTip="Multi-page documents &amp; large forms"/>
                                    </WrapPanel>

                                    <!-- Custom Size Input Row -->
                                    <Border Background="#1F2236" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Custom:" FontSize="11" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding CustomSilentSizeText, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="6,3" FontSize="12" VerticalContentAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Grid.Column="2" Text="KB" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Button Grid.Column="3" Content="Apply" Command="{Binding ApplyCustomSilentSizeCommand}"
                                                    Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="Bold" FontSize="11"
                                                    Padding="10,4" Cursor="Hand" BorderThickness="0">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>

                                    <!-- Mode Quick Toggles -->
                                    <TextBlock Text="SWITCH MODE:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{Binding SetModeCommand}" CommandParameter="prompt"
                                                Style="{StaticResource ChipButton}" Margin="0,0,4,0" ToolTip="Prompt me with dialog on download">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="⚡ " FontSize="11"/>
                                                <TextBlock Text="Prompt Mode" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Command="{Binding SetModeCommand}" CommandParameter="off"
                                                Style="{StaticResource ChipButton}" Margin="4,0,0,0" ToolTip="Disable auto-monitoring">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="⛔ " FontSize="11"/>
                                                <TextBlock Text="Turn Off" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button Content="🗕" Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" ToolTip="Minimize to Tray"/>
                    <Button Content="🗖" Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click" ToolTip="Maximize / Restore"/>
                    <Button Content="✕" Style="{StaticResource TitleBarCloseButton}" Click="CloseButton_Click" ToolTip="Close to Background Tray"/>
                </StackPanel>
            </Grid>

            <!-- ================= MAIN CONTENT AREA ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding SidebarGridWidth}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR -->
                <Border Background="#0E131F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Grid.Column="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Brand Header with Collapse Toggle -->
                        <Border Padding="10,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <TextBlock Text="DASMO CYBER CAFE TOOLS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{Binding CurrentVersionDisplay, StringFormat='1-Click Cyber Cafe Suite • {0}'}" FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1" Style="{StaticResource ChipButton}" Command="{Binding ToggleSidebarCommand}" ToolTip="{Binding SidebarToggleTooltip}" Width="28" Height="28" Padding="0" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SidebarToggleIcon}" FontSize="11" Foreground="{StaticResource TextBrush}"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Sidebar Navigation Menu -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6"
                                      PreviewMouseWheel="SidebarScrollViewer_PreviewMouseWheel">
                            <StackPanel>
                                <!-- ================= SECTION 1: CORE HUB ================= -->
                                <TextBlock Text="CORE HUB" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="14,8,0,4"
                                           Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

                                <Button Style="{StaticResource SidebarNavButtonStyle}" Tag="{Binding IsHomeTab}" Command="{Binding NavigateCommand}" CommandParameter="0" ToolTip="Tools Dashboard">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🏠" Margin="0,0,10,0" FontSize="14"/>
                                        <TextBlock Text="Dashboard (Home)" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SidebarNavButtonStyle}" Tag="{Binding IsHistoryTab}" Command="{Binding NavigateCommand}" CommandParameter="7" ToolTip="Output History &amp; Recent Activity">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🕒" Margin="0,0,10,0" FontSize="14"/>
                                        <TextBlock Text="Output History" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Button>

                                <!-- ================= SECTION 2: PDF & DOCUMENTS ================= -->
                                <TextBlock Text="PDF &amp; DOCUMENTS" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="14,14,0,4"
                                           Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

                                <Button Style="{StaticResource SidebarNavButtonStyle}" Tag="{Binding IsMergeTab}" Command="{Binding NavigateCommand}" CommandParameter="1" ToolTip="Merge Multiple PDFs">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📑" Margin="0,0,10,0" FontSize="14"/>
                                        <TextBlock Text="Merge PDFs" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SidebarNavButtonStyle}" Tag="{Binding IsSplitTab}" Command="{Binding NavigateCommand}" CommandParameter="2" ToolTip="Split / Extract PDF">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✂️" Margin="0,0,10,0" FontSize="14"/>
                                        <TextBlock Text="Split / Extract PDF" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SidebarNavButtonStyle}" Tag="{Binding IsImg2PdfTab}" Command="{Binding NavigateCommand}" CommandParameter="3" ToolTip="Images to PDF">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖼️" Margin="0,0,10,0" FontSize="14"/>
                                        <TextBlock Text="Images to PDF" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SidebarNavButtonStyle}" Tag="{Binding IsPdf2ImgTab}" Command="{Binding NavigateCommand}" CommandParameter="4" ToolTip="PDF to JPG Images">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📄" Margin="0,0,10,0" FontSize="14"/>
                                        <TextBlock Text="PDF to JPG Images" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SidebarNavButtonStyle}" Tag="{Binding IsPdfEditorTab}" Command="{Binding NavigateCommand}" CommandParameter="16" ToolTip="📝 PDF Editor Studio (In-Place Edit, Erase &amp; Vector Text/Photos)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📝" Margin="0,0,10,0" FontSize="14"/>
                                        <TextBlock Text="PDF Editor Studio" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Button>

                                <!-- ================= SECTION 3: ID CARDS & PHOTO STUDIO ================= -->
                                <TextBlock Text="ID CARDS &amp; PHOTOS" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="14,14,0,4"
                                           Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

                                <Button Style="{StaticResource SidebarNavButtonStyle}" Tag="{Binding IsGovtCardTab}" Command="{Binding NavigateCommand}" CommandParameter="9" ToolTip="Ration / Aadhaar / Ayushman Multi-Card Print">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💳" Margin="0,0,10,0" FontSize="14"/>
                                        <TextBlock Text="Ration / Aadhaar Print" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SidebarNavButtonStyle}" Tag="{Binding IsPassportStudioTab}" Command="{Binding NavigateCommand}" CommandParameter="13" ToolTip="📸 Passport Photo Studio &amp; Multi-Size Sheet (A4 &amp; 4x6)">
                                    <StackPanel Orientation="Horizontal">
