                                        </StackPanel>
                                    </Border>
                                    <Border Background="#141520" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="4,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="DUPLEX ENGINE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="Replacement in 2 (1 Sheet = 2 Pages)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
                                            <TextBlock Text="DEVMODE auto-detection + 1-click toggle" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#141520" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="RUSH-HOUR BILLING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="Active Cart + Thermal / WhatsApp" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0"/>
                                            <TextBlock Text="Press Ctrl+Enter or F12 for 1-click bill" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Launch Studio Hero CTA -->
                                <Border Grid.Row="2" Background="#141520" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="30">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🖨️" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                        <TextBlock Text="Open Print Counter &amp; Billing Studio Workspace" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="Click below to open the dedicated dual-pane rush-hour billing studio window with active cart, live total, quick photocopy pad, thermal receipt preview, and customer history." 
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="600" TextAlignment="Center" Margin="0,0,0,20"/>
                                        <Button Content="⚡ Open Dedicated Studio (F12 / Ctrl+Enter)" Style="{StaticResource PrimaryButton}" Command="{Binding OpenPrintTrackerStudioCommand}" HorizontalAlignment="Center" Padding="24,12" FontSize="14" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- TAB 13: PASSPORT STUDIO & MULTI-SIZE SHEET EMBEDDED VIEW -->
                    <Grid Visibility="{Binding DataContext.IsPassportStudioTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" 
                          DataContext="{Binding PassportStudioVm}" Style="{StaticResource ContentFadeStyle}"
                          AllowDrop="True" Drop="PassportTab_Drop" DragOver="PassportTab_DragOver">
                        <Grid Margin="0">
                            <Grid.RowDefinitions>
                                <!-- Top Action Bar -->
                                <RowDefinition Height="Auto"/>
                                <!-- Main Studio Visuals -->
                                <RowDefinition Height="*"/>
                                <!-- Bottom Status & Export Bar -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- TOP ACTION BAR -->
                            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📸" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Professional Passport Photo Studio &amp; Multi-Size Sheet Suite" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource AccentBrush}"/>
                                            <TextBlock Text="Change background, enhance portrait lighting, and pack multi-size photos with zero paper waste" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="📂 Choose Photo" Command="{Binding BrowsePhotoCommand}" Style="{StaticResource PrimaryButton}" Height="32" Padding="12,0" Margin="0,0,6,0"/>
                                        <Button Content="📋 Paste Clipboard" Command="{Binding PasteClipboardCommand}" Style="{StaticResource OutlineButton}" Height="32" Padding="10,0" Margin="0,0,6,0"/>
                                        <Button Content="✂️ Crop Photo" Command="{Binding CropPhotoCommand}" Style="{StaticResource OutlineButton}" Height="32" Padding="10,0" Margin="0,0,6,0" IsEnabled="{Binding HasPhoto}" ToolTip="Crop portrait or adjust passport bounds"/>
                                        <Button Content="↺" Command="{Binding RotateLeftCommand}" Style="{StaticResource OutlineButton}" Height="32" Width="34" Margin="0,0,6,0" IsEnabled="{Binding HasPhoto}" ToolTip="Rotate 90° Left (Counter-Clockwise)"/>
                                        <Button Content="🌐 Single Photo (Govt)" Command="{Binding OpenSingleExportCommand}" Style="{StaticResource AccentButton}" Height="32" Padding="12,0" Margin="0,0,6,0" FontWeight="Bold" IsEnabled="{Binding HasPhoto}" ToolTip="Export 1 single passport photo for SSC, UPSC, PAN &amp; online exam portals (20–50 KB)"/>
                                        <Button Content="🖨️ Direct Print Sheet" Command="{Binding PrintSheetCommand}" Style="{StaticResource PrimaryButton}" Height="32" Padding="14,0" Margin="0,0,8,0" FontWeight="Bold" ToolTip="Send entire sheet directly to printer at 300 DPI"/>
                                        <Button Content="↗️ Open in New Window" Command="{Binding DataContext.OpenPassportStudioCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource OutlineButton}" Height="32" Padding="12,0" FontWeight="Bold" ToolTip="Pop out into a standalone resizable window"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- MAIN 2-COLUMN STUDIO AREA -->
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <!-- Left: Studio Controls Panel -->
                                    <ColumnDefinition Width="420"/>
                                    <!-- Right: Live Sheet Canvas -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT CONTROLS -->
                                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                                    <StackPanel>
                                        <!-- Loaded Portrait Preview & Crop Tools -->
                                        <GroupBox Header="Loaded Portrait &amp; Crop" Margin="0,0,0,10" Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}}">
                                            <Grid Margin="4,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="52" Height="64" Background="#0A0B10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center" ClipToBounds="True">
                                                    <Image Source="{Binding PhotoPreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="✂️ Crop Photo" Command="{Binding CropPhotoCommand}" Style="{StaticResource OutlineButton}" Height="26" Padding="8,2" Margin="0,0,4,0" FontSize="11" ToolTip="Crop portrait or adjust passport bounds"/>
                                                        <Button Content="↺ Rotate" Command="{Binding RotateLeftCommand}" Style="{StaticResource OutlineButton}" Height="26" Padding="6,2" Margin="0,0,4,0" FontSize="11" ToolTip="Rotate 90° Left"/>
                                                        <Button Content="↻ Rotate" Command="{Binding RotateRightCommand}" Style="{StaticResource OutlineButton}" Height="26" Padding="6,2" FontSize="11" ToolTip="Rotate 90° Right"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </GroupBox>

                                        <!-- 1. Background Replacement & Color Palette -->
                                        <GroupBox Header="1. Studio Background Replacement &amp; Color Palette" Margin="0,0,0,10">
                                            <StackPanel Margin="4,6">
                                                <!-- Preset Swatches -->
                                                <WrapPanel Margin="0,0,0,6">
                                                    <Button Content="⚪ White" Command="{Binding SelectBgCommand}" CommandParameter="white" Style="{StaticResource OutlineButton}" Padding="8,4" Margin="0,0,4,4" FontWeight="SemiBold" ToolTip="Standard Passport / Visa / PAN White"/>
                                                    <Button Content="🔷 Sky Blue" Command="{Binding SelectBgCommand}" CommandParameter="blue" Style="{StaticResource OutlineButton}" Padding="8,4" Margin="0,0,4,4" FontWeight="SemiBold" ToolTip="Indian Govt SSC / UPSC / IBPS Exam Sky Blue (#4A90E2)"/>
                                                    <Button Content="🔵 Royal Blue" Command="{Binding SelectBgCommand}" CommandParameter="royalblue" Style="{StaticResource OutlineButton}" Padding="8,4" Margin="0,0,4,4" ToolTip="Deep Royal Blue for College / PSU Applications"/>
                                                    <Button Content="🔘 Studio Gray" Command="{Binding SelectBgCommand}" CommandParameter="gray" Style="{StaticResource OutlineButton}" Padding="8,4" Margin="0,0,4,4" ToolTip="Neutral Corporate Studio Gray"/>
                                                    <Button Content="🔴 Crimson" Command="{Binding SelectBgCommand}" CommandParameter="red" Style="{StaticResource OutlineButton}" Padding="8,4" Margin="0,0,4,4" ToolTip="Passport / Visa / Security Red"/>
                                                    <Button Content="🟢 Soft Green" Command="{Binding SelectBgCommand}" CommandParameter="green" Style="{StaticResource OutlineButton}" Padding="8,4" Margin="0,0,4,4" ToolTip="Pass / ID Soft Green"/>
                                                    <Button Content="🍦 Cream" Command="{Binding SelectBgCommand}" CommandParameter="cream" Style="{StaticResource OutlineButton}" Padding="8,4" Margin="0,0,4,4" ToolTip="Warm Off-White Studio Tone"/>
                                                    <Button Content="🖼️ Original" Command="{Binding SelectBgCommand}" CommandParameter="original" Style="{StaticResource OutlineButton}" Padding="8,4" Margin="0,0,4,4" ToolTip="Keep original untouched background"/>
                                                </WrapPanel>

                                                <!-- Custom Color Picker & Active Swatch -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Content="🎨 Pick Any Color..." Command="{Binding PickCustomColorCommand}" Style="{StaticResource PrimaryButton}" Padding="10,4" Height="28" FontSize="11.5" FontWeight="SemiBold" ToolTip="Open full Windows color palette to select ANY custom color"/>
                                                    <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}" Padding="6,2" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="16" Height="16" CornerRadius="3" Background="{Binding SelectedColorBrush}" BorderBrush="#888888" BorderThickness="1" Margin="0,0,6,0"/>
                                                            <TextBlock Text="Active: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding SelectedColorHex}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <!-- Removal Sensitivity / Tolerance Slider -->
                                                <Grid Margin="0,2,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="35"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Removal Sensitivity:" VerticalAlignment="Center" FontSize="11" ToolTip="Adjust background removal strength. Increase for wall shadows; decrease for fine hair detail."/>
                                                    <Slider Grid.Column="1" Minimum="15" Maximum="120" Value="{Binding BackgroundTolerance}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding BackgroundTolerance, StringFormat='{}{0:F0}'}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Grid>

                                                <!-- AI Smart Background Status Badge -->
                                                <Border CornerRadius="4" Padding="6,4" Margin="0,4,0,2" Background="#162338" BorderBrush="#2C4A6F" BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AiStatusIcon}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding AiStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#64B5F6" VerticalAlignment="Center"/>
                                                        <ProgressBar IsIndeterminate="True" Height="3" Width="45" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                     Foreground="#64B5F6" Background="#223344" BorderThickness="0"
                                                                     Visibility="{Binding IsAiSegmenting, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </GroupBox>

                                        <!-- 2. Studio Lighting & Tone -->
                                        <GroupBox Header="2. Studio Lighting &amp; Face Tone Fix" Margin="0,0,0,10">
                                            <StackPanel Margin="4,6">
                                                <CheckBox Content="✨ Auto Portrait Lighting (Brighten shadows on face)" IsChecked="{Binding AutoEnhance}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                
                                                <!-- Brightness -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="35"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Brightness:" VerticalAlignment="Center" FontSize="11.5"/>
                                                    <Slider Grid.Column="1" Minimum="-50" Maximum="50" Value="{Binding Brightness}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Brightness, StringFormat='{}{0:F0}'}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Grid>

                                                <!-- Contrast -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="35"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Contrast:" VerticalAlignment="Center" FontSize="11.5"/>
                                                    <Slider Grid.Column="1" Minimum="-50" Maximum="50" Value="{Binding Contrast}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Contrast, StringFormat='{}{0:F0}'}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Grid>

                                                <!-- Skin Warmth -->
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="35"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Skin Warmth:" VerticalAlignment="Center" FontSize="11.5" ToolTip="Adds healthy natural skin warmth, removing pale or fluorescent tube tints"/>
                                                    <Slider Grid.Column="1" Minimum="-30" Maximum="30" Value="{Binding SkinWarmth}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding SkinWarmth, StringFormat='{}{0:F0}'}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Grid>

                                                <Button Content="↺ Reset Lighting" Command="{Binding ResetLightingCommand}" Style="{StaticResource OutlineButton}" Height="26" HorizontalAlignment="Right" Padding="8,2" FontSize="11"/>
                                            </StackPanel>
                                        </GroupBox>

                                        <!-- 3. Sheet Paper & Margins -->
                                        <GroupBox Header="3. Sheet Paper &amp; Cutting Margins" Margin="0,0,0,10">
                                            <StackPanel Margin="4,6">
                                                <!-- Paper Size Selector -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="Paper Size: " VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                    <RadioButton GroupName="EmbedPaperSizeGroup" Content="📄 A4 Paper (21.0 × 29.7 cm)" IsChecked="{Binding IsA4}" Command="{Binding SetPaperSizeCommand}" CommandParameter="A4" FontWeight="Bold" Margin="0,0,12,0"/>
                                                    <RadioButton GroupName="EmbedPaperSizeGroup" Content="📸 4 × 6 Inch Photo Paper" IsChecked="{Binding Is4x6}" Command="{Binding SetPaperSizeCommand}" CommandParameter="4x6" FontWeight="Bold"/>
                                                </StackPanel>

                                                <!-- Paper Orientation -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="Orientation: " VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                    <RadioButton GroupName="EmbedOrientationGroup" Content="📱 Portrait (Vertical)" IsChecked="{Binding IsPortrait}" Command="{Binding SetOrientationCommand}" CommandParameter="Portrait" FontWeight="SemiBold" Margin="0,0,12,0"/>
                                                    <RadioButton GroupName="EmbedOrientationGroup" Content="🖥️ Landscape (Horizontal)" IsChecked="{Binding IsLandscape}" Command="{Binding SetOrientationCommand}" CommandParameter="Landscape" FontWeight="SemiBold"/>
                                                </StackPanel>

                                                <!-- Top Start Gap / Margin (Where photos start from) -->
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="70"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Top Start Gap (Y):" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" ToolTip="Decide where from the top edge of paper the photos will start printing"/>
                                                    <Slider Grid.Column="1" Minimum="0" Maximum="{Binding MaxTopMarginMm}" Value="{Binding TopMarginMm}" SmallChange="1" LargeChange="5" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBox Text="{Binding TopMarginMmText, UpdateSourceTrigger=PropertyChanged}" LostFocus="PassportDimensionTextBox_LostFocus" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Width="44" Height="26" ToolTip="Top gap in millimeters (mm)"/>
                                                        <TextBlock Text=" mm" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Quick Preset Chips for Top Gap -->
                                                <StackPanel Orientation="Horizontal" Margin="130,0,0,8">
                                                    <Button Content="− 5mm" Command="{Binding NudgeTopMarginCommand}" CommandParameter="-5" Style="{StaticResource OutlineButton}" Padding="4,2" Margin="0,0,3,0" FontSize="10" ToolTip="Nudge photos UP by 5 mm"/>
                                                    <Button Content="+ 5mm" Command="{Binding NudgeTopMarginCommand}" CommandParameter="5" Style="{StaticResource OutlineButton}" Padding="4,2" Margin="0,0,5,0" FontSize="10" ToolTip="Nudge photos DOWN by 5 mm"/>
                                                    <Button Content="0 mm" Command="{Binding SetTopMarginCommand}" CommandParameter="0" Style="{StaticResource OutlineButton}" Padding="4,2" Margin="0,0,3,0" FontSize="10" ToolTip="Start flush at the top edge"/>
                                                    <Button Content="6 mm (Std)" Command="{Binding SetTopMarginCommand}" CommandParameter="6" Style="{StaticResource OutlineButton}" Padding="4,2" Margin="0,0,3,0" FontSize="10" ToolTip="Standard 6mm top margin"/>
                                                    <Button Content="20 mm" Command="{Binding SetTopMarginCommand}" CommandParameter="20" Style="{StaticResource OutlineButton}" Padding="4,2" Margin="0,0,3,0" FontSize="10" ToolTip="Start 2 cm down"/>
                                                    <Button Content="50 mm" Command="{Binding SetTopMarginCommand}" CommandParameter="50" Style="{StaticResource OutlineButton}" Padding="4,2" Margin="0,0,3,0" FontSize="10" ToolTip="Start 5 cm down (for used/cut sheets)"/>
                                                    <Button Content="100 mm" Command="{Binding SetTopMarginCommand}" CommandParameter="100" Style="{StaticResource OutlineButton}" Padding="4,2" FontSize="10" ToolTip="Start 10 cm down"/>
                                                </StackPanel>

                                                <!-- Scissor Cutting Gap -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="45"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Scissor Cutting Gap:" VerticalAlignment="Center" FontSize="11.5" ToolTip="Space between photos for easy cutting with scissors/guillotine"/>
                                                    <Slider Grid.Column="1" Minimum="0" Maximum="10" Value="{Binding GapMm}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding GapMm, StringFormat='{}{0:F1} mm'}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Grid>

                                                <!-- Photo Border Thickness -->
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="45"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Photo Border Line:" VerticalAlignment="Center" FontSize="11.5" ToolTip="Thin border line around each photo for straight scissor guidance"/>
                                                    <Slider Grid.Column="1" Minimum="0" Maximum="3" Value="{Binding BorderThickness}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding BorderThickness, StringFormat='{}{0} px'}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Grid>
                                            </StackPanel>
                                        </GroupBox>

                                        <!-- 4. Photo Sizing & Multi-Size Combo Pack -->
                                        <GroupBox Header="4. Photo Sizing &amp; Smart Zero-Waste Packing" Margin="0,0,0,10">
                                            <StackPanel Margin="4,6">
                                                <!-- Sizing Mode Radio -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <RadioButton GroupName="EmbedSizingModeGroup" Content="Single Size Grid" IsChecked="{Binding IsComboMode, Converter={StaticResource InverseBool}}" Margin="0,0,16,0" FontWeight="SemiBold"/>
                                                    <RadioButton GroupName="EmbedSizingModeGroup" Content="🔀 Multi-Size Combo (Same Sheet)" IsChecked="{Binding IsComboMode}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" ToolTip="Pack Passport + Stamp + PAN sizes onto the SAME sheet"/>
                                                </StackPanel>

                                                <!-- SINGLE SIZE CONTROLS -->
                                                <StackPanel Visibility="{Binding IsComboMode, Converter={StaticResource InverseBoolToVis}}">
                                                    <ComboBox ItemsSource="{Binding SizePresets}" SelectedItem="{Binding SelectedSizePreset}" Height="30" Margin="0,0,0,8"/>
                                                    
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="65"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="65"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Width: " VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBox Grid.Column="1" Text="{Binding PhotoWidthCmText, UpdateSourceTrigger=PropertyChanged}" LostFocus="PassportDimensionTextBox_LostFocus" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text=" cm  ×  Height: " VerticalAlignment="Center" Margin="4,0"/>
                                                        <TextBox Grid.Column="3" Text="{Binding PhotoHeightCmText, UpdateSourceTrigger=PropertyChanged}" LostFocus="PassportDimensionTextBox_LostFocus" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                                        <TextBlock Grid.Column="4" Text=" cm" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                    </Grid>

                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Copies to Print: " VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                                        <TextBox Grid.Column="1" Text="{Binding CopiesCount, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                                        <Button Grid.Column="2" Content="⚡ Fill Max Copies" Command="{Binding FillMaxCopiesCommand}" Style="{StaticResource OutlineButton}" Height="30" Margin="8,0,0,0" ToolTip="Fill entire sheet to maximum capacity with 0 paper waste"/>
                                                    </Grid>

                                                    <!-- Quick Preset Copies Chips -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                                                        <TextBlock Text="Quick:" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                                        <Button Content="4" Command="{Binding SetCopiesCommand}" CommandParameter="4" Style="{StaticResource OutlineButton}" Padding="6,2" Margin="0,0,4,0" FontSize="11"/>
                                                        <Button Content="6" Command="{Binding SetCopiesCommand}" CommandParameter="6" Style="{StaticResource OutlineButton}" Padding="6,2" Margin="0,0,4,0" FontSize="11"/>
                                                        <Button Content="8" Command="{Binding SetCopiesCommand}" CommandParameter="8" Style="{StaticResource OutlineButton}" Padding="6,2" Margin="0,0,4,0" FontSize="11"/>
                                                        <Button Content="10" Command="{Binding SetCopiesCommand}" CommandParameter="10" Style="{StaticResource OutlineButton}" Padding="6,2" Margin="0,0,4,0" FontSize="11" ToolTip="2 complete rows of 5"/>
                                                        <Button Content="12" Command="{Binding SetCopiesCommand}" CommandParameter="12" Style="{StaticResource OutlineButton}" Padding="6,2" Margin="0,0,4,0" FontSize="11"/>
                                                        <Button Content="15" Command="{Binding SetCopiesCommand}" CommandParameter="15" Style="{StaticResource OutlineButton}" Padding="6,2" Margin="0,0,4,0" FontSize="11" ToolTip="3 complete rows of 5"/>
                                                        <Button Content="20" Command="{Binding SetCopiesCommand}" CommandParameter="20" Style="{StaticResource OutlineButton}" Padding="6,2" Margin="0,0,4,0" FontSize="11" ToolTip="4 complete rows of 5"/>
                                                        <Button Content="⚡ Full Sheet" Command="{Binding FillMaxCopiesCommand}" Style="{StaticResource OutlineButton}" Padding="8,2" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" ToolTip="Fill maximum photos with 0 paper waste"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- MULTI-SIZE COMBO CONTROLS -->
                                                <StackPanel Visibility="{Binding IsComboMode, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Pack multiple photo sizes on this SAME sheet without paper wastage:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>

                                                    <!-- Batch 1: Passport -->
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="80"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Batch 1: Standard Passport (3.5 × 4.5 cm)" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        <TextBox Grid.Column="1" Text="{Binding ComboBatch1Count, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontWeight="Bold"/>
                                                    </Grid>

                                                    <!-- Batch 2: Stamp -->
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="80"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Batch 2: Stamp Size (2.5 × 3.0 cm)" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        <TextBox Grid.Column="1" Text="{Binding ComboBatch2Count, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontWeight="Bold"/>
                                                    </Grid>

                                                    <!-- Batch 3: PAN -->
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="80"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Batch 3: PAN / Small (2.5 × 3.5 cm)" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        <TextBox Grid.Column="1" Text="{Binding ComboBatch3Count, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontWeight="Bold"/>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- RIGHT: LIVE SHEET CANVAS -->
                                <Border Grid.Column="1" Background="#090A10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Preview View Mode Bar -->
                                        <Border Background="#161824" Padding="12,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="👁️ Sheet Preview" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextBrush}" Margin="4,0,10,0"/>
                                                    <TextBlock Text="• Auto Zero-Waste Space Fit" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <RadioButton GroupName="EmbedViewModeGroup" Content="🔍 Fit Full Page" IsChecked="{Binding IsFitPageMode}" Command="{Binding SetViewModeCommand}" CommandParameter="FitPage" FontSize="11" FontWeight="SemiBold" Margin="0,0,12,0"/>
                                                    <RadioButton GroupName="EmbedViewModeGroup" Content="🔍 1:1 Actual Size" IsChecked="{Binding IsActualSizeMode}" Command="{Binding SetViewModeCommand}" CommandParameter="ActualSize" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Fit Page Mode -->
                                        <Grid Grid.Row="1" Visibility="{Binding IsFitPageMode, Converter={StaticResource BoolToVis}}" Margin="14">
                                            <Border Background="White" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="2">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                                                </Border.Effect>
                                                <Image Source="{Binding SheetPreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                        </Grid>

                                        <!-- Actual Size Mode -->
                                        <ScrollViewer Grid.Row="1" Visibility="{Binding IsActualSizeMode, Converter={StaticResource BoolToVis}}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#090A10" Padding="14">
                                            <Border Background="White" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="2">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                                                </Border.Effect>
                                                <Image Source="{Binding SheetPreviewImage}" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                        </ScrollViewer>

                                        <!-- Placeholder if no photo loaded yet -->
                                        <Grid Visibility="{Binding HasPhoto, Converter={StaticResource InverseBoolToVis}}" Background="#12131CEE">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="📸" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                                <TextBlock Text="No Photo Loaded" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                <TextBlock Text="Click 'Choose Photo' or 'Paste Clipboard' to start creating studio sheets." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="📂 Choose Photo" Command="{Binding BrowsePhotoCommand}" Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,8,0"/>
                                                    <Button Content="📋 Paste Clipboard" Command="{Binding PasteClipboardCommand}" Style="{StaticResource OutlineButton}" Padding="14,8"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Loading Indicator -->
                                        <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Top" 
                                                     Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" 
                                                     Foreground="{StaticResource AccentBrush}" Background="Transparent" BorderThickness="0"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- BOTTOM STATUS & EXPORT BAR -->
                            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚡ Status: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="{Binding SheetSummary}" FontSize="11.5" Foreground="{StaticResource TextBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="💳 Export PAN Card Photo" Command="{Binding OpenPanPhotoExportCommand}" Style="{StaticResource AccentButton}" Height="34" Padding="14,0" Margin="0,0,8,0" FontWeight="Bold" IsEnabled="{Binding HasPhoto}" ToolTip="1-Click official 2.5×3.5 cm (200 DPI, &lt;50 KB) photo for NSDL / UTI PAN portal upload"/>
                                        <Button Content="🌐 Export Single Photo (Govt Upload)" Command="{Binding OpenSingleExportCommand}" Style="{StaticResource OutlineButton}" Height="34" Padding="14,0" Margin="0,0,8,0" FontWeight="Bold" IsEnabled="{Binding HasPhoto}" ToolTip="Export 1 single photo (20–50 KB) for SSC, UPSC, PAN &amp; Govt exam portals"/>
                                        <Button Content="💾 Save as PDF" Command="{Binding SaveSheetPdfCommand}" Style="{StaticResource OutlineButton}" Height="34" Padding="12,0" Margin="0,0,8,0" ToolTip="Export print-ready PDF document"/>
                                        <Button Content="🖼️ Save High-Res JPG" Command="{Binding SaveSheetJpgCommand}" Style="{StaticResource OutlineButton}" Height="34" Padding="12,0" Margin="0,0,8,0" ToolTip="Export 300 DPI high-resolution JPEG"/>
                                        <Button Content="🖨️ Direct Print Sheet" Command="{Binding PrintSheetCommand}" Style="{StaticResource PrimaryButton}" Height="34" Padding="16,0" FontWeight="Bold" ToolTip="Send directly to native printer dialog at 300 DPI"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- MODAL OVERLAY: EXPORT SINGLE PASSPORT PHOTO FOR GOVT / ONLINE UPLOADS -->
                            <Grid Grid.RowSpan="3" Visibility="{Binding IsSingleExportDialogOpen, Converter={StaticResource BoolToVis}}" Background="#CC090A12" Panel.ZIndex="100">
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" CornerRadius="12" 
                                        Width="640" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0" ClipToBounds="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.75" Color="#000000"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="46"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="56"/>
                                        </Grid.RowDefinitions>

                                        <!-- Title Bar -->
                                        <Border Grid.Row="0" Background="#141724" Padding="16,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🌐 " FontSize="16"/>
                                                    <TextBlock Text="Export Single Passport Photo (Govt Form &amp; Online Upload)" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource AccentBrush}"/>
                                                </StackPanel>
                                                <Button Content="✕" Command="{Binding CloseSingleExportCommand}" Style="{StaticResource TitleBarCloseButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28"/>
                                            </Grid>
                                        </Border>

                                        <!-- Modal Body (2 Columns: Preview vs Settings) -->
                                        <Grid Grid.Row="1" Margin="16,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left: Live Single Photo Preview & File Size Meter -->
                                            <Border Grid.Column="0" Background="#0C0D16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,14,0">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Single Photo Preview -->
                                                    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="3" BorderBrush="#888888" BorderThickness="1" 
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="2">
                                                        <Image Source="{Binding SingleExportPreviewImage}" MaxWidth="190" MaxHeight="240" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>

                                                    <!-- File Size Status Pill -->
                                                    <Border Grid.Row="1" Margin="0,10,0,0" Background="#181A2A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                                        <TextBlock Text="{Binding SingleExportStatusText}" FontSize="11" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Right: Govt Presets, Size Clamping, and Name/Date Stamp -->
                                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                                <StackPanel>
                                                    <!-- Presets Selector -->
                                                    <TextBlock Text="Select Government / Portal Preset:" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                                                    
                                                    <!-- Quick Preset Shortcut Buttons -->
                                                    <WrapPanel Margin="0,0,0,6">
                                                        <Button Content="💳 PAN Card (2.5×3.5 cm)" Command="{Binding SelectSinglePresetCommand}" CommandParameter="1" Style="{StaticResource OutlineButton}" Padding="8,3" Margin="0,0,4,4" FontSize="11" FontWeight="Bold" ToolTip="Official NSDL / UTI PAN Photo (2.5×3.5 cm, 200 DPI, &lt;50 KB)"/>
                                                        <Button Content="🏛️ SSC / UPSC (3.5×4.5 cm)" Command="{Binding SelectSinglePresetCommand}" CommandParameter="0" Style="{StaticResource OutlineButton}" Padding="8,3" Margin="0,0,4,4" FontSize="11" ToolTip="Standard Indian Exam (3.5×4.5 cm, 20–50 KB)"/>
                                                        <Button Content="🌍 Passport Seva" Command="{Binding SelectSinglePresetCommand}" CommandParameter="2" Style="{StaticResource OutlineButton}" Padding="8,3" Margin="0,0,4,4" FontSize="11" ToolTip="Passport Seva (50–100 KB)"/>
                                                        <Button Content="🛂 Visa (5×5 cm)" Command="{Binding SelectSinglePresetCommand}" CommandParameter="3" Style="{StaticResource OutlineButton}" Padding="8,3" Margin="0,0,0,4" FontSize="11" ToolTip="US / Schengen Visa"/>
                                                    </WrapPanel>

                                                    <ComboBox ItemsSource="{Binding SinglePresets}" SelectedIndex="{Binding SingleExportPresetIndex}" Height="32" Margin="0,0,0,12" FontSize="11.5"/>

                                                    <!-- Dimensions & KB Limits -->
                                                    <GroupBox Header="Dimensions &amp; File Size (KB) Limits" Margin="0,0,0,10">
                                                        <Grid Margin="4,6">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Width & Height -->
                                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                                                <TextBlock Text="Width (cm):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                <TextBox Text="{Binding SingleWidthCmText, UpdateSourceTrigger=PropertyChanged}" LostFocus="PassportDimensionTextBox_LostFocus" Height="28" VerticalContentAlignment="Center" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                                                <TextBlock Text="Height (cm):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                <TextBox Text="{Binding SingleHeightCmText, UpdateSourceTrigger=PropertyChanged}" LostFocus="PassportDimensionTextBox_LostFocus" Height="28" VerticalContentAlignment="Center" Margin="0,2,0,0"/>
                                                            </StackPanel>

                                                            <!-- Min KB & Max KB -->
                                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                                                                <TextBlock Text="Min File Size (KB):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                <TextBox Text="{Binding SingleMinKbText, UpdateSourceTrigger=PropertyChanged}" LostFocus="PassportSingleKbTextBox_LostFocus" Height="28" VerticalContentAlignment="Center" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                                                <TextBlock Text="Max File Size (KB):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                <TextBox Text="{Binding SingleMaxKbText, UpdateSourceTrigger=PropertyChanged}" LostFocus="PassportSingleKbTextBox_LostFocus" Height="28" VerticalContentAlignment="Center" Margin="0,2,0,0"/>
                                                            </StackPanel>

                                                            <!-- Resolution (DPI) -->
                                                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                                                <TextBlock Text="Resolution / Print Quality (DPI):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                <ComboBox ItemsSource="{Binding SingleDpiOptions}" SelectedItem="{Binding SingleDpi}" Height="28" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </GroupBox>

                                                    <!-- Candidate Name & Date of Photo (DOP) Stamp -->
                                                    <GroupBox Header="Candidate Name &amp; Date Stamp (Optional)" Margin="0,0,0,6">
                                                        <StackPanel Margin="4,6">
                                                            <CheckBox Content="Add Name &amp; Date of Photo (DOP) Banner" IsChecked="{Binding SingleAddStamp}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                            
                                                            <Grid Visibility="{Binding SingleAddStamp, Converter={StaticResource BoolToVis}}">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,6">
                                                                    <TextBlock Text="Candidate Full Name (in CAPITAL):" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                    <TextBox Text="{Binding SingleCandidateName, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" Margin="0,2,0,0"/>
                                                                </StackPanel>

                                                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                                                                    <TextBlock Text="Date of Photo (e.g. 21-09-2026):" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                    <TextBox Text="{Binding SingleDateOfPhoto, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </GroupBox>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>

                                        <!-- Modal Action Footer -->
                                        <Border Grid.Row="2" Background="#141724" Padding="16,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Button Content="✕ Cancel" Command="{Binding CloseSingleExportCommand}" Style="{StaticResource OutlineButton}" Height="34" Padding="16,0" HorizontalAlignment="Left"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="📋 Copy Image" Command="{Binding CopySinglePhotoCommand}" Style="{StaticResource OutlineButton}" Height="34" Padding="14,0" Margin="0,0,8,0" ToolTip="Copy single photo to clipboard for quick pasting"/>
                                                    <Button Content="💾 Save Single Photo (JPG)" Command="{Binding SaveSinglePhotoCommand}" Style="{StaticResource AccentButton}" Height="34" Padding="18,0" FontWeight="Bold" ToolTip="Save ready-to-upload JPEG file"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- TAB 14: A4 DOCUMENT & ID CARD STACKER EMBEDDED VIEW -->
                    <Grid Visibility="{Binding DataContext.IsStackerTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" 
                          DataContext="{Binding StackerVm}" Style="{StaticResource ContentFadeStyle}"
                          AllowDrop="True" Drop="StackerTab_Drop" DragOver="StackerTab_DragOver">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- Header -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Main Studio Scrollable Content -->
                                    <RowDefinition Height="*"/>
                                    <!-- Bottom Action Bar -->
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header Action Bar -->
                                <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="🖨️" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="A4 Document &amp; ID Card Stacker (2-in-1 Direct Print)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Stack Front &amp; Back ID cards (Aadhaar, Voter, PAN, Driving Licence) or multiple bills onto a single A4 page with fold line and zero paper wastage." 
                                                       FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="⚡ Auto-Paste Next" Command="{Binding PasteAutoClipboardCommand}" Style="{StaticResource AccentButton}" Padding="12,6" Margin="0,0,8,0" FontWeight="Bold" ToolTip="Paste image from clipboard directly into Front or Back"/>
                                            <Button Content="💳 Multi-Card Govt Print" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="9" Style="{StaticResource OutlineButton}" Padding="12,6" Margin="0,0,8,0" FontWeight="Bold"/>
                                            <Button Content="↗️ Open in New Window" Command="{Binding DataContext.OpenStackerCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource OutlineButton}" Padding="12,6" FontWeight="Bold" ToolTip="Pop out into a standalone resizable window"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 2-Column Content Area -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <!-- Left: Controls & File Slots -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Right: A4 Sheet Preview -->
                                        <ColumnDefinition Width="300"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Controls ScrollViewer -->
                                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                                        <StackPanel>
                                            <!-- Card Sizing Presets & Auto-Whiten -->
                                            <GroupBox Header="1. Print Layout &amp; Card Size Sizing" Margin="0,0,0,10">
                                                <StackPanel Margin="0,4">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <RadioButton GroupName="EmbedStackerLayoutGroup" Content="🪪 Pocket ID Card (8.5 × 5.5 cm)" IsChecked="{Binding IsStandardIdCard}" FontWeight="SemiBold" Margin="0,0,14,0" ToolTip="Exact 8.5cm length x 5.5cm width Indian standard ID card for wallet cutting and lamination"/>
                                                        <RadioButton GroupName="EmbedStackerLayoutGroup" Content="📜 Large Half-A4 (Full Half Page)" IsChecked="{Binding IsHalfA4}" FontWeight="SemiBold" Margin="0,0,14,0" ToolTip="Enlarges card across top or bottom half of A4 for clear readability on official bank &amp; job application forms"/>
                                                        <RadioButton GroupName="EmbedStackerLayoutGroup" Content="📄 Full A4 Entire Page" IsChecked="{Binding IsFullA4Sheet}" ToolTip="Fits a single document or scanned sheet across the entire A4 paper"/>
                                                    </StackPanel>

                                                    <WrapPanel Margin="0,2,0,0">
                                                        <CheckBox Content="✨ 1-Click Auto Clean &amp; Whiten Paper" 
                                                                  IsChecked="{Binding AutoWhiten}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,16,4"
                                                                  ToolTip="Adaptive shadow removal and paper whitening to pure white #FFFFFF while preserving color stamps &amp; photos"/>
                                                        <CheckBox Content="🖤 Pitch Black Text Boost (Faded Docs &amp; Xerox)" 
                                                                  IsChecked="{Binding PitchBlackText}" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,16,4"
                                                                  ToolTip="Transforms faded, gray, low-contrast text into rich deep pitch black while making paper pure white"/>
                                                        <CheckBox Content="🔒 Same Size for Both Cards" 
                                                                  IsChecked="{Binding SameSizeBothCards}" Visibility="{Binding IsStandardIdCard, Converter={StaticResource BoolToVis}}"
                                                                  FontWeight="SemiBold" Margin="0,0,16,4" ToolTip="Locks front and back cards to identical physical dimensions"/>
                                                    </WrapPanel>

                                                    <!-- 1-Click Clean & Whiten Presets -->
                                                    <Border Background="#161B26" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,2,0,4">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Clean Preset:" FontWeight="SemiBold" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                            <RadioButton GroupName="EmbedEnhancementGroup" Content="📷 Original" IsChecked="{Binding IsPresetOriginal}" FontWeight="SemiBold" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                            <RadioButton GroupName="EmbedEnhancementGroup" Content="Light (Soft)" IsChecked="{Binding IsPresetLight}" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                            <RadioButton GroupName="EmbedEnhancementGroup" Content="Balanced (Default)" IsChecked="{Binding IsPresetBalanced}" FontWeight="SemiBold" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                            <RadioButton GroupName="EmbedEnhancementGroup" Content="Strong (Xerox)" IsChecked="{Binding IsPresetStrong}" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </GroupBox>

                                            <!-- Add Documents Section -->
                                            <GroupBox Header="2. Select / Paste Document or Card Images" Margin="0,0,0,10">
                                                <StackPanel Margin="0,4">
                                                    <!-- Auto-Crop On Import Option -->
                                                    <CheckBox Content="🤖 Auto-Crop ID Card from Smartphone Photos (on Paste / Select)" 
                                                              IsChecked="{Binding AutoCropOnImport}" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,8" 
                                                              ToolTip="Automatically detects card boundaries in camera photos and crops/rotates them to standard ID card on-device."/>

                                                    <!-- Quick Batch Selection & Swap Action Bar -->
                                                    <Grid Margin="0,0,0,8" Visibility="{Binding IsBackSlotVisible, Converter={StaticResource BoolToVis}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0" Content="📁 Select 2 Files from Folder..." Command="{Binding SelectBothFilesCommand}" 
                                                                Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                                                        <Button Grid.Column="1" Content="⇅ Swap Top/Bottom" Command="{Binding SwapFilesCommand}" 
                                                                Width="130" Margin="0,0,6,0"/>
                                                        <Button Grid.Column="2" Content="📄 2-Page PDF" Command="{Binding ImportPdfCommand}" 
                                                                Width="100"/>
                                                    </Grid>

                                                    <!-- Front slot label -->
                                                    <TextBlock Text="{Binding Slot1Label}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,4"/>

                                                    <!-- Front slot row -->
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding FrontPath, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,0,6,0" Tag="Front side image or PDF"/>
                                                        <Button Grid.Column="1" Content="📋 Paste File" Command="{Binding PasteFrontClipboardCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,4,0" Padding="8,4"/>
                                                        <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseFrontCommand}" Width="65" Margin="0,0,4,0"/>
                                                        <Button Grid.Column="3" Content="✂️ Auto" Command="{Binding AutoCropFrontCommand}" IsEnabled="{Binding HasFront}" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Padding="6,4"/>
                                                        <Button Grid.Column="4" Content="↷ Rotate" Command="{Binding RotateFrontCommand}" IsEnabled="{Binding HasFront}" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Padding="6,4"/>
                                                        <Button Grid.Column="5" Content="✏️ Crop" Command="{Binding OpenCropFrontCommand}" IsEnabled="{Binding HasFront}" Margin="0,0,4,0" Padding="6,4"/>
                                                        <Button Grid.Column="6" Content="📱 WhatsApp Fix" Command="{Binding WhatsAppFixerFrontCommand}" IsEnabled="{Binding HasFront}" Style="{StaticResource AccentButton}" Margin="0,0,4,0" Padding="6,4"/>
                                                        <Button Grid.Column="7" Content="✕" Command="{Binding ClearFrontCommand}" Width="28"/>
                                                    </Grid>

                                                    <!-- Back slot row (hidden in Full A4 mode) -->
                                                    <Grid Margin="0,2,0,4" Visibility="{Binding IsBackSlotVisible, Converter={StaticResource BoolToVis}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding BackPath, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,0,6,0" Tag="Back side image or PDF"/>
                                                        <Button Grid.Column="1" Content="📋 Paste Back" Command="{Binding PasteBackClipboardCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,4,0" Padding="8,4"/>
                                                        <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseBackCommand}" Width="65" Margin="0,0,4,0"/>
                                                        <Button Grid.Column="3" Content="✂️ Auto" Command="{Binding AutoCropBackCommand}" IsEnabled="{Binding HasBack}" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Padding="6,4"/>
                                                        <Button Grid.Column="4" Content="↷ Rotate" Command="{Binding RotateBackCommand}" IsEnabled="{Binding HasBack}" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Padding="6,4"/>
                                                        <Button Grid.Column="5" Content="✏️ Crop" Command="{Binding OpenCropBackCommand}" IsEnabled="{Binding HasBack}" Margin="0,0,4,0" Padding="6,4"/>
                                                        <Button Grid.Column="6" Content="📱 WhatsApp Fix" Command="{Binding WhatsAppFixerBackCommand}" IsEnabled="{Binding HasBack}" Style="{StaticResource AccentButton}" Margin="0,0,4,0" Padding="6,4"/>
                                                        <Button Grid.Column="7" Content="✕" Command="{Binding ClearBackCommand}" Width="28"/>
                                                    </Grid>
                                                </StackPanel>
                                            </GroupBox>

                                            <!-- Sizing Indicators & Badge -->
                                            <Border Background="#161B26" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,4" HorizontalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PreviewModeBadgeText}" FontWeight="SemiBold" FontSize="11.5" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <Button Content="🔍 Switch to Large Half-A4" Command="{Binding SwitchToLargeHalfA4Command}" Visibility="{Binding IsStandardIdCard, Converter={StaticResource BoolToVis}}"
                                                            Padding="8,3" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#38BDF8" BorderThickness="1" FontWeight="Bold" Cursor="Hand"/>
                                                    <Button Content="🪪 Switch to Pocket ID (8.5cm)" Command="{Binding SwitchToPocketIdCommand}" Visibility="{Binding IsHalfA4, Converter={StaticResource BoolToVis}}"
                                                            Padding="8,3" Background="#1E293B" Foreground="#10B981" BorderBrush="#10B981" BorderThickness="1" FontWeight="Bold" Cursor="Hand"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Result Status Text -->
                                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="10" Margin="0,6,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    Visibility="{Binding ResultText, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- Right: A4 Sheet Preview -->
                                    <Border Grid.Column="1" Background="#0C0D16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" VerticalAlignment="Top">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="A4 Print Sheet Preview" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                            
                                            <!-- A4 Sheet Container -->
                                            <Border Width="220" Height="310" Background="#FFFFFF" CornerRadius="3" BorderBrush="#94A3B8" BorderThickness="2" HorizontalAlignment="Center">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.4"/>
                                                </Border.Effect>
                                                <Grid>
                                                    <!-- ID Card Two Slots -->
                                                    <Grid Visibility="{Binding IsBackSlotVisible, Converter={StaticResource BoolToVis}}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Front Slot -->
                                                        <Grid Grid.Row="0" Margin="8,8,8,4" Background="#F8FAFC">
                                                            <Border Width="{Binding FrontSlotWidth}" Height="{Binding FrontSlotHeight}" 
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    BorderBrush="{Binding FrontSlotBorderBrush}" BorderThickness="{Binding FrontSlotBorderThickness}">
                                                                <Grid>
                                                                    <Image Source="{Binding FrontImageSource}" Stretch="Uniform" Margin="1" Visibility="{Binding FrontPreviewVisibility}"/>
                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding FrontPlaceholderVisibility}">
                                                                        <TextBlock Text="FRONT SIDE" FontSize="9" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Dashed Line -->
                                                        <Line Grid.Row="1" X1="10" Y1="0" X2="210" Y2="0" Stroke="#94A3B8" StrokeThickness="1" StrokeDashArray="4 2"/>

                                                        <!-- Back Slot -->
                                                        <Grid Grid.Row="2" Margin="8,4,8,8" Background="#F8FAFC">
                                                            <Border Width="{Binding BackSlotWidth}" Height="{Binding BackSlotHeight}" 
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    BorderBrush="{Binding BackSlotBorderBrush}" BorderThickness="{Binding BackSlotBorderThickness}">
                                                                <Grid>
                                                                    <Image Source="{Binding BackImageSource}" Stretch="Uniform" Margin="1" Visibility="{Binding BackPreviewVisibility}"/>
                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding BackPlaceholderVisibility}">
                                                                        <TextBlock Text="BACK SIDE" FontSize="9" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </Grid>

                                                    <!-- Full A4 Single Slot -->
                                                    <Grid Margin="8" Background="#F8FAFC" Visibility="{Binding IsFullA4Sheet, Converter={StaticResource BoolToVis}}">
                                                        <Image Source="{Binding FrontImageSource}" Stretch="Uniform" Margin="2" Visibility="{Binding FrontPreviewVisibility}"/>
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding FrontPlaceholderVisibility}">
                                                            <TextBlock Text="FULL A4 DOCUMENT" FontSize="10" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Bottom Action Bar -->
                                <Border Grid.Row="2" Margin="0,12,0,0" Padding="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="💾 Save A4 File" Style="{StaticResource SecondaryButton}" Command="{Binding StackCommand}" Padding="16,8" Margin="0,0,8,0"/>
                                            <Button Content="🖨️ Print A4 Document" Style="{StaticResource AccentButton}" Command="{Binding PrintNowCommand}" Padding="20,8" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- TAB 15: EXCEL A4 SMART PRINTER EMBEDDED VIEW / LAUNCHER -->
                    <Grid Visibility="{Binding DataContext.IsExcelPrinterTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" Style="{StaticResource ContentFadeStyle}"
                          AllowDrop="True" Drop="ExcelTab_Drop" DragOver="ExcelTab_DragOver">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Studio Header Banner -->
                                <Grid Grid.Row="0" Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="📊" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Excel A4 Smart Printer &amp; Table Organizer" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Zero table cut-offs, frozen headers repeated on every page, auto-fit columns, and edge-to-edge A4 printing for spreadsheets, student lists, GST bills, and attendance registers." 
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="750"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="🚀 Launch Full Studio Window" Style="{StaticResource PrimaryButton}" Command="{Binding OpenExcelPrintStudioCommand}" Padding="18,10" VerticalAlignment="Center" FontWeight="Bold"/>
                                </Grid>

                                <!-- Quick Info Cards -->
                                <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
                                    <Border Background="#141520" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="ZERO CUT-OFF AUTO-FIT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="Smart Column Shrink &amp; Wrap" FontSize="14" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                                            <TextBlock Text="Fits 10–30+ columns cleanly without splitting tables" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#141520" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="4,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="FROZEN HEADERS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="Repeats Title on Every Page" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
                                            <TextBlock Text="Header row locks to top of all multi-page prints" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#141520" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="EDGE-TO-EDGE MARGINS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="100% Printable Paper Space" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0"/>
                                            <TextBlock Text="Eliminates giant default Excel white margins" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Launch Studio Hero CTA & Dropzone -->
                                <Border Grid.Row="2" Background="#141520" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="30">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📈" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                        <TextBlock Text="Open Excel A4 Smart Printer Studio Workspace" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="Drag and drop any .xlsx, .xls, or .csv file anywhere on this screen, or click below to launch the dedicated studio." 
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="600" TextAlignment="Center" Margin="0,0,0,20"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="📂 Browse Excel File..." Command="{Binding SelectToolFileCommand}" CommandParameter="excel" Style="{StaticResource OutlineButton}" Padding="18,12" FontSize="13" FontWeight="Bold" Margin="0,0,10,0"/>
                                            <Button Content="⚡ Open Dedicated Studio Window" Style="{StaticResource PrimaryButton}" Command="{Binding OpenExcelPrintStudioCommand}" Padding="24,12" FontSize="14" FontWeight="Bold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- TAB 16: PDF EDITOR STUDIO EMBEDDED VIEW / LAUNCHER -->
                    <Grid Visibility="{Binding DataContext.IsPdfEditorTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" Style="{StaticResource ContentFadeStyle}"
                          AllowDrop="True" Drop="PdfEditorTab_Drop" DragOver="PdfEditorTab_DragOver">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Studio Header Banner -->
                                <Grid Grid.Row="0" Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="📝" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="PDF Editor Studio (In-Place Edit, Erase &amp; Vector Text)" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Direct in-place PDF modification: whiteout typographical errors, retype text with matching fonts, insert photos, apply transparent client signatures and official stamps, and reorder pages." 
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="750"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="🚀 Launch Full Studio Window" Style="{StaticResource PrimaryButton}" Command="{Binding OpenPdfEditorCommand}" Padding="18,10" VerticalAlignment="Center" FontWeight="Bold"/>
                                </Grid>

                                <!-- Quick Info Cards -->
                                <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
                                    <Border Background="#141520" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="IN-PLACE EDIT &amp; WHITEOUT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="Erase &amp; Retype Text" FontSize="14" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                                            <TextBlock Text="Clean whiteout tool with pixel-perfect vector overlay" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#141520" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="4,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="SIGNATURES &amp; STAMPS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="Sign &amp; Stamp Documents" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
                                            <TextBlock Text="Drag and place transparent signature PNGs anywhere" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#141520" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="PAGE ORGANIZER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="Re-order, Rotate &amp; Delete" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0"/>
                                            <TextBlock Text="Reorganize PDF pages without quality degradation" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Launch Studio Hero CTA & Dropzone -->
                                <Border Grid.Row="2" Background="#141520" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="30">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📝" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                        <TextBlock Text="Open PDF Editor Studio Workspace" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="Drag and drop any .pdf file anywhere on this screen, or click below to launch the dedicated editor." 
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="600" TextAlignment="Center" Margin="0,0,0,20"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="📂 Browse PDF File..." Command="{Binding SelectToolFileCommand}" CommandParameter="pdfeditor" Style="{StaticResource OutlineButton}" Padding="18,12" FontSize="13" FontWeight="Bold" Margin="0,0,10,0"/>
                                            <Button Content="⚡ Open Dedicated Studio Window" Style="{StaticResource PrimaryButton}" Command="{Binding OpenPdfEditorCommand}" Padding="24,12" FontSize="14" FontWeight="Bold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
