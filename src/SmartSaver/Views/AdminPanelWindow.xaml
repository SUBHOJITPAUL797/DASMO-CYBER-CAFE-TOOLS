<Window x:Class="SmartSaver.Views.AdminPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DASMO Cloud Licensing &amp; Device Control Center — Subhojit Paul"
        Width="1050" Height="680"
        MinWidth="850" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Windows Standard Caption Button Styles -->
        <Style x:Key="WinCaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2A2D45"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#383C5C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCaptionCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#B80F1D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#12131C" CornerRadius="10" BorderBrush="#25273B" BorderThickness="1.5" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/> <!-- Full-Width Title Bar (Edge-to-Edge) -->
                <RowDefinition Height="*"/>  <!-- Main Body -->
            </Grid.RowDefinitions>

            <!-- 1. TOP TITLE BAR (Edge-to-Edge with Native Windows Controls) -->
            <Grid Grid.Row="0" Background="#161826" MouseDown="TitleBar_MouseDown">
                <Border BorderThickness="0,0,0,1" BorderBrush="#26283D"/>

                <!-- Left: Title & Branding -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="🛡️" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="DASMO MASTER CLOUD SECURITY DASHBOARD" FontSize="12" FontWeight="Bold" Foreground="#00BCD4" VerticalAlignment="Center"/>
                    <TextBlock Text="— Cloud Licensing &amp; Hardware Lock Control" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Right: Standard Windows Window Caption Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                    <!-- Minimize Button -->
                    <Button x:Name="BtnMinimize" Style="{StaticResource WinCaptionButtonStyle}" Click="Minimize_Click" ToolTip="Minimize">
                        <Rectangle Width="12" Height="2" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <!-- Maximize / Restore Button -->
                    <Button x:Name="BtnMaximize" Style="{StaticResource WinCaptionButtonStyle}" Click="Maximize_Click" ToolTip="Maximize">
                        <Grid Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border x:Name="IconMax" Width="11" Height="11" BorderThickness="1.5" BorderBrush="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                            <Canvas x:Name="IconRestore" Width="11" Height="11" Visibility="Collapsed">
                                <Path Data="M3,0 L11,0 L11,8 L8,8 L8,3 L3,3 Z" Fill="Transparent" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.2"/>
                                <Path Data="M0,3 L8,3 L8,11 L0,11 Z" Fill="#161826" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.2"/>
                            </Canvas>
                        </Grid>
                    </Button>

                    <!-- Close Button -->
                    <Button x:Name="BtnClose" Style="{StaticResource WinCaptionCloseButtonStyle}" Click="Close_Click" ToolTip="Close">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. BODY CONTENT AREA -->
            <Grid Grid.Row="1" Margin="20,10,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header & App Tabs -->
                    <RowDefinition Height="Auto"/> <!-- Stats Bar & Search -->
                    <RowDefinition Height="*"/>    <!-- User Table -->
                    <RowDefinition Height="Auto"/> <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- Header & App Collection Tabs -->
                <Grid Grid.Row="0" Margin="0,4,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="User License &amp; Physical Hardware Lock Control" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Administrator: subhojitpaul26042004@gmail.com • Multi-App Cloud Authority" FontSize="12" Foreground="#8F9CAE" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Software Collection Switcher -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="TabPc" Content="💻 PC Suite" IsChecked="True" Checked="CollectionTab_Checked"
                                 Style="{StaticResource {x:Type ToggleButton}}" Margin="0,0,6,0" Padding="12,6"
                                 Background="#1E2033" Foreground="#FFFFFF" BorderBrush="#00BCD4" Cursor="Hand"/>
                    <RadioButton x:Name="TabCapture" Content="📱 Cyber Capture" Checked="CollectionTab_Checked"
                                 Style="{StaticResource {x:Type ToggleButton}}" Margin="0,0,6,0" Padding="12,6"
                                 Background="#1E2033" Foreground="#CBD5E1" Cursor="Hand"/>
                    <RadioButton x:Name="TabScanner" Content="📄 Dasmo Scanner" Checked="CollectionTab_Checked"
                                 Style="{StaticResource {x:Type ToggleButton}}" Margin="0,0,6,0" Padding="12,6"
                                 Background="#1E2033" Foreground="#CBD5E1" Cursor="Hand"/>
                    <RadioButton x:Name="TabPhoto" Content="🖨️ Photo Print" Checked="CollectionTab_Checked"
                                 Style="{StaticResource {x:Type ToggleButton}}" Padding="12,6"
                                 Background="#1E2033" Foreground="#CBD5E1" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- Stats Bar & Search Controls -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Pre-Approve Action -->
                    <Button Content="➕ Pre-Approve Email" Click="OpenPreApprove_Click"
                            Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,6" Margin="0,0,10,0" Cursor="Hand" BorderThickness="0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <!-- Version Policy Action -->
                    <Button Content="🚀 Version &amp; Updates" Click="OpenVersionPolicy_Click"
                            Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,6" Margin="0,0,10,0" Cursor="Hand" BorderThickness="0"
                            ToolTip="Manage minimum required versions, block old versions, and broadcast custom update notices">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <!-- Registration Gate Mode Switch -->
                    <Border Background="#1A2035" CornerRadius="6" Padding="10,4" Margin="0,0,12,0" BorderBrush="#10B981" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Registration Gate: " FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <Border x:Name="BadgeGateMode" CornerRadius="4" Padding="6,2" Margin="4,0,8,0" Background="#132A22">
                                <TextBlock x:Name="TxtGateMode" Text="⚡ OPEN (Instant Direct Login)" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                            </Border>
                            <Button x:Name="BtnToggleGate" Content="🔒 Switch to Gated Mode" Click="ToggleGate_Click"
                                    Background="#D97706" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" Padding="8,3" Cursor="Hand" BorderThickness="0"
                                    ToolTip="Toggle between Gated Mode (Admin Approval) and Open Mode (Instant Direct Entry)">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Background="#1C1E2E" CornerRadius="6" Padding="8,6" Margin="0,0,6,0">
                        <TextBlock x:Name="TxtTotalUsers" Text="Total: 0" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                    </Border>
                    <Border Background="#132A22" CornerRadius="6" Padding="8,6" Margin="0,0,6,0">
                        <TextBlock x:Name="TxtApprovedUsers" Text="Approved: 0" FontSize="11" FontWeight="SemiBold" Foreground="#10B981"/>
                    </Border>
                    <Border Background="#2B2114" CornerRadius="6" Padding="8,6" Margin="0,0,6,0">
                        <TextBlock x:Name="TxtPendingUsers" Text="Pending: 0" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B"/>
                    </Border>
                    <Border Background="#2B161B" CornerRadius="6" Padding="8,6">
                        <TextBlock x:Name="TxtBannedUsers" Text="Banned: 0" FontSize="11" FontWeight="SemiBold" Foreground="#EF4444"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="TxtSearch" Width="200" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                             Background="#1A1C2B" Foreground="#FFFFFF" BorderBrush="#2F324D" BorderThickness="1"
                             TextChanged="TxtSearch_TextChanged" Margin="0,0,8,0">
                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                    </TextBox>
                    <Button Content="🔄 Refresh" Click="Refresh_Click" Height="34" Padding="12,0"
                            Background="#00BCD4" Foreground="#0F172A" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Users DataGrid -->
            <Border Grid.Row="2" Background="#161826" CornerRadius="8" BorderBrush="#25273B" BorderThickness="1">
                <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="Transparent" RowBackground="#161826" AlternatingRowBackground="#1A1C2C"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#222436"
                          Foreground="#E2E8F0" BorderThickness="0" FontSize="12" RowHeight="44">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1E2033"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Height" Value="34"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="8,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <!-- Full Name -->
                        <DataGridTextColumn Header="Full Name" Binding="{Binding Name}" Width="130" FontWeight="SemiBold"/>

                        <!-- Email -->
                        <DataGridTextColumn Header="User Email" Binding="{Binding Email}" Width="180"/>

                        <!-- Device Model / PC Name -->
                        <DataGridTextColumn Header="Hardware / PC Model" Binding="{Binding DeviceModel}" Width="140"/>

                        <!-- Hardware ID -->
                        <DataGridTextColumn Header="Bound Hardware ID" Binding="{Binding DeviceId}" Width="140"/>

                        <!-- Status Badge -->
                        <DataGridTemplateColumn Header="Status" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                            Background="{Binding StatusBg}">
                                        <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="10" Foreground="{Binding StatusFg}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- App Version Badge -->
                        <DataGridTemplateColumn Header="Version" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                            Background="{Binding VersionBg}">
                                        <TextBlock Text="{Binding AppVersionDisplay}" FontWeight="Bold" FontSize="10" Foreground="{Binding VersionFg}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Expiry -->
                        <DataGridTextColumn Header="Plan Duration" Binding="{Binding ExpiryDisplay}" Width="90"/>

                        <!-- Management Actions -->
                        <DataGridTemplateColumn Header="Admin Controls" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Approve -->
                                        <Button Content="✅ Approve" Click="ApproveUser_Click"
                                                Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" Padding="6,4" Margin="0,0,4,0" FontSize="10" Cursor="Hand" BorderThickness="0">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>
                                        <!-- Pending -->
                                        <Button Content="⏳ Pending" Click="PendingUser_Click"
                                                Background="#D97706" Foreground="#FFFFFF" Padding="6,4" Margin="0,0,4,0" FontSize="10" Cursor="Hand" BorderThickness="0">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>
                                        <!-- Ban -->
                                        <Button Content="🚫 Ban" Click="BanUser_Click"
                                                Background="#DC2626" Foreground="#FFFFFF" Padding="6,4" Margin="0,0,4,0" FontSize="10" Cursor="Hand" BorderThickness="0">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>
                                        <!-- Unbind Device -->
                                        <Button Content="🔓 Unbind" Click="UnbindDevice_Click"
                                                Background="#475569" Foreground="#FFFFFF" Padding="6,4" Margin="0,0,4,0" FontSize="10" Cursor="Hand" BorderThickness="0"
                                                ToolTip="Resets bound physical hardware so user can register on a new PC">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>
                                        <!-- Lifetime -->
                                        <Button Content="♾️ Life" Click="SetLifetime_Click"
                                                Background="#2563EB" Foreground="#FFFFFF" Padding="6,4" Margin="0,0,4,0" FontSize="10" Cursor="Hand" BorderThickness="0">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>
                                        <!-- View PC Specs -->
                                        <Button Content="🔍 Specs" Click="ViewSpecs_Click"
                                                Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="6,4" Margin="0,0,4,0" FontSize="10" Cursor="Hand" BorderThickness="0"
                                                ToolTip="View complete computer specifications (RAM, CPU, OS Build, Motherboard, etc.)">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>
                                        <!-- Delete User -->
                                        <Button Content="🗑️" Click="DeleteUser_Click"
                                                Background="#7F1D1D" Foreground="#FCA5A5" Padding="6,4" FontSize="10" Cursor="Hand" BorderThickness="0"
                                                ToolTip="Permanently delete user record from cloud">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Footer -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <TextBlock Text="• Unbinding device allows the user to run on a new computer without creating a new account." FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                <TextBlock Text="DASMO Cyber Cloud • subhojitpaul26042004@gmail.com" FontSize="11" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- MODAL OVERLAY: PRE-APPROVE USER                           -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border x:Name="OverlayPreApprove" Visibility="Collapsed" Background="#E00B0D14"
                Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border Background="#161826" CornerRadius="12" BorderBrush="#00BCD4" BorderThickness="1.5"
                        Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                    <StackPanel>
                        <TextBlock Text="➕ Pre-Approve New User Email" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Pre-approving creates an authorized license. When the user logs in from their PC, hardware is bound automatically and they enter the software instantly."
                                   FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,6,0,16"/>

                        <TextBlock Text="User Full Name:" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPreApproveName" Height="36" FontSize="13" VerticalContentAlignment="Center" Padding="10,0"
                                 Background="#1F2236" Foreground="#FFFFFF" BorderBrush="#3B3E60" BorderThickness="1" Margin="0,0,0,12">
                            <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                        </TextBox>

                        <TextBlock Text="User Email Address:" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPreApproveEmail" Height="36" FontSize="13" VerticalContentAlignment="Center" Padding="10,0"
                                 Background="#1F2236" Foreground="#FFFFFF" BorderBrush="#3B3E60" BorderThickness="1" Margin="0,0,0,16">
                            <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                        </TextBox>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Click="CancelPreApprove_Click"
                                    Background="#334155" Foreground="#E2E8F0" Padding="14,8" Margin="0,0,10,0" Cursor="Hand" BorderThickness="0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                            <Button Content="✅ Pre-Approve User" Click="ConfirmPreApprove_Click"
                                    Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" Padding="16,8" Cursor="Hand" BorderThickness="0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- MODAL OVERLAY: FULL COMPUTER HARDWARE DOSSIER             -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border x:Name="OverlaySpecs" Visibility="Collapsed" Background="#E00B0D14"
                    Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border Background="#161826" CornerRadius="12" BorderBrush="#00BCD4" BorderThickness="1.5"
                        Width="620" MaxHeight="600" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="🔍 Complete Computer &amp; Hardware Details" FontSize="16" FontWeight="Bold" Foreground="#00BCD4"/>
                                <TextBlock x:Name="TxtSpecsHeaderUser" Text="User: Name (email@domain.com)" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" Click="CloseSpecs_Click"
                                    Background="Transparent" Foreground="#A0A0C0" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                        </Grid>

                        <!-- Specs Body -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                            <StackPanel>
                                <!-- Hardware Security -->
                                <Border Background="#1C1E2F" CornerRadius="8" Padding="14,10" Margin="0,0,0,10" BorderBrush="#2A2C42" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="PHYSICAL HARDWARE IDENTIFIER" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                        <TextBlock x:Name="TxtSpecsHwId" Text="PC-XXXX-XXXX-XXXX-XXXX" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,4"/>
                                        <TextBlock x:Name="TxtSpecsModel" Text="Device Model: ..." FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>

                                <!-- Grid of Specifications -->
                                <Border Background="#1C1E2F" CornerRadius="8" Padding="14" BorderBrush="#2A2C42" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Full Name:" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,4"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtSpecsName" Text="—" Foreground="#FFFFFF" Margin="0,4"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Registered Email:" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,4"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtSpecsEmail" Text="—" Foreground="#FFFFFF" Margin="0,4"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Operating System:" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,4"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtSpecsOs" Text="—" Foreground="#FFFFFF" Margin="0,4"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Processor (CPU):" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,4"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtSpecsCpu" Text="—" Foreground="#FFFFFF" TextWrapping="Wrap" Margin="0,4"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Total RAM Memory:" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,4"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtSpecsRam" Text="—" Foreground="#FFFFFF" Margin="0,4"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Display Resolution:" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,4"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtSpecsScreen" Text="—" Foreground="#FFFFFF" Margin="0,4"/>

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Windows User / Machine:" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,4"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TxtSpecsWinUser" Text="—" Foreground="#FFFFFF" Margin="0,4"/>

                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Motherboard / BIOS:" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,4"/>
                                        <TextBlock Grid.Row="7" Grid.Column="1" x:Name="TxtSpecsMotherboard" Text="—" Foreground="#FFFFFF" TextWrapping="Wrap" Margin="0,4"/>

                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Network Local IP:" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,4"/>
                                        <TextBlock Grid.Row="8" Grid.Column="1" x:Name="TxtSpecsIp" Text="—" Foreground="#FFFFFF" Margin="0,4"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Footer Actions -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="📋 Copy All Specs" Click="CopySpecs_Click"
                                    Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="14,8" Margin="0,0,10,0" Cursor="Hand" BorderThickness="0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                            <Button Content="Close" Click="CloseSpecs_Click"
                                    Background="#334155" Foreground="#E2E8F0" Padding="14,8" Cursor="Hand" BorderThickness="0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- MODAL OVERLAY: SOFTWARE VERSION POLICY & FORCE UPDATE       -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border x:Name="OverlayVersionPolicy" Visibility="Collapsed" Background="#E00B0D14"
                    Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border Background="#161826" CornerRadius="12" BorderBrush="#00BCD4" BorderThickness="1.5"
                        Width="680" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="🚀 Software Version Policy &amp; Mandatory Update Control" FontSize="16" FontWeight="Bold" Foreground="#00BCD4"/>
                                <TextBlock Text="Manage version retirement, force mandatory client updates, and push custom announcements." FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" Click="CloseVersionPolicy_Click"
                                    Background="Transparent" Foreground="#A0A0C0" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                        </Grid>

                        <!-- Body -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                            <StackPanel>
                                <!-- Row 1: Versions -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Latest Public Release Version:" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtPolicyLatestVersion" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                                                 Background="#1A1C2B" Foreground="#FFFFFF" BorderBrush="#2F324D" BorderThickness="1"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Minimum Required Version (Retires older):" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtPolicyMinVersion" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                                                 Background="#1A1C2B" Foreground="#FFFFFF" BorderBrush="#2F324D" BorderThickness="1"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 2: Blocked Versions -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Explicitly Blocked Versions (comma-separated, e.g., 1.0.0, 1.1.0, 1.2.0):" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtPolicyBlockedVersions" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                                             Background="#1A1C2B" Foreground="#FFFFFF" BorderBrush="#2F324D" BorderThickness="1"/>
                                </StackPanel>

                                <!-- Row 3: Force Update Toggle -->
                                <Border Background="#1C1E2F" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" BorderBrush="#2A2C42" BorderThickness="1">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="🔒 Force Mandatory Lockout on Outdated PCs" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="When enabled, any PC running a version below Minimum or in Blocked list cannot access the software until updated." FontSize="10.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkPolicyForceUpdate" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True"/>
                                    </Grid>
                                </Border>

                                <!-- Row 4: Custom Admin Update Message -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Custom Update Announcement Message (Displayed to users on update screen):" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtPolicyCustomMessage" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="8,6"
                                             Background="#1A1C2B" Foreground="#FFFFFF" BorderBrush="#2F324D" BorderThickness="1"/>
                                </StackPanel>

                                <!-- Row 5: GitHub Repo & Download URL -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="GitHub Repository (owner/repo):" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtPolicyGithubRepo" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                                                 Background="#1A1C2B" Foreground="#FFFFFF" BorderBrush="#2F324D" BorderThickness="1"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Direct MSI Download URL (Optional Override):" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtPolicyDownloadUrl" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                                                 Background="#1A1C2B" Foreground="#FFFFFF" BorderBrush="#2F324D" BorderThickness="1"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 6: Changelog / Release Notes -->
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="Release Changelog / What's New Notes:" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtPolicyChangelog" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="8,6"
                                             Background="#1A1C2B" Foreground="#FFFFFF" BorderBrush="#2F324D" BorderThickness="1"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Footer Buttons -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="💾 Save &amp; Broadcast Version Policy" Click="SaveVersionPolicy_Click"
                                    Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="16,8" Margin="0,0,10,0" Cursor="Hand" BorderThickness="0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                            <Button Content="Cancel" Click="CloseVersionPolicy_Click"
                                    Background="#334155" Foreground="#E2E8F0" Padding="14,8" Cursor="Hand" BorderThickness="0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
