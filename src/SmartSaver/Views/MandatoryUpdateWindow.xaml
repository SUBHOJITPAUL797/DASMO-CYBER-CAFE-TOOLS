<Window x:Class="SmartSaver.Views.MandatoryUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mandatory Software Update Required — DASMO CYBER CAFE TOOLS"
        Width="580" Height="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#0B0D14"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#161826"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1C1E2F"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A2C42"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00BCD4"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1.5" CornerRadius="12" ClipToBounds="True">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title & Icon -->
                <RowDefinition Height="Auto"/> <!-- Version Badges & Admin Message -->
                <RowDefinition Height="*"/>    <!-- Changelog & Notes -->
                <RowDefinition Height="Auto"/> <!-- Progress / Action Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#261214" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1" Margin="0,0,14,0">
                    <TextBlock Text="🛑" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="SOFTWARE UPDATE REQUIRED" FontSize="16" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}"/>
                    <TextBlock Text="This version is no longer supported. Please update to continue." FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Exit / Close Button -->
                <Button Grid.Column="2" Content="✕" Width="28" Height="28" Background="Transparent" Foreground="#64748B" BorderThickness="0" FontSize="13" Cursor="Hand" Click="Exit_Click" ToolTip="Exit Application"/>
            </Grid>

            <!-- 2. Version Diff & Admin Notice -->
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <!-- Versions Pill -->
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Current Version -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="YOUR RUNNING VERSION" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtCurrentVersion" Text="v1.4.0 (Outdated)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Arrow -->
                        <TextBlock Grid.Column="1" Text="➔" FontSize="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="10,0"/>

                        <!-- Required Version -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="LATEST / MINIMUM REQUIRED" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtRequiredVersion" Text="v1.5.0+" FontSize="13" FontWeight="Bold" Foreground="#10B981" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Custom Admin Announcement -->
                <Border x:Name="BoxAdminMessage" Background="#1D1A22" CornerRadius="8" Padding="12,10" BorderBrush="#F59E0B" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📢 MESSAGE FROM ADMINISTRATOR (Subhojit Paul):" FontSize="10.5" FontWeight="Bold" Foreground="#F59E0B"/>
                        <TextBlock x:Name="TxtAdminMessage" Text="A critical update is required for continued operation and compatibility with government card processing." FontSize="11.5" Foreground="#F1F5F9" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 3. Changelog / What's New Box -->
            <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="✨ WHAT'S NEW IN THE LATEST RELEASE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtChangelog" Text="• High-speed document processing updates&#x0a;• Instant Aadhaar, PAN, and Ration card formatting&#x0a;• Performance and security enhancements&#x0a;• Critical bug fixes and cloud licensing updates"
                                   FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="18"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 4. Downloader Progress & Action Buttons -->
            <StackPanel Grid.Row="3">
                <!-- Live Progress Section (Visible during download) -->
                <StackPanel x:Name="PanelProgress" Visibility="Collapsed" Margin="0,0,0,12">
                    <Grid Margin="0,0,0,6">
                        <TextBlock x:Name="TxtProgressStatus" Text="Downloading update installer..." FontSize="11" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock x:Name="TxtProgressStats" Text="0.0 MB / 0.0 MB • 0.0 MB/s" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar x:Name="ProgressBarDownload" Height="8" Minimum="0" Maximum="100" Value="0"
                                 Foreground="{StaticResource AccentBrush}" Background="#1E2033" BorderThickness="0">
                        <ProgressBar.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                        </ProgressBar.Resources>
                    </ProgressBar>
                </StackPanel>

                <!-- Action Button -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnDownloadUpdate" Content="🚀 Download &amp; Install Update Now" Click="DownloadUpdate_Click"
                            Background="{StaticResource AccentBrush}" Foreground="#0F172A" FontWeight="Bold" FontSize="13"
                            Height="42" Cursor="Hand" BorderThickness="0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>

                    <Button x:Name="BtnCancelDownload" Content="Cancel" Click="CancelDownload_Click" Visibility="Collapsed"
                            Background="#334155" Foreground="#E2E8F0" Height="42" Padding="16,0" Margin="8,0,0,0" Cursor="Hand" BorderThickness="0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
