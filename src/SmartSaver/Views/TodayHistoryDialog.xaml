<Window x:Class="SmartSaver.Views.TodayHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmartSaver.Converters"
        Title="DASMO CYBER COMPRESSOR — Today's Output History" Height="580" Width="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="54"/>
            </Grid.RowDefinitions>

            <!-- Background Texture -->
            <Image Source="pack://application:,,,/Resources/background_photo.png" Stretch="UniformToFill" Opacity="0.30" IsHitTestVisible="False" Grid.RowSpan="4"/>

            <!-- Title Bar -->
            <Grid Background="{StaticResource SurfaceBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="⚡ " FontSize="14"/>
                    <TextBlock Text="DASMO CYBER COMPRESSOR — Output History Hub" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🗕" Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" ToolTip="Minimize"/>
                    <Button Content="✕" Style="{StaticResource TitleBarCloseButton}" Click="CloseButton_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- Top Filter & Stats Bar -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="15,10" Margin="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Filter Time:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding FilterTime}" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2" Text="{Binding TotalProcessedText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>

                    <Button Grid.Column="3" Content="🗑️ Clear History" Style="{StaticResource ChipButton}" Command="{Binding ClearHistoryCommand}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Records List -->
            <Grid Grid.Row="2" Margin="15,0,15,10">
                <ListBox ItemsSource="{Binding DisplayRecords}" SelectedItem="{Binding SelectedRecord}"
                         Background="#181926" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6" BorderBrush="#252636" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Operation Tag -->
                                    <Border Background="#2a2d42" CornerRadius="4" Padding="6,3" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Operation}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    </Border>

                                    <!-- File Name & Path -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FilePath}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Size -->
                                    <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>

                                    <!-- Time -->
                                    <TextBlock Grid.Column="3" Text="{Binding TimeFormatted}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                    <!-- Quick Resume Button for PDFs -->
                                    <Button Grid.Column="4" Content="{Binding ResumeButtonText}" Style="{StaticResource ChipButton}"
                                            Visibility="{Binding IsPdf, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.ResumeInEditorCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Background="#2E7D32" Foreground="White" Padding="8,2" Margin="10,0,0,0"
                                            ToolTip="Resume in PDF Editor Studio (restores any draft edits)"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Bottom Action Bar -->
            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="15,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="✏️ Resume in Editor" Style="{StaticResource ChipButton}" 
                                Command="{Binding ResumeInEditorCommand}" 
                                Background="#2E7D32" Foreground="White" Margin="0,0,8,0"
                                ToolTip="Resume selected PDF in PDF Editor Studio (restores any draft edits)"/>
                        <Button Content="📂 Open File" Style="{StaticResource ChipButton}" Command="{Binding OpenFileCommand}" Margin="0,0,8,0"/>
                        <Button Content="📁 Show in Folder" Style="{StaticResource ChipButton}" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0"/>
                        <Button Content="📋 Copy Path" Style="{StaticResource ChipButton}" Command="{Binding CopyPathCommand}"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="Close" Width="90" Style="{StaticResource PrimaryButton}" Command="{Binding CloseCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
