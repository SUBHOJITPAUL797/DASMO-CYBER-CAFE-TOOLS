<Window x:Class="SmartSaver.Views.SignatureResizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmartSaver.Converters"
        Title="DASMO CYBER CAFE TOOLS — Resize Signature (Pi7 Image Resizer)" Height="680" Width="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True"
        AllowDrop="True" Drop="Window_Drop">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanConverter x:Key="InverseBool"/>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- Window Title Bar -->
            <Grid Background="{StaticResource SurfaceBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="✍️ " FontSize="14"/>
                    <TextBlock Text="DASMO CYBER CAFE TOOLS — Resize Signature" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🗕" Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" ToolTip="Minimize"/>
                    <Button Content="✕" Style="{StaticResource TitleBarCloseButton}" Click="CloseButton_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,10">
                <StackPanel>
                    <!-- Drag & Drop / Select Images Box (Pi7 Style) -->
                    <Border Background="#12131D" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" CornerRadius="10" 
                            Padding="16" Margin="0,0,0,12" ToolTip="Drag and drop any signature or photo here">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Select Or Drag &amp; Drop Images Here" FontSize="13" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="📂 Select Images" Style="{StaticResource AccentButton}" Command="{Binding BrowseCommand}" 
                                        Padding="16,6" Margin="0,0,8,0" FontWeight="Bold"/>
                                <Button Content="📋 Paste Image" Style="{StaticResource SecondaryButton}" Command="{Binding PasteClipboardCommand}" 
                                        Padding="14,6" ToolTip="Paste image directly from clipboard (Ctrl+V)"/>
                            </StackPanel>

                            <!-- Selected File Info -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0" 
                                        Visibility="{Binding HasInputImage, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="File: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding FileName}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="11" MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text=" • " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding OriginalDimensionsText}" Foreground="{StaticResource TextBrush}" FontSize="11"/>
                                <TextBlock Text=" • " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding OriginalFileSizeFormatted}" Foreground="{StaticResource TextBrush}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Unit Selection: Pixel vs Centimeter (Matches Pi7 Screenshot) -->
                    <GroupBox Header="1. Dimension Units (Pixel or Centimeter)" Margin="0,0,0,10">
                        <StackPanel Margin="0,6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,8">
                                <RadioButton Content="Pixel (px)" IsChecked="{Binding IsPixelMode}" Margin="0,0,24,0" FontWeight="Bold" FontSize="13"/>
                                <RadioButton Content="Centimeter (cm)" IsChecked="{Binding IsCentimeterMode}" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>

                            <!-- Pixel Input Mode -->
                            <Grid Visibility="{Binding IsPixelMode, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Width (px):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="26"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding WidthPxText, UpdateSourceTrigger=PropertyChanged}" LostFocus="DimensionTextBox_LostFocus" Height="32" FontSize="14" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                        <Grid Grid.Column="1" Margin="2,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Button Content="▲" Command="{Binding IncrementWidthCommand}" Style="{StaticResource SpinnerButtonStyle}" Margin="0,0,0,1"/>
                                            <Button Grid.Row="1" Content="▼" Command="{Binding DecrementWidthCommand}" Style="{StaticResource SpinnerButtonStyle}" Margin="0,1,0,0"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="✕" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="14,14,14,0"/>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Height (px):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="26"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding HeightPxText, UpdateSourceTrigger=PropertyChanged}" LostFocus="DimensionTextBox_LostFocus" Height="32" FontSize="14" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                        <Grid Grid.Column="1" Margin="2,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Button Content="▲" Command="{Binding IncrementHeightCommand}" Style="{StaticResource SpinnerButtonStyle}" Margin="0,0,0,1"/>
                                            <Button Grid.Row="1" Content="▼" Command="{Binding DecrementHeightCommand}" Style="{StaticResource SpinnerButtonStyle}" Margin="0,1,0,0"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Centimeter Input Mode -->
                            <Grid Visibility="{Binding IsCentimeterMode, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Width (cm):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="26"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding WidthCmText, UpdateSourceTrigger=PropertyChanged}" LostFocus="DimensionTextBox_LostFocus" Height="32" FontSize="14" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                        <Grid Grid.Column="1" Margin="2,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Button Content="▲" Command="{Binding IncrementWidthCommand}" Style="{StaticResource SpinnerButtonStyle}" Margin="0,0,0,1"/>
                                            <Button Grid.Row="1" Content="▼" Command="{Binding DecrementWidthCommand}" Style="{StaticResource SpinnerButtonStyle}" Margin="0,1,0,0"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="✕" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,14,10,0"/>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Height (cm):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="26"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding HeightCmText, UpdateSourceTrigger=PropertyChanged}" LostFocus="DimensionTextBox_LostFocus" Height="32" FontSize="14" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                        <Grid Grid.Column="1" Margin="2,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Button Content="▲" Command="{Binding IncrementHeightCommand}" Style="{StaticResource SpinnerButtonStyle}" Margin="0,0,0,1"/>
                                            <Button Grid.Row="1" Content="▼" Command="{Binding DecrementHeightCommand}" Style="{StaticResource SpinnerButtonStyle}" Margin="0,1,0,0"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="@" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,14,10,0"/>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="DPI:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding DpiOptions}" SelectedItem="{Binding SelectedDpi}" Height="32"/>
                                </StackPanel>
                            </Grid>

                            <!-- Dynamic Equivalent Size Readout -->
                            <TextBlock Text="{Binding EquivalentPixelsText}" Foreground="{StaticResource AccentBrush}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Target File Size (Matches Pi7 Screenshot Size: [20] Kb) -->
                    <GroupBox Header="2. Target File Size &amp; Enhancement" Margin="0,0,0,10">
                        <StackPanel Margin="0,6">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Max Size -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Max File Size (KB):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="26"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding TargetSizeKBText, UpdateSourceTrigger=PropertyChanged}" 
                                                 LostFocus="DimensionTextBox_LostFocus"
                                                 Height="32" FontSize="14" FontWeight="Bold" 
                                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                        <Grid Grid.Column="1" Margin="2,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Button Content="▲" Command="{Binding IncrementSizeCommand}" Style="{StaticResource SpinnerButtonStyle}" Margin="0,0,0,1"/>
                                            <Button Grid.Row="1" Content="▼" Command="{Binding DecrementSizeCommand}" Style="{StaticResource SpinnerButtonStyle}" Margin="0,1,0,0"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>

                                <!-- Column 1: Min Size -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Min Size (0 = No Min):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" 
                                               ToolTip="Minimum size requirement (e.g. SSC requires 10-20 KB)"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="26"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding MinSizeKBText, UpdateSourceTrigger=PropertyChanged}" 
                                                 LostFocus="DimensionTextBox_LostFocus"
                                                 Height="32" FontSize="14" FontWeight="Bold" 
                                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                                                 ToolTip="Set to 0 if no minimum requirement"/>
                                        <Grid Grid.Column="1" Margin="2,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Button Content="▲" Command="{Binding IncrementMinSizeCommand}" Style="{StaticResource SpinnerButtonStyle}" Margin="0,0,0,1"/>
                                            <Button Grid.Row="1" Content="▼" Command="{Binding DecrementMinSizeCommand}" Style="{StaticResource SpinnerButtonStyle}" Margin="0,1,0,0"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <CheckBox IsChecked="{Binding CleanBackground}" Margin="0,0,0,6">
                                <TextBlock Text="✨ Clean Paper Background &amp; Boost Ink (Magic White)" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding AutoCrop}" Margin="0,0,0,6"
                                      ToolTip="Trims empty paper margins around the signature so it scales to full crisp size">
                                <TextBlock Text="✂️ Auto-Crop Signature (Trim blank scanner margins)" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding MaintainAspectRatio}" Margin="0,0,0,8">
                                <TextBlock Text="Fit inside bounds (Keep original aspect ratio with white border)" TextWrapping="Wrap"/>
                            </CheckBox>

                            <!-- Signature Ink Color Selector -->
                            <TextBlock Text="Signature Ink Color (Daily Cyber Cafe Ink Standard):" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,6"/>
                            <UniformGrid Columns="4" Margin="0,0,0,10">
                                <RadioButton GroupName="DialogInkColorGroup" Content="⬛ Pitch Black" IsChecked="{Binding IsInkBlack}" Command="{Binding SetInkColorModeCommand}" CommandParameter="Black" 
                                             FontWeight="Bold" FontSize="11" ToolTip="Strict Exam / SSC / UPSC Pitch Black standard — transforms any blue/pale signature to solid pitch black"/>
                                <RadioButton GroupName="DialogInkColorGroup" Content="🖊️ Royal Blue" IsChecked="{Binding IsInkRoyalBlue}" Command="{Binding SetInkColorModeCommand}" CommandParameter="RoyalBlue" 
                                             FontWeight="Bold" FontSize="11" Foreground="#60A5FA" ToolTip="Official Indian Bank, PAN &amp; Document Royal Blue Pen Ink — converts signature to realistic ballpoint/gel blue ink"/>
                                <RadioButton GroupName="DialogInkColorGroup" Content="🖋️ Dark Navy" IsChecked="{Binding IsInkNavyBlue}" Command="{Binding SetInkColorModeCommand}" CommandParameter="NavyBlue" 
                                             FontWeight="Bold" FontSize="11" Foreground="#93C5FD" ToolTip="Deep classic Navy / Fountain Pen Blue ink tone"/>
                                <RadioButton GroupName="DialogInkColorGroup" Content="🎨 Original Ink" IsChecked="{Binding IsInkOriginal}" Command="{Binding SetInkColorModeCommand}" CommandParameter="Original" 
                                             FontSize="11" ToolTip="Preserve customer's original pen ink color with enhanced contrast"/>
                            </UniformGrid>

                            <!-- Background Color / Mode Selection -->
                            <TextBlock Text="Signature Background (Paper vs Transparent):" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton GroupName="DialogBgStyleGroup" Content="⚪ Clean White (JPEG — Portals)" IsChecked="{Binding IsBackgroundWhite}" Margin="0,0,20,0" FontWeight="Bold" FontSize="11.5"
                                             ToolTip="Clean pure white paper background for official exam &amp; job portal uploads (NSDL, UTI, SSC, UPSC)"/>
                                <RadioButton GroupName="DialogBgStyleGroup" Content="✨ Transparent (PNG — No White Box)" IsChecked="{Binding IsBackgroundTransparent}" FontWeight="Bold" FontSize="11.5" Foreground="#38BDF8"
                                             ToolTip="100% Transparent background (Zero white box) — for pasting directly onto PAN cards, PVC cards, and documents"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- One-Click Exam Presets -->
                    <GroupBox Header="3. Quick Indian Exam &amp; Portal Presets" Margin="0,0,0,10">
                        <StackPanel Margin="0,4">
                            <WrapPanel Margin="0,0,0,6">
                                <Button Content="💳 PAN Portal (2×4.5 cm)" Command="{Binding QuickPresetCommand}" CommandParameter="PAN" Style="{StaticResource OutlineButton}" Padding="6,3" Margin="0,0,4,4" FontSize="11" FontWeight="Bold" ToolTip="Official NSDL &amp; UTI 2 × 4.5 cm Signature | 200 DPI | 10–50 KB"/>
                                <Button Content="🖊️ Royal Blue (2×4.5 cm)" Command="{Binding QuickPresetCommand}" CommandParameter="BLUE" Style="{StaticResource OutlineButton}" Padding="6,3" Margin="0,0,4,4" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" ToolTip="2 × 4.5 cm Signature | 200 DPI | Authentic Royal Blue Ballpoint Pen Ink"/>
                                <Button Content="✨ Transparent (No BG)" Command="{Binding QuickPresetCommand}" CommandParameter="Transparent" Style="{StaticResource OutlineButton}" Padding="6,3" Margin="0,0,4,4" FontSize="11" FontWeight="Bold" ToolTip="100% Transparent PNG without white box for card printing"/>
                                <Button Content="💳 PAN Photo (2.5×3.5 cm)" Command="{Binding QuickPresetCommand}" CommandParameter="PANPHOTO" Style="{StaticResource OutlineButton}" Padding="6,3" Margin="0,0,4,4" FontSize="11" FontWeight="Bold" ToolTip="Official NSDL &amp; UTI 2.5 × 3.5 cm Photo | 200 DPI | &lt;50 KB"/>
                                <Button Content="⚡ SSC (10-20 KB)" Command="{Binding QuickPresetCommand}" CommandParameter="SSC" Style="{StaticResource OutlineButton}" Padding="6,3" Margin="0,0,4,4" FontSize="11" ToolTip="140 × 60 px | 10–20 KB"/>
                                <Button Content="⚡ UPSC (20-50 KB)" Command="{Binding QuickPresetCommand}" CommandParameter="UPSC" Style="{StaticResource OutlineButton}" Padding="6,3" Margin="0,0,4,4" FontSize="11" ToolTip="350 × 350 px | 20–50 KB"/>
                                <Button Content="⚡ IBPS (10-20 KB)" Command="{Binding QuickPresetCommand}" CommandParameter="IBPS" Style="{StaticResource OutlineButton}" Padding="6,3" Margin="0,0,4,4" FontSize="11" ToolTip="140 × 60 px | 10–20 KB"/>
                                <Button Content="⚡ State PSC (3.5×1.5 cm)" Command="{Binding QuickPresetCommand}" CommandParameter="PSC" Style="{StaticResource OutlineButton}" Padding="6,3" Margin="0,0,4,4" FontSize="11" ToolTip="3.5 × 1.5 cm | 10–20 KB"/>
                                <Button Content="⚡ Thumb (10-50 KB)" Command="{Binding QuickPresetCommand}" CommandParameter="Thumb" Style="{StaticResource OutlineButton}" Padding="6,3" Margin="0,0,4,4" FontSize="11" ToolTip="240 × 240 px | 10–50 KB"/>
                            </WrapPanel>
                            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" Height="34"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Live Loading / Generating Preview State -->
                    <Border Background="#141520" CornerRadius="8" Padding="12" Margin="0,4,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Visibility="{Binding ShowLoadingState, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                <ProgressBar IsIndeterminate="True" Width="40" Height="3" Margin="0,0,8,0" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="⚡ Generating Instant Live Preview..." FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                            <Border Background="{Binding PreviewBackgroundBrush}" BorderBrush="#888888" BorderThickness="1" CornerRadius="4" Padding="6" HorizontalAlignment="Center" Opacity="0.8">
                                <Image Source="{Binding InputPreviewImage}" MaxHeight="140" MaxWidth="320" Stretch="Uniform"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Live Result / Preview -->
                    <Border Background="#141520" CornerRadius="8" Padding="12" Margin="0,4,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ResultSummary}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            
                            <!-- Active Badges Stack -->
                            <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,0" Visibility="{Binding IsTransparentPngMode, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="✨ 100% Transparent PNG (No White Box)" FontSize="10" FontWeight="Bold" Foreground="#6EE7B7"/>
                                </Border>
                                <Border Background="#1E3A8A" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,0" Visibility="{Binding IsInkRoyalBlue, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="🖊️ Royal Blue Pen Ink" FontSize="10" FontWeight="Bold" Foreground="#93C5FD"/>
                                </Border>
                                <Border Background="#172554" BorderBrush="#60A5FA" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,0" Visibility="{Binding IsInkNavyBlue, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="🖋️ Dark Navy Blue Ink" FontSize="10" FontWeight="Bold" Foreground="#BFDBFE"/>
                                </Border>
                            </WrapPanel>

                            <!-- Preview Background Switcher -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock Text="Preview On:" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button Content="🏁 Alpha" Command="{Binding SetPreviewBackgroundModeCommand}" CommandParameter="Checkerboard" Margin="0,0,3,0" Padding="5,2" FontSize="10" Style="{StaticResource SecondaryButton}" ToolTip="View on transparent checkerboard grid"/>
                                <Button Content="⚪ Paper" Command="{Binding SetPreviewBackgroundModeCommand}" CommandParameter="White" Margin="0,0,3,0" Padding="5,2" FontSize="10" Style="{StaticResource SecondaryButton}" ToolTip="View on clean white paper"/>
                                <Button Content="⚡ Auto" Command="{Binding SetPreviewBackgroundModeCommand}" CommandParameter="Auto" Padding="5,2" FontSize="10" Style="{StaticResource SecondaryButton}" ToolTip="Auto-match preview to selected output background"/>
                            </StackPanel>

                            <Border Background="{Binding PreviewBackgroundBrush}" BorderBrush="#888888" BorderThickness="1" CornerRadius="4" Padding="6" HorizontalAlignment="Center">
                                <Image Source="{Binding ResultImage}" MaxHeight="140" MaxWidth="320" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <!-- Actions for result -->
                            <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Button Content="💳 Save PAN / Portal (JPEG)" Style="{StaticResource AccentButton}" Command="{Binding SavePanPortalJpegCommand}" Padding="12,6" Margin="0,0,6,6" FontWeight="Bold" ToolTip="Save strictly 2 × 4.5 cm @ 200 DPI JPEG under 50 KB with selected ink color (NSDL &amp; UTIITSL upload ready)"/>
                                <Button Content="✨ Save Transparent PNG" Style="{StaticResource PrimaryButton}" Command="{Binding SaveTransparentPngCommand}" Padding="12,6" Margin="0,0,6,6" FontWeight="Bold" ToolTip="Save 100% transparent PNG with isolated handwriting ink (ZERO white box — fits seamlessly on PAN card)"/>
                                <Button Content="💾 Save As..." Style="{StaticResource SecondaryButton}" Command="{Binding SaveAsCommand}" Padding="10,6" Margin="0,0,6,6"/>
                                <Button Content="📋 Copy Transparent (No BG)" Style="{StaticResource SecondaryButton}" Command="{Binding CopyResultCommand}" Padding="10,6" Margin="0,0,6,6" ToolTip="Copies handwriting with alpha channel to clipboard (Ctrl+V into Word, Photoshop, or PVC card software without white box)"/>
                                <Button Content="🖨️ Print" Style="{StaticResource SecondaryButton}" Command="{Binding PrintCommand}" Padding="10,6" Margin="0,0,0,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Primary Action Bar -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="80" Height="4" Margin="0,0,10,0" Foreground="{StaticResource AccentBrush}" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="✍️ Resize Signature" Style="{StaticResource PrimaryButton}" Command="{Binding ResizeCommand}" 
                            IsEnabled="{Binding CanResize}" Padding="22,10" FontWeight="Bold" FontSize="13"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
