<Window x:Class="SmartSaver.Views.NativePrintDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmartSaver.Converters"
        Title="Print — DASMO CYBER CAFE TOOLS"
        Height="700" Width="960" MinHeight="620" MinWidth="880"
        WindowStartupLocation="CenterOwner"
        Background="#181924" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:StringEqualsConverter x:Key="StringEquals"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Row 0: Top Header / Printer Selection Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Main Content Split (Settings on Left, WYSIWYG Preview on Right) -->
            <RowDefinition Height="*"/>
            <!-- Row 2: Bottom Action Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR: PRINTER SELECTION, COPIES & COLOR -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Printer Dropdown & Properties -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Printer:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                    <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}" Width="260" Height="32" VerticalContentAlignment="Center"/>
                    <Button Content="Properties" Command="{Binding OpenPropertiesCommand}" Style="{StaticResource OutlineButton}" Height="32" Padding="12,4" Margin="8,0,0,0" ToolTip="Open native Windows printer manufacturer properties dialog"/>
                </StackPanel>

                <!-- Status Badge -->
                <Border Grid.Column="1" Background="#1B2B1B" BorderBrush="#2E7D32" BorderThickness="1" CornerRadius="4" Padding="6,3" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="{Binding PrinterStatus}" FontSize="11" Foreground="#81C784" FontWeight="SemiBold"/>
                </Border>

                <!-- Divider -->
                <Rectangle Grid.Column="3" Width="1" Fill="{StaticResource BorderBrush}" Margin="16,4" HorizontalAlignment="Right"/>

                <!-- Copies, Grayscale & Save Ink -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Copies:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <Button Content="-" Command="{Binding DecreaseCopiesCommand}" Style="{StaticResource OutlineButton}" Width="26" Height="30" Padding="0"/>
                        <TextBox Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged}" Width="45" Height="30" TextAlignment="Center" VerticalContentAlignment="Center" Margin="2,0"/>
                        <Button Content="+" Command="{Binding IncreaseCopiesCommand}" Style="{StaticResource OutlineButton}" Width="26" Height="30" Padding="0"/>
                    </StackPanel>

                    <CheckBox Content="Print in grayscale (B&amp;W)" IsChecked="{Binding IsGrayscale}" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold"/>
                    <CheckBox Content="🖤 Pitch Black Text" IsChecked="{Binding PitchBlackText}" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Bold" Foreground="#00E5FF" ToolTip="Enhance low-contrast and faded text to pitch black and whiten document paper"/>
                    <CheckBox Content="Save ink/toner" IsChecked="{Binding SaveInkToner}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT: 2 COLUMNS -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <!-- Left: Print Configuration Options -->
                <ColumnDefinition Width="410"/>
                <!-- Right: Live WYSIWYG Print Preview -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: CONTROLS (Adobe Acrobat style grouping) -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,0">
                <StackPanel>
                    <!-- 1. Pages to Print -->
                    <GroupBox Header="Pages to Print" Margin="0,0,0,10">
                        <StackPanel Margin="4,6">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <RadioButton Content="All" IsChecked="{Binding RangeMode, Converter={StaticResource StringEquals}, ConverterParameter=All}" Margin="0,0,16,0" FontWeight="SemiBold"/>
                                <RadioButton Content="Current page" IsChecked="{Binding RangeMode, Converter={StaticResource StringEquals}, ConverterParameter=Current}" Margin="0,0,16,0"/>
                                <RadioButton Content="Pages:" IsChecked="{Binding RangeMode, Converter={StaticResource StringEquals}, ConverterParameter=Pages}" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding CustomPagesText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCustomPagesEnabled}" Width="100" Height="26" VerticalContentAlignment="Center" ToolTip="Enter pages, e.g. 1, 3-5"/>
                            </StackPanel>
                            <TextBlock Text="Tip: You can specify comma-separated pages or page ranges (e.g. 1, 3-5)." Foreground="{StaticResource TextSecondaryBrush}" FontSize="10.5"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 2. Page Sizing & Handling -->
                    <GroupBox Header="Page Sizing &amp; Handling" Margin="0,0,0,10">
                        <StackPanel Margin="4,6">
                            <!-- Sizing Mode Radio Options -->
                            <StackPanel Margin="0,0,0,6">
                                <RadioButton Content="Fit (Scale to fit printable area safely)" 
                                             IsChecked="{Binding SizingMode, Converter={StaticResource StringEquals}, ConverterParameter=Fit}" 
                                             Margin="0,0,0,6" FontWeight="SemiBold"/>

                                <RadioButton Content="Actual size (100% 1:1 scale — Keep exact ID card cm)" 
                                             IsChecked="{Binding SizingMode, Converter={StaticResource StringEquals}, ConverterParameter=ActualSize}" 
                                             Margin="0,0,0,6" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>

                                <RadioButton Content="Shrink oversized pages" 
                                             IsChecked="{Binding SizingMode, Converter={StaticResource StringEquals}, ConverterParameter=Shrink}" 
                                             Margin="0,0,0,6"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <RadioButton Content="Custom Scale:" 
                                                 IsChecked="{Binding SizingMode, Converter={StaticResource StringEquals}, ConverterParameter=CustomScale}" 
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding CustomScalePercent, UpdateSourceTrigger=PropertyChanged}" 
                                             IsEnabled="{Binding IsCustomScaleEnabled}" 
                                             Width="55" Height="26" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Separator Background="{StaticResource BorderBrush}" Margin="0,6"/>

                            <CheckBox Content="Auto-rotate and center on paper" IsChecked="{Binding AutoCenter}" Margin="0,2,0,4" FontWeight="SemiBold"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 3. Orientation -->
                    <GroupBox Header="Orientation" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <RadioButton Content="Auto" IsChecked="{Binding OrientationMode, Converter={StaticResource StringEquals}, ConverterParameter=Auto}" Margin="0,0,20,0"/>
                            <RadioButton Content="Portrait" IsChecked="{Binding OrientationMode, Converter={StaticResource StringEquals}, ConverterParameter=Portrait}" Margin="0,0,20,0" FontWeight="SemiBold"/>
                            <RadioButton Content="Landscape" IsChecked="{Binding OrientationMode, Converter={StaticResource StringEquals}, ConverterParameter=Landscape}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 4. Paper Setup -->
                    <GroupBox Header="Paper Setup" Margin="0,0,0,4">
                        <StackPanel Margin="4,6">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Paper Size:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding PaperSizes}" SelectedItem="{Binding SelectedPaperSize}" Height="28" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="2" Content="Page Setup..." Command="{Binding PageSetupCommand}" Style="{StaticResource OutlineButton}" Height="28" Padding="8,2" Margin="6,0,0,0" ToolTip="Open Windows Page Setup dialog"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT COLUMN: LIVE WYSIWYG PRINT PREVIEW -->
            <Border Grid.Column="1" Background="#0C0D14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Preview Header / Scale Readout -->
                        <RowDefinition Height="Auto"/>
                        <!-- Center Paper Canvas -->
                        <RowDefinition Height="*"/>
                        <!-- Pager / Zoom Controls -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Preview Info Header -->
                    <Grid Grid.Row="0" Margin="4,0,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#1E2338" CornerRadius="4" Padding="8,3">
                            <TextBlock Text="{Binding CalculatedScaleText}" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource AccentBrush}"/>
                        </Border>

                        <TextBlock Grid.Column="2" Text="{Binding PaperDimensionsText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Center Paper Area: White Paper with Drop Shadow & Scaled Preview -->
                    <Border Grid.Row="1" Background="#07080D" BorderBrush="#1C1E2C" BorderThickness="1" CornerRadius="6" Padding="16" ClipToBounds="True">
                        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Paper sheet simulation with realistic dimensions -->
                            <Grid Width="{Binding PaperAspectWidth}" Height="{Binding PaperAspectHeight}" Background="White">
                                <!-- Subtle Paper Shadow & Boundary -->
                                <Border BorderBrush="#666666" BorderThickness="0.6">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.35" Color="Black"/>
                                    </Border.Effect>
                                </Border>

                                <!-- Printable Margin Dashed Guide Line -->
                                <Rectangle Margin="4" Stroke="#B0B0B0" StrokeThickness="0.5" StrokeDashArray="2 2"/>

                                <!-- Actual Image Preview -->
                                <Image Source="{Binding PreviewImage}" 
                                       Stretch="Uniform" 
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       RenderOptions.EdgeMode="Aliased"
                                       Margin="5"/>

                                <!-- No Preview Placeholder -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding PreviewImage, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                    <TextBlock Text="📄" FontSize="36" HorizontalAlignment="Center" Opacity="0.3"/>
                                    <TextBlock Text="No preview available" Foreground="#888888" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Viewbox>
                    </Border>

                    <!-- Bottom Preview Navigation & Slider -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="◀" Command="{Binding PrevPageCommand}" Style="{StaticResource OutlineButton}" Width="32" Height="28" Padding="0" ToolTip="Previous Page"/>

                            <Slider Value="{Binding CurrentPageIndex}" Minimum="0" Maximum="{Binding MaxPageIndex}" 
                                    Width="120" VerticalAlignment="Center" Margin="10,0" IsSnapToTickEnabled="True" TickFrequency="1"
                                    Visibility="{Binding HasMultiplePages, Converter={StaticResource BoolToVis}}"/>

                            <Border Background="#1C1E2E" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                                <TextBlock Text="{Binding PageSummaryText}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                            </Border>

                            <Button Content="▶" Command="{Binding NextPageCommand}" Style="{StaticResource OutlineButton}" Width="32" Height="28" Padding="0" ToolTip="Next Page"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM ACTION BAR: STATUS, PRINT & CANCEL -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status & Progress -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="6" Margin="0,0,10,0" Foreground="{StaticResource AccentBrush}" Visibility="{Binding IsPrinting, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding PrintStatusText}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource OutlineButton}" Width="100" Height="36" Margin="0,0,10,0" IsCancel="True"/>
                    <Button Content="🖨️ Print" Command="{Binding PrintCommand}" Style="{StaticResource PrimaryButton}" Width="140" Height="36" FontWeight="Bold" FontSize="13" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
