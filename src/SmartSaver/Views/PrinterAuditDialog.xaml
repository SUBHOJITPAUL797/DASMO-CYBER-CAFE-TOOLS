<Window x:Class="SmartSaver.Views.PrinterAuditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartSaver.Converters"
        mc:Ignorable="d"
        Title="🖨️ Brother DCP-T530DW — Hardware Meter &amp; Physical Xerox Audit" 
        Height="640" Width="880" MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False" Background="{StaticResource BackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:StringEqualsConverter x:Key="StringEquals"/>

        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource HeaderBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E53935"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Hardware Status & Ink Strips -->
                <RowDefinition Height="*"/> <!-- Main Audit & Reconciliation -->
                <RowDefinition Height="46"/> <!-- Bottom Actions -->
            </Grid.RowDefinitions>

            <!-- ── Top Title Bar ── -->
            <Grid Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="🖨️" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Brother DCP-T530DW" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text=" — Hardware Meter &amp; Physical Walk-up Xerox Audit" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="2" Content="✕" Style="{StaticResource CloseBtn}" Click="Close_Click" Margin="0,0,6,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <!-- ── Printer Live Connection & Ink Status ── -->
            <Border Grid.Row="1" Background="#1E1E2A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Device Status & IP -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DeviceStatusText}" FontWeight="Bold" FontSize="12.5" Foreground="White"/>
                            <Button Content="🔄 Refresh Status" Command="{Binding RefreshLiveStatusCommand}"
                                    Style="{StaticResource CardBtn}" Margin="12,0,0,0" Padding="8,2" FontSize="11"/>
                        </StackPanel>
                        <TextBlock Text="⚡ Dual-Mode: Wi-Fi live status + USB high-speed printing supported simultaneously." 
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Estimated Ink Levels Gauges -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Estimated Ink: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <!-- Black -->
                        <Border Background="#2B2B38" CornerRadius="4" Padding="6,3" Margin="0,0,5,0" BorderBrush="#555" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" Background="#111" CornerRadius="2" Margin="0,0,4,0" VerticalAlignment="Center" BorderBrush="#888" BorderThickness="1"/>
                                <TextBlock Text="{Binding InkBlack, StringFormat='BK: {0}%'}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                        <!-- Cyan -->
                        <Border Background="#2B2B38" CornerRadius="4" Padding="6,3" Margin="0,0,5,0" BorderBrush="#00BCD4" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" Background="#00BCD4" CornerRadius="2" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding InkCyan, StringFormat='C: {0}%'}" FontSize="11" FontWeight="Bold" Foreground="#00BCD4"/>
                            </StackPanel>
                        </Border>
                        <!-- Magenta -->
                        <Border Background="#2B2B38" CornerRadius="4" Padding="6,3" Margin="0,0,5,0" BorderBrush="#E91E63" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" Background="#E91E63" CornerRadius="2" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding InkMagenta, StringFormat='M: {0}%'}" FontSize="11" FontWeight="Bold" Foreground="#E91E63"/>
                            </StackPanel>
                        </Border>
                        <!-- Yellow -->
                        <Border Background="#2B2B38" CornerRadius="4" Padding="6,3" BorderBrush="#FFEB3B" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" Background="#FFEB3B" CornerRadius="2" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding InkYellow, StringFormat='Y: {0}%'}" FontSize="11" FontWeight="Bold" Foreground="#FFEB3B"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Main Workspace ── -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="14">
                <StackPanel>
                    <!-- 1. Meter Audit Section -->
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,12"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📊 PHYSICAL HARDWARE METER RECONCILIATION" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Compares actual paper sheets moved through the printer hardware against software PC spooler prints to find unbilled walk-up Xerox copies." 
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,0,0,12"/>

                            <!-- Meter Inputs Grid -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Opening Meter (Morning) -->
                                <Border Grid.Column="0" Background="#262635" CornerRadius="6" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="🌅 Morning Opening Meter Reading:" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding OpeningMeter, UpdateSourceTrigger=PropertyChanged}" 
                                                     FontSize="15" FontWeight="Bold" Padding="8,4" VerticalContentAlignment="Center"/>
                                            <Button Grid.Column="1" Content="💾 Set Morning" Command="{Binding SaveOpeningMeterCommand}" 
                                                    Style="{StaticResource CardBtn}" Margin="6,0,0,0" Padding="10,4" Background="#162920" Foreground="#10B981" BorderBrush="#10B981"/>
                                        </Grid>
                                        <TextBlock Text="Start of day counter (carried over from yesterday)." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Closing / Current Meter (Now) -->
                                <Border Grid.Column="2" Background="#262635" CornerRadius="6" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="🌙 Current / Closing Meter Reading:" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding CurrentHardwareMeter, UpdateSourceTrigger=PropertyChanged}" 
                                                     FontSize="15" FontWeight="Bold" Padding="8,4" VerticalContentAlignment="Center"/>
                                            <Button Grid.Column="1" Content="💾 Set Closing" Command="{Binding SaveClosingMeterCommand}" 
                                                    Style="{StaticResource CardBtn}" Margin="6,0,0,0" Padding="10,4" Background="#152636" Foreground="#00BCD4" BorderBrush="#00BCD4"/>
                                        </Grid>
                                        <TextBlock Text="Check on LCD: Menu ➔ Machine Info ➔ Page Counter." FontSize="10.5" Foreground="#F59E0B" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Calculation Cards -->
                            <UniformGrid Columns="4" Rows="1" Margin="0,0,0,12">
                                <!-- 1. Hardware Sheets -->
                                <Border Background="#1E1E2C" CornerRadius="6" Padding="10,8" Margin="0,0,4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="HARDWARE PAGES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding TotalHardwareSheets}" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                                        <TextBlock Text="Closing - Opening" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- 2. PC Prints -->
                                <Border Background="#1E1E2C" CornerRadius="6" Padding="10,8" Margin="2,0,2,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="PC SPOOLER PRINTS" FontSize="10" FontWeight="Bold" Foreground="#00BCD4"/>
                                        <TextBlock Text="{Binding TotalPcSpoolerPages}" FontSize="20" FontWeight="Bold" Foreground="#00BCD4" Margin="0,2,0,0"/>
                                        <TextBlock Text="From computer apps" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- 3. Physical Xerox Made -->
                                <Border Background="#1E1E2C" CornerRadius="6" Padding="10,8" Margin="2,0,2,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="ACTUAL XEROX" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                        <TextBlock Text="{Binding ActualPhysicalXerox}" FontSize="20" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0"/>
                                        <TextBlock Text="Machine - PC Prints" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- 4. Unrecorded Discrepancy -->
                                <Border Background="#1E1E2C" CornerRadius="6" Padding="10,8" Margin="4,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="UNRECORDED XEROX" FontSize="10" FontWeight="Bold" Foreground="#F43F5E"/>
                                        <TextBlock Text="{Binding UnrecordedXeroxCopies}" FontSize="20" FontWeight="Bold" Foreground="#F43F5E" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding UnrecordedXeroxAmount, StringFormat='₹{0:F2}'}" FontSize="10" FontWeight="Bold" Foreground="#F43F5E"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Unrecorded Alert & Auto-Add Action -->
                            <Border Background="#2B1D20" BorderBrush="#F43F5E" BorderThickness="1.5" CornerRadius="6" Padding="12,10"
                                    Visibility="{Binding HasUnrecordedXerox, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="⚠️ Unrecorded Physical Xerox Copies Detected!" FontWeight="Bold" FontSize="12.5" Foreground="#F43F5E"/>
                                        <TextBlock Text="{Binding UnrecordedXeroxCopies, StringFormat='The machine made {0} Xerox copies that have not yet been recorded in the cash register.'}" 
                                                   FontSize="11" Foreground="White" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Medium Choice -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                        <TextBlock Text="Deposit to: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <RadioButton Content="💵 Cash" IsChecked="{Binding SelectedMedium, Converter={StaticResource StringEquals}, ConverterParameter='Cash'}" 
                                                     Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <RadioButton Content="📱 UPI" IsChecked="{Binding SelectedMedium, Converter={StaticResource StringEquals}, ConverterParameter='UPI'}" 
                                                     Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" Command="{Binding AutoLogMissingXeroxCommand}"
                                            Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="12" Padding="12,8" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡ " FontSize="12"/>
                                            <TextBlock Text="{Binding UnrecordedXeroxAmount, StringFormat='Auto-Add ₹{0:F2} to Cash Drawer &amp; Excel'}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 2. Rush-Hour 1-Click Walk-Up Xerox Counter -->
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="⚡ RUSH-HOUR 1-CLICK PHYSICAL XEROX COUNTER" FontWeight="Bold" FontSize="12" Foreground="#10B981" Margin="0,0,0,4"/>
                            <TextBlock Text="Customer came for quick Xerox and paid cash? Click any button to instantly log into Cash Drawer &amp; Excel with ZERO typing!" 
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,0,0,10"/>

                            <WrapPanel Orientation="Horizontal">
                                <Button Command="{Binding QuickLogXeroxCommand}" CommandParameter="1|false|false" Style="{StaticResource CardBtn}" Margin="0,0,6,6" Padding="12,8">
                                    <TextBlock Text="➕ 1 B&amp;W Xerox (₹2)" FontWeight="Bold" Foreground="White"/>
                                </Button>
                                <Button Command="{Binding QuickLogXeroxCommand}" CommandParameter="2|false|false" Style="{StaticResource CardBtn}" Margin="0,0,6,6" Padding="12,8">
                                    <TextBlock Text="➕ 2 B&amp;W Xerox (₹4)" FontWeight="Bold" Foreground="White"/>
                                </Button>
                                <Button Command="{Binding QuickLogXeroxCommand}" CommandParameter="5|false|false" Style="{StaticResource CardBtn}" Margin="0,0,6,6" Padding="12,8">
                                    <TextBlock Text="➕ 5 B&amp;W Xerox (₹10)" FontWeight="Bold" Foreground="White"/>
                                </Button>
                                <Button Command="{Binding QuickLogXeroxCommand}" CommandParameter="10|false|false" Style="{StaticResource CardBtn}" Margin="0,0,6,6" Padding="12,8">
                                    <TextBlock Text="➕ 10 B&amp;W Xerox (₹20)" FontWeight="Bold" Foreground="White"/>
                                </Button>
                                <Button Command="{Binding QuickLogXeroxCommand}" CommandParameter="1|true|false" Style="{StaticResource CardBtn}" Margin="0,0,6,6" Padding="12,8" BorderBrush="#10B981">
                                    <TextBlock Text="📑 1 Duplex B&amp;W (₹3)" FontWeight="Bold" Foreground="#10B981"/>
                                </Button>
                                <Button Command="{Binding QuickLogXeroxCommand}" CommandParameter="2|true|false" Style="{StaticResource CardBtn}" Margin="0,0,6,6" Padding="12,8" BorderBrush="#10B981">
                                    <TextBlock Text="📑 2 Duplex B&amp;W (₹6)" FontWeight="Bold" Foreground="#10B981"/>
                                </Button>
                                <Button Command="{Binding QuickLogXeroxCommand}" CommandParameter="1|false|true" Style="{StaticResource CardBtn}" Margin="0,0,6,6" Padding="12,8" BorderBrush="#00BCD4">
                                    <TextBlock Text="🌈 1 Color Xerox (₹10)" FontWeight="Bold" Foreground="#00BCD4"/>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ── Bottom Action Bar ── -->
            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
                <Grid>
                    <TextBlock Text="DASMO CYBER CAFE TOOLS • Brother Hardware Audit &amp; Counter Engine" 
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                    <Button Content="Close" Style="{StaticResource CardBtn}" HorizontalAlignment="Right" Width="90" Click="Close_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
