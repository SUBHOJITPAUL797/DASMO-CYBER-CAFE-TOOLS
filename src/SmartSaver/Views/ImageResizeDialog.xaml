<Window x:Class="SmartSaver.Views.ImageResizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmartSaver.Converters"
        Title="DASMO CYBER COMPRESSOR — Resize Image" Height="520" Width="490"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:StringEqualsConverter x:Key="StringEquals"/>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- Photo Background Layer -->
            <Image Source="pack://application:,,,/Resources/background_photo.png" Stretch="UniformToFill" Opacity="0.35" IsHitTestVisible="False" Grid.RowSpan="3"/>

            <!-- Title Bar -->
            <Grid Background="{StaticResource SurfaceBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="🖼️ " FontSize="14"/>
                    <TextBlock Text="DASMO CYBER COMPRESSOR — Resize Image" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🗕" Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" ToolTip="Minimize"/>
                    <Button Content="✕" Style="{StaticResource TitleBarCloseButton}" Click="CloseButton_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- Main Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,15">
                <StackPanel>
                    <!-- File Info Card -->
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🖼️" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="Original Size: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding CurrentFileSize}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="  •  Dimensions: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="6,0,0,0"/>
                                    <TextBlock Text="{Binding OriginalDimensions}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Resize Options Card -->
                    <GroupBox Header="1. Choose Resize Method &amp; Portal Presets">
                        <StackPanel Margin="0,4">
                            <!-- Govt & Exam Portal Preset Selector -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Portal Preset: " VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding PortalPresets}" SelectedItem="{Binding SelectedPortalPreset}" DisplayMemberPath="Name"/>
                            </Grid>

                            <!-- Option A: File Size -->
                            <RadioButton Content="Resize by Target File Size (KB / MB)" 
                                         IsChecked="{Binding ResizeMode, Converter={StaticResource StringEquals}, ConverterParameter=fileSize}"
                                         FontWeight="SemiBold" Margin="0,0,0,6"/>
                            
                            <Border Background="#181926" CornerRadius="6" Padding="10" Margin="20,0,0,12">
                                <StackPanel IsEnabled="{Binding ResizeMode, Converter={StaticResource StringEquals}, ConverterParameter=fileSize}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="Target Size:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding TargetSizeKB, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                                        <ComboBox Grid.Column="2" SelectedItem="{Binding TargetSizeUnit}">
                                            <ComboBoxItem Content="KB"/>
                                            <ComboBoxItem Content="MB"/>
                                        </ComboBox>
                                    </Grid>
                                    
                                    <!-- Size Presets -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="50 KB" Style="{StaticResource ChipButton}" Command="{Binding SetPresetSizeCommand}" CommandParameter="50"/>
                                        <Button Content="100 KB" Style="{StaticResource ChipButton}" Command="{Binding SetPresetSizeCommand}" CommandParameter="100"/>
                                        <Button Content="200 KB" Style="{StaticResource ChipButton}" Command="{Binding SetPresetSizeCommand}" CommandParameter="200"/>
                                        <Button Content="500 KB" Style="{StaticResource ChipButton}" Command="{Binding SetPresetSizeCommand}" CommandParameter="500"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Option B: Dimensions -->
                            <RadioButton Content="Resize by Width &amp; Height Pixels" 
                                         IsChecked="{Binding ResizeMode, Converter={StaticResource StringEquals}, ConverterParameter=dimensions}"
                                         FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <Border Background="#181926" CornerRadius="6" Padding="10" Margin="20,0,0,4">
                                <StackPanel IsEnabled="{Binding ResizeMode, Converter={StaticResource StringEquals}, ConverterParameter=dimensions}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="Width:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding TargetWidth, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                                        <Label Grid.Column="2" Content="Height:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="3" Text="{Binding TargetHeight, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="px" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Grid>
                                    
                                    <CheckBox Content="Maintain Aspect Ratio (Uncheck for exact portal width &amp; height)" IsChecked="{Binding MaintainAspectRatio}" Margin="0,0,0,6"/>

                                    <TextBlock Text="{Binding DimensionStatusText}" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                    <!-- Dimension Presets -->
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Content="Portal (1500x1000)" Style="{StaticResource ChipButton}" Command="{Binding SetDimensionPresetCommand}" CommandParameter="1500x1000"/>
                                        <Button Content="Passport (350x450)" Style="{StaticResource ChipButton}" Command="{Binding SetDimensionPresetCommand}" CommandParameter="350x450"/>
                                        <Button Content="Signature (300x100)" Style="{StaticResource ChipButton}" Command="{Binding SetDimensionPresetCommand}" CommandParameter="300x100"/>
                                        <Button Content="HD (1280x720)" Style="{StaticResource ChipButton}" Command="{Binding SetDimensionPresetCommand}" CommandParameter="1280x720"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </GroupBox>

                    <!-- Output Mode Card -->
                    <GroupBox Header="2. Output Mode">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <RadioButton Content="Save as new file" 
                                         IsChecked="{Binding OutputMode, Converter={StaticResource StringEquals}, ConverterParameter=newFile}" 
                                         Margin="0,0,20,0"/>
                            <RadioButton Content="Replace original image" 
                                         IsChecked="{Binding OutputMode, Converter={StaticResource StringEquals}, ConverterParameter=replace}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Progress Section -->
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,6" 
                                     Foreground="{StaticResource AccentBrush}" 
                                     Background="{StaticResource SurfaceBrush}" BorderThickness="0"/>
                        <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" 
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Result Text -->
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="10" Margin="0,12,0,0"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding ResultText}" HorizontalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Buttons -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="0,0,10,10" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="20,0">
                    <Button Content="Close" Command="{Binding CancelCommand}" Width="100" HorizontalAlignment="Left"/>
                    <Button Content="🖼️ Resize Now" Command="{Binding ResizeCommand}" 
                            Style="{StaticResource PrimaryButton}" Width="150" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
