<Window x:Class="SmartSaver.Views.PrintAlertPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Detected"
        Width="400" Height="175"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave">

    <Window.Resources>
        <Style x:Key="ToastCloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888899"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#161824" CornerRadius="12" BorderBrush="#10B981" BorderThickness="1.5"
            Margin="6" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.75"/>
        </Border.Effect>
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header: Title & Close -->
                <RowDefinition Height="*"/>    <!-- Body: Document, Count & Cost -->
                <RowDefinition Height="Auto"/> <!-- Footer: Cart Text & Open Button -->
                <RowDefinition Height="3"/>    <!-- Auto-Dismiss Progress Bar -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1C1F2E" Padding="12,8" CornerRadius="10,10,0,0" BorderBrush="#25283A" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Pulsing Green Dot -->
                        <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="🖨️ PRINT DETECTED" FontWeight="Bold" FontSize="11" Foreground="#10B981" VerticalAlignment="Center"/>
                        <TextBlock Text=" • " Foreground="#666677" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtPrinterName" Text="Brother DCP-T530DW" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource ToastCloseBtn}" Click="Close_Click" ToolTip="Dismiss"/>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1" Margin="12,8,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <!-- Document Name -->
                    <TextBlock x:Name="TxtDocumentName" Text="AdmitCard.pdf" FontWeight="Bold" FontSize="12.5" Foreground="White" 
                               TextTrimming="CharacterEllipsis" MaxWidth="240" Margin="0,0,0,6"/>

                    <!-- Badges Row -->
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#222538" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                            <TextBlock x:Name="TxtPagesBadge" Text="6 Pages" FontWeight="Bold" FontSize="11" Foreground="White"/>
                        </Border>
                        <Border x:Name="PillDuplex" Background="#1A2E26" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                            <TextBlock x:Name="TxtDuplexBadge" Text="📑 3 Sheets (Duplex)" FontWeight="SemiBold" FontSize="11" Foreground="#10B981"/>
                        </Border>
                        <Border x:Name="PillColor" Background="#1A2A38" CornerRadius="4" Padding="6,2">
                            <TextBlock x:Name="TxtColorBadge" Text="⚫ B&amp;W" FontWeight="SemiBold" FontSize="11" Foreground="#00BCD4"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Cost Badge -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="JOB COST" FontSize="9" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="TxtTotalCost" Text="₹12.00" FontSize="20" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#141520" Padding="12,6" BorderBrush="#25283A" BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛒 Added to Customer Bill Cart" FontSize="11" Foreground="#888899" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="Open Studio →" HorizontalAlignment="Right" Padding="8,3" FontSize="11" FontWeight="Bold"
                            Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand" Click="OpenStudio_Click">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- Auto-Dismiss Progress Bar -->
            <ProgressBar x:Name="DismissProgress" Grid.Row="3" Height="3" Minimum="0" Maximum="100" Value="100"
                         Foreground="#10B981" Background="Transparent" BorderThickness="0"/>
        </Grid>
    </Border>
</Window>
