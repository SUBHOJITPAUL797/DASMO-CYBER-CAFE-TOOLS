<Window x:Class="SmartSaver.Views.CashDrawerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartSaver.Converters"
        mc:Ignorable="d"
        Title="DASMO CYBER CAFE — Cash Drawer &amp; Daily Finance Manager"
        Height="720" Width="1080" MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False"
        Background="#12131C" Foreground="{StaticResource TextBrush}">

    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:DoubleStringConverter x:Key="DoubleStr"/>

        <Style x:Key="MetricCardBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="FormInputText" TargetType="TextBox" BasedOn="{StaticResource BaseControlStyle}">
            <Setter Property="Background" Value="#1A1C29"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2D314A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChipShortcutBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E2235"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#333852"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A304A"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="#12131C" BorderBrush="#262A40" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>  <!-- Window Chrome Header -->
                <RowDefinition Height="Auto"/> <!-- Top KPI Realtime Counters -->
                <RowDefinition Height="Auto"/> <!-- Linked Excel Auto-Sync Bar -->
                <RowDefinition Height="*"/>    <!-- Main Body Workspace -->
            </Grid.RowDefinitions>

            <!-- ── ROW 0: Title Bar ──────────────────────────────────────── -->
            <Grid Grid.Row="0" Background="#181A26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="💰" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="DASMO CYBER CAFE" FontWeight="Bold" FontSize="14" Foreground="#10B981" VerticalAlignment="Center"/>
                    <TextBlock Text=" — Cash Drawer &amp; Daily Finance Manager" FontWeight="SemiBold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                    <Border Background="#F59E0B" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LIVE ACCOUNTS" FontSize="10" FontWeight="Bold" Foreground="#1E1E2E"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="🗕" Width="36" Height="32" Background="Transparent" BorderThickness="0" Foreground="#A0AEC0" FontSize="13" Click="Minimize_Click"/>
                    <Button x:Name="BtnMaximize" Content="🗖" Width="36" Height="32" Background="Transparent" BorderThickness="0" Foreground="#A0AEC0" FontSize="13" Click="Maximize_Click"/>
                    <Button Content="✕" Width="36" Height="32" Background="Transparent" BorderThickness="0" Foreground="#A0AEC0" FontSize="13" Click="Close_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E53E3E"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ── ROW 1: Real-time Countdown & Balances HUD ─────────────── -->
            <Border Grid.Row="1" Background="#161824" BorderBrush="#262A40" BorderThickness="0,0,0,1" Padding="10,6">
                <UniformGrid Columns="6">
                    <!-- 1. Physical Cash in Drawer -->
                    <Border Style="{StaticResource MetricCardBorder}" Background="#0F2B20" BorderBrush="#10B981">
                        <StackPanel>
                            <TextBlock Text="💵 CASH IN DRAWER" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                            <TextBlock Text="{Binding CashInDrawerDisplay}" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                            <TextBlock Text="Physical notes &amp; till" FontSize="9.5" Foreground="#6EE7B7"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. Online Bank / UPI Balance -->
                    <Border Style="{StaticResource MetricCardBorder}" Background="#0C253B" BorderBrush="#00BCD4">
                        <StackPanel>
                            <TextBlock Text="📱 ONLINE / BANK / UPI" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                            <TextBlock Text="{Binding OnlineBalanceDisplay}" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                            <TextBlock Text="PhonePe / GPay / Paytm" FontSize="9.5" Foreground="#7DD3FC"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Today's Gross Revenue -->
                    <Border Style="{StaticResource MetricCardBorder}" Background="#1F2815" BorderBrush="#84CC16">
                        <StackPanel>
                            <TextBlock Text="📊 TODAY'S EARNINGS" FontSize="10" FontWeight="Bold" Foreground="#A3E635"/>
                            <TextBlock Text="{Binding TodayRevenueDisplay}" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                            <TextBlock Text="Sales &amp; services" FontSize="9.5" Foreground="#BEF264"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. Today's Expenses -->
                    <Border Style="{StaticResource MetricCardBorder}" Background="#2B1414" BorderBrush="#EF4444">
                        <StackPanel>
                            <TextBlock Text="💸 TODAY'S EXPENSES" FontSize="10" FontWeight="Bold" Foreground="#F87171"/>
                            <TextBlock Text="{Binding TodayExpensesDisplay}" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                            <TextBlock Text="Stock, bills, withdrawal" FontSize="9.5" Foreground="#FCA5A5"/>
                        </StackPanel>
                    </Border>

                    <!-- 5. Net Profit Today -->
                    <Border Style="{StaticResource MetricCardBorder}" Background="#241B3B" BorderBrush="#8B5CF6">
                        <StackPanel>
                            <TextBlock Text="✨ NET PROFIT TODAY" FontSize="10" FontWeight="Bold" Foreground="#C084FC"/>
                            <TextBlock Text="{Binding TodayNetProfitDisplay}" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                            <TextBlock Text="Revenue minus expenses" FontSize="9.5" Foreground="#DDD6FE"/>
                        </StackPanel>
                    </Border>

                    <!-- 6. Customer Unpaid Debt (Khata) -->
                    <Border Style="{StaticResource MetricCardBorder}" Background="#29180C" BorderBrush="#F59E0B">
                        <StackPanel>
                            <TextBlock Text="🤝 CUSTOMER BORROW" FontSize="10" FontWeight="Bold" Foreground="#FBBF24"/>
                            <TextBlock Text="{Binding UnpaidDebtDisplay}" FontSize="18" FontWeight="Bold" Foreground="#FCD34D" Margin="0,2,0,0"/>
                            <TextBlock Text="Pending credit / khata" FontSize="9.5" Foreground="#FDE68A"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Border>

            <!-- ── ROW 2: Linked Excel Spreadsheet Auto-Sync Bar ──────────── -->
            <Border Grid.Row="2" Background="#141824" BorderBrush="#252A3D" BorderThickness="0,0,0,1" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Status and File Name -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📊" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="LINKED EXCEL WORKBOOK:" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border Background="#1E2338" CornerRadius="4" Padding="8,4" BorderBrush="#38BDF8" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AttachedExcelName}" FontSize="11" FontWeight="SemiBold" Foreground="White"
                                       ToolTip="{Binding AttachedExcelPath}"/>
                        </Border>

                        <!-- Auto-Sync Checkbox Toggle -->
                        <CheckBox Content="⚡ Auto-Sync Every Bill &amp; Entry" IsChecked="{Binding AutoSyncToExcel}"
                                  Foreground="#6EE7B7" FontWeight="SemiBold" FontSize="11" Margin="16,0,0,0" VerticalAlignment="Center"
                                  ToolTip="When enabled, every print bill, photocopy, Xerox, cash in/out, and UPI transfer instantly updates your Excel file"/>
                    </StackPanel>

                    <!-- Right: Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Link / Attach Excel -->
                        <Button Content="📂 Link / Attach Excel" Command="{Binding LinkExcelFileCommand}"
                                Style="{StaticResource ChipShortcutBtn}" Background="#152E28" Foreground="#34D399" BorderBrush="#10B981"
                                Margin="0,0,8,0" Padding="10,5" FontSize="11" FontWeight="SemiBold"
                                ToolTip="Select or create an .xlsx file on your computer to auto-sync all records"/>

                        <!-- Sync Now -->
                        <Button Content="⚡ Sync Now" Command="{Binding SyncExcelNowCommand}"
                                Style="{StaticResource ChipShortcutBtn}" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#0284C7"
                                Margin="0,0,8,0" Padding="10,5" FontSize="11" FontWeight="SemiBold"
                                ToolTip="Manually trigger immediate synchronization to your linked Excel sheet"/>

                        <!-- Open Excel -->
                        <Button Content="↗️ Open in Excel" Command="{Binding OpenAttachedExcelCommand}"
                                Style="{StaticResource ChipShortcutBtn}" Background="#1E293B" Foreground="#FBBF24" BorderBrush="#D97706"
                                Margin="0,0,8,0" Padding="10,5" FontSize="11" FontWeight="SemiBold"
                                IsEnabled="{Binding HasAttachedExcel}"
                                ToolTip="Open the linked Excel workbook in Microsoft Excel / LibreOffice"/>

                        <!-- Export Full Workbook -->
                        <Button Content="📥 Export Full Workbook..." Command="{Binding ExportFullExcelCommand}"
                                Style="{StaticResource ChipShortcutBtn}" Background="#2E1C38" Foreground="#E879F9" BorderBrush="#A855F7"
                                Padding="10,5" FontSize="11" FontWeight="SemiBold"
                                ToolTip="Export all 4 structured sheets (Cash Drawer, Billing Summary, Itemized Register, Daily Finance KPIs) to a new file"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── ROW 3: Main Workspace ──────────────────────────────────── -->
            <Grid Grid.Row="3" Margin="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: Quick Entry & Balances -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Quick Action Card -->
                        <Border Background="#181A28" CornerRadius="10" BorderBrush="#282D42" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="⚡ QUICK ENTRY SHORTCUTS" FontWeight="Bold" FontSize="11" Foreground="#00BCD4" Margin="0,0,0,8"/>
                                <WrapPanel Margin="0,0,0,4">
                                    <Button Content="📱 Customer UPI ➔ Cash Given" Command="{Binding QuickUpiPayoutShortcutCommand}"
                                            Style="{StaticResource ChipShortcutBtn}" Margin="0,0,6,6"/>
                                    <Button Content="🤝 Customer Borrow (Due)" Command="{Binding QuickBorrowShortcutCommand}"
                                            Style="{StaticResource ChipShortcutBtn}" Margin="0,0,6,6"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Add Transaction Form -->
                        <Border Background="#181A28" CornerRadius="10" BorderBrush="#282D42" BorderThickness="1" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="➕ ADD CASH / BANK TRANSACTION" FontWeight="Bold" FontSize="13" Foreground="#10B981" Margin="0,0,0,12"/>

                                <!-- Category -->
                                <TextBlock Text="Category / Transaction Type:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding SelectedCategoryString}"
                                          Margin="0,0,0,10" Padding="8,6" FontSize="12.5" Background="#1A1C29" Foreground="White" BorderBrush="#2D314A"/>

                                <!-- Payment Medium (Cash vs Online UPI) -->
                                <TextBlock Text="Paid Through (Payment Medium):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton Content="💵 Cash in Till" IsChecked="{Binding IsCashMediumSelected}" Foreground="White" FontSize="11.5" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <RadioButton Content="📱 Online / UPI" IsChecked="{Binding IsOnlineMediumSelected}" Foreground="#38BDF8" FontSize="11.5" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Amount (Large) -->
                                <TextBlock Text="Amount (₹):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="₹" FontSize="20" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding AmountInput, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FormInputText}" FontSize="18" FontWeight="Bold" Foreground="#34D399" Margin="0"/>
                                </Grid>

                                <!-- Commission Fee (if UPI Cashout) -->
                                <TextBlock Text="Extra Commission / Fee (Optional ₹):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding CommissionInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInputText}"
                                         ToolTip="E.g. ₹10 extra charge earned by cafe for giving physical cash"/>

                                <!-- Customer / Person Name -->
                                <TextBlock Text="Customer / Person Name (Optional):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding CustomerNameInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInputText}"/>

                                <!-- Customer Phone -->
                                <TextBlock Text="Mobile Number (Optional):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding CustomerPhoneInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInputText}"/>

                                <!-- Description / Remarks -->
                                <TextBlock Text="Description / Notes:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DescriptionInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInputText}"/>

                                <!-- Submit Button -->
                                <Button Content="💾 RECORD ENTRY NOW" Command="{Binding AddTransactionCommand}"
                                        Style="{StaticResource PrimaryActionBtn}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Opening Balances Setup Card -->
                        <Border Background="#161824" CornerRadius="10" BorderBrush="#F59E0B" BorderThickness="1" Padding="14">
                            <StackPanel>
                                <TextBlock Text="🏦 OPENING BALANCES (Start of Day Float)" FontWeight="Bold" FontSize="11.5" Foreground="#F59E0B" Margin="0,0,0,8"/>
                                <TextBlock Text="Set opening float at start of morning. Carry-forward applies automatically." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                <TextBlock Text="Cash in Drawer Float (₹):" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding OpeningCashText, UpdateSourceTrigger=LostFocus, Converter={StaticResource DoubleStr}}" Style="{StaticResource FormInputText}" Margin="0,0,0,8"/>

                                <TextBlock Text="Online / Bank / UPI Float (₹):" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding OpeningOnlineText, UpdateSourceTrigger=LostFocus, Converter={StaticResource DoubleStr}}" Style="{StaticResource FormInputText}" Margin="0,0,0,10"/>

                                <Button Content="💾 Save Starting Balances" Command="{Binding SaveOpeningBalancesCommand}"
                                        Style="{StaticResource ChipShortcutBtn}" Foreground="#F59E0B" BorderBrush="#F59E0B" Padding="10,6" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- RIGHT COLUMN: Transactions Feed -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📜 TODAY'S FINANCIAL JOURNAL" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text=" • Live real-time ledger" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="🗑️ Clear Today's Journal"
                                Command="{Binding ClearTodayJournalCommand}"
                                ToolTip="Permanently clear and reset all today's cash &amp; UPI transactions (Warning dialog will confirm)"
                                Background="#361717" Foreground="#FCA5A5" BorderBrush="#EF4444" BorderThickness="1"
                                Padding="10,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Background="#181A28" CornerRadius="10" BorderBrush="#282D42" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Transactions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#24273A" BorderThickness="0,0,0,1" Padding="14,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Time -->
                                                <TextBlock Grid.Column="0" Text="{Binding TimeFormatted}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" Width="65"/>

                                                <!-- Description & Badge -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <Border Background="{Binding BadgeColor}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding CategoryBadge}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding MediumDisplay}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Description}" FontSize="12.5" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>

                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding CustomerName, StringFormat='Customer: {0}'}" FontSize="11" Foreground="#94A3B8"
                                                                   Visibility="{Binding CustomerName.Length, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="{Binding CustomerPhone, StringFormat=' • 📞 {0}'}" FontSize="11" Foreground="#64748B"
                                                                   Visibility="{Binding CustomerPhone.Length, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Amount -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0">
                                                    <TextBlock Text="{Binding AmountDisplay}" FontSize="15" FontWeight="Bold" Foreground="{Binding AmountColor}" HorizontalAlignment="Right"/>
                                                </StackPanel>

                                                <!-- Actions -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Repaid button (for debt) -->
                                                    <Button Content="✅ Cleared"
                                                            Command="{Binding DataContext.ClearDebtCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Id}"
                                                            Style="{StaticResource ChipShortcutBtn}" Background="#064E3B" Foreground="#34D399" BorderBrush="#10B981"
                                                            Margin="0,0,6,0" Padding="8,3" FontSize="11"
                                                            Visibility="{Binding IsCleared, Converter={StaticResource BoolToVis}, ConverterParameter=inverse}"/>

                                                    <!-- Delete button -->
                                                    <Button Content="🗑️"
                                                            Command="{Binding DataContext.DeleteTransactionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Id}"
                                                            Background="Transparent" BorderThickness="0" Foreground="#F87171"
                                                            FontSize="12" Cursor="Hand" Width="28" Height="28"
                                                            ToolTip="Delete entry"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
