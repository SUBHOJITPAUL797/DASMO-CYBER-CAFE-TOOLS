<Window x:Class="SmartSaver.Views.QuickPeekDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmartSaver.Converters"
        Title="DASMO CYBER COMPRESSOR — Quick Peek Preview" Height="680" Width="920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Sleek Floating Side Navigation Chevron Button -->
        <Style x:Key="FloatingNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#B0141420"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F03B82F6"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="Opacity" Value="1.0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D02563EB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.12"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="12" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Custom Header -->
            <Grid Background="{StaticResource SurfaceBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: File Badge, Name and Size -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                        <TextBlock Text="{Binding ExtensionUpper}" FontWeight="Bold" Foreground="#101018" FontSize="11"/>
                    </Border>
                    <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="380" ToolTip="{Binding FilePath}"/>
                    <TextBlock Text=" (" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding FileSizeFormatted}" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text=")" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Center: File Navigation Buttons & Counter -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#171822" CornerRadius="16" Padding="4,2" Margin="10,0"
                        BorderBrush="#38384E" BorderThickness="1"
                        Visibility="{Binding HasMultipleFiles, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Prev File -->
                        <Button Command="{Binding PrevFileCommand}" 
                                IsEnabled="{Binding CanGoPrevFile}"
                                ToolTip="{Binding PrevFileToolTip}"
                                Style="{StaticResource ChipButton}" 
                                Padding="8,3" Margin="0,0,3,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⏮" FontSize="10" Margin="0,0,4,0"/>
                                <TextBlock Text="Prev File" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Counter Pill -->
                        <Border Background="#252538" CornerRadius="10" Padding="8,2" Margin="2,0">
                            <TextBlock Text="{Binding FileNavigationDisplay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Next File -->
                        <Button Command="{Binding NextFileCommand}" 
                                IsEnabled="{Binding CanGoNextFile}"
                                ToolTip="{Binding NextFileToolTip}"
                                Style="{StaticResource ChipButton}" 
                                Padding="8,3" Margin="3,0,0,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Next File" FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0"/>
                                <TextBlock Text="⏭" FontSize="10"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Right: Window buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🗕" Width="40" Height="45" Background="Transparent" BorderThickness="0" Click="MinimizeButton_Click" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Button Content="✕" Width="45" Height="45" Background="Transparent" BorderThickness="0" Click="CloseButton_Click" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Main Preview Area -->
            <Grid Grid.Row="1" Margin="15" Background="#2B2D31">
                <!-- Loading Indicator -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,10" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Rendering High-Def Preview..." Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- PDF Previewer (Authentic Edge / Acrobat Slate Document Canvas) -->
                <Grid Visibility="{Binding IsPdf, Converter={StaticResource BoolToVis}}" Background="#2B2D31">
                    <!-- Normal Page View -->
                    <Grid Visibility="{Binding IsPasswordProtected, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <ScrollViewer x:Name="PdfScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                                      PreviewMouseLeftButtonDown="PanScrollViewer_MouseLeftButtonDown"
                                      PreviewMouseMove="PanScrollViewer_MouseMove"
                                      PreviewMouseLeftButtonUp="PanScrollViewer_MouseLeftButtonUp">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="0" Effect="{StaticResource PageDropShadow}">
                                    <Image x:Name="PdfPageImage" Source="{Binding SelectedPdfPage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.LayoutTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
                                                <RotateTransform Angle="{Binding PageRotation}"/>
                                            </TransformGroup>
                                        </Image.LayoutTransform>
                                    </Image>
                                </Border>
                            </Grid>
                        </ScrollViewer>

                        <!-- PDF Page, Rotation & Zoom Controls Overlay -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,15" Background="#EE1E1E2E" CornerRadius="20" Padding="14,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="◀ Prev" Command="{Binding PrevPageCommand}" Style="{StaticResource ChipButton}" Margin="0,0,10,0" ToolTip="Previous Page (← / PageUp)"/>
                                <TextBlock Text="{Binding CurrentPageDisplay}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="5,0,15,0"/>
                                <Button Content="Next ▶" Command="{Binding NextPageCommand}" Style="{StaticResource ChipButton}" Margin="0,0,15,0" ToolTip="Next Page (→ / PageDown)"/>

                                <Border Width="1" Background="{StaticResource BorderBrush}" Margin="0,2,15,2"/>

                                <Button Content="↺" Command="{Binding RotateCcwCommand}" Style="{StaticResource ChipButton}" Width="28" Margin="0,0,6,0" ToolTip="Rotate 90° CCW"/>
                                <Button Content="↻" Command="{Binding RotateCwCommand}" Style="{StaticResource ChipButton}" Width="28" Margin="0,0,15,0" ToolTip="Rotate 90° CW"/>

                                <Border Width="1" Background="{StaticResource BorderBrush}" Margin="0,2,15,2"/>

                                <Button Content="➖" Command="{Binding ZoomOutCommand}" Style="{StaticResource ChipButton}" Width="28" ToolTip="Zoom Out (Ctrl + -)"/>
                                <TextBlock Text="{Binding ZoomPercentageDisplay}" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="8,0" Width="42" TextAlignment="Center" FontSize="11"/>
                                <Button Content="➕" Command="{Binding ZoomInCommand}" Style="{StaticResource ChipButton}" Width="28" Margin="0,0,8,0" ToolTip="Zoom In (Ctrl + +)"/>
                                <Button Content="Fit" Command="{Binding ResetZoomCommand}" Style="{StaticResource ChipButton}" ToolTip="Reset Zoom (Ctrl + 0)"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Password Protected Overlay Card -->
                    <Border Visibility="{Binding IsPasswordProtected, Converter={StaticResource BoolToVis}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Background="#1E1F2E" CornerRadius="12" Padding="25,22" Width="420"
                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🔒 Password Protected PDF" FontWeight="Bold" FontSize="16" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="This document is locked with a password. Enter password below to unlock and view preview." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding PdfPassword, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="0,0,10,0" Padding="8,6" FontSize="13">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding UnlockPdfCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1" Content="🔓 Unlock" Command="{Binding UnlockPdfCommand}" Style="{StaticResource PrimaryButton}" Padding="15,6"/>
                            </Grid>

                            <TextBlock Text="{Binding PasswordErrorMessage}" Foreground="#EF4444" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="{Binding HasPasswordError, Converter={StaticResource BoolToVis}}"/>

                            <!-- Password Helper note for e-Aadhaar / e-Ration cards -->
                            <TextBlock Text="Tip: For e-Aadhaar use First 4 Name letters in CAPS + Birth Year (e.g. SUBH1995)." Foreground="#64748B" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Image Previewer -->
                <Grid Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" Background="#2B2D31">
                    <ScrollViewer x:Name="ImageScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                                  PreviewMouseLeftButtonDown="PanScrollViewer_MouseLeftButtonDown"
                                  PreviewMouseMove="PanScrollViewer_MouseMove"
                                  PreviewMouseLeftButtonUp="PanScrollViewer_MouseLeftButtonUp">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                            <Border Background="#14141E" CornerRadius="2" Effect="{StaticResource SoftDropShadow}">
                                <Image x:Name="ImageViewerImage" Source="{Binding ImageSource}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
                                    </Image.LayoutTransform>
                                </Image>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <!-- Image Zoom Controls Overlay -->
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,15" Background="#EE1E1E2E" CornerRadius="20" Padding="12,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="➖" Command="{Binding ZoomOutCommand}" Style="{StaticResource ChipButton}" Width="28" ToolTip="Zoom Out (Ctrl + -)"/>
                            <TextBlock Text="{Binding ZoomPercentageDisplay}" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="8,0" Width="42" TextAlignment="Center" FontSize="11"/>
                            <Button Content="➕" Command="{Binding ZoomInCommand}" Style="{StaticResource ChipButton}" Width="28" Margin="0,0,8,0" ToolTip="Zoom In (Ctrl + +)"/>
                            <Button Content="Fit" Command="{Binding ResetZoomCommand}" Style="{StaticResource ChipButton}" ToolTip="Reset Zoom (Ctrl + 0)"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Text Previewer -->
                <ScrollViewer Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding TextContent}" IsReadOnly="True" Background="#14141E" Foreground="#E0E0F0" FontFamily="Consolas" FontSize="12" Padding="15" BorderThickness="0"/>
                </ScrollViewer>

                <!-- Floating Left Chevron (Previous File) -->
                <Button Command="{Binding PrevFileCommand}"
                        IsEnabled="{Binding CanGoPrevFile}"
                        ToolTip="{Binding PrevFileToolTip}"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="8,0,0,0" Width="42" Height="42"
                        Visibility="{Binding HasMultipleFiles, Converter={StaticResource BoolToVis}}"
                        Cursor="Hand"
                        Style="{StaticResource FloatingNavButtonStyle}">
                    <TextBlock Text="❮" FontSize="18" FontWeight="Bold" Margin="-2,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

                <!-- Floating Right Chevron (Next File) -->
                <Button Command="{Binding NextFileCommand}"
                        IsEnabled="{Binding CanGoNextFile}"
                        ToolTip="{Binding NextFileToolTip}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,8,0" Width="42" Height="42"
                        Visibility="{Binding HasMultipleFiles, Converter={StaticResource BoolToVis}}"
                        Cursor="Hand"
                        Style="{StaticResource FloatingNavButtonStyle}">
                    <TextBlock Text="❯" FontSize="18" FontWeight="Bold" Margin="2,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

            </Grid>

            <!-- Bottom Action Toolbar (Clean, Spacious, Zero Clutter) -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="0,0,12,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Cyber Cafe Productivity Actions -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="⚡ Compress File..." Command="{Binding CompressCommand}" Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,10,0"/>
                        <Button Content="💳 Ration/Aadhaar Print" Command="{Binding GovtCardPrintCommand}" Style="{StaticResource AccentButton}" Padding="14,6" Margin="0,0,10,0" ToolTip="Batch crop and print 5 cards per A4 sheet"/>
                        <Button Content="🖨️ A4 Stacker" Command="{Binding StackCommand}" Padding="12,6" Margin="0,0,10,0" ToolTip="2-in-1 front/back ID stacker"/>
                        <Button Content="📁 Open Folder" Command="{Binding OpenFolderCommand}" Padding="12,6" ToolTip="Open file location in Windows Explorer"/>
                    </StackPanel>

                    <!-- Right: Clear Shortcut Hint & Close Button (No Overlap) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Navigate Files: ← / → or ↓ / ↑ • Space / Esc to Close" 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   VerticalAlignment="Center" Margin="0,0,16,0" FontSize="11.5"/>
                        <Button Content="Close (Esc)" Command="{Binding CloseCommand}" Width="100" Height="32"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
