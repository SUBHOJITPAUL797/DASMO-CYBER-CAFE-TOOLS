<Window x:Class="SmartSaver.Views.ImageCropDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crop &amp; Tweak ID Card — DASMO CYBER CAFE TOOLS"
        Height="720" Width="1000" MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterOwner"
        Background="#141520" Foreground="{StaticResource TextBrush}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <!-- Top info bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main visual crop editor area -->
            <RowDefinition Height="*"/>
            <!-- Bottom action bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✂️" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Crop &amp; Tweak ID Card Photo" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <RadioButton x:Name="RbModeBox" Content="🔲 Box Crop" IsChecked="True" Checked="CropMode_Changed" Margin="0,0,12,0" FontWeight="Bold"/>
                    <RadioButton x:Name="RbModeQuad" Content="📐 4-Corner Deskew (WhatsApp Doc Fixer)" Checked="CropMode_Changed" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" ToolTip="Straightens angled phone photos taken on bedsheets/tables into flat rectangles"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↶ 90° CCW" Click="RotateCCW_Click" Style="{StaticResource OutlineButton}" Height="30" Padding="8,2" Margin="0,0,4,0" ToolTip="Rotate photo 90 degrees counter-clockwise"/>
                    <Button Content="↷ 90° CW" Click="Rotate90_Click" Style="{StaticResource OutlineButton}" Height="30" Padding="8,2" Margin="0,0,6,0" ToolTip="Rotate photo 90 degrees clockwise"/>
                    <Button Content="🤖 Auto-Detect" Click="AutoDetect_Click" Style="{StaticResource PrimaryButton}" Height="30" Padding="12,2" ToolTip="Auto-detect card edges or corners"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CROP CANVAS & CONTROLS -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: INTERACTIVE CROP CANVAS -->
            <Border Grid.Column="0" Background="#0A0B10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True" SizeChanged="CanvasBorder_SizeChanged">
                <Canvas x:Name="CropCanvas" Background="Transparent" 
                        MouseLeftButtonDown="CropCanvas_MouseLeftButtonDown"
                        MouseMove="CropCanvas_MouseMove"
                        MouseLeftButtonUp="CropCanvas_MouseLeftButtonUp">

                    <!-- Background Image to Crop -->
                    <Image x:Name="ImgSource" Stretch="Uniform" Canvas.Left="0" Canvas.Top="0" 
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Dark Dimmed Overlay Around Crop Box (Box Mode) -->
                    <Path x:Name="DarkOverlayPath" Fill="#99000000" IsHitTestVisible="False"/>

                    <!-- Crop Rectangle Border (Box Mode) -->
                    <Rectangle x:Name="CropBox" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" 
                               StrokeDashArray="3 1" Fill="#01FFFFFF" Cursor="SizeAll"
                               MouseLeftButtonDown="CropBox_MouseLeftButtonDown"
                               MouseMove="CropBox_MouseMove"
                               MouseLeftButtonUp="CropBox_MouseLeftButtonUp"/>

                    <!-- 8 Resize Handles for Box Mode -->
                    <Thumb x:Name="ThumbTL" Width="14" Height="14" Cursor="SizeNWSE" DragDelta="ThumbTL_DragDelta" Margin="-7,-7,0,0">
                        <Thumb.Template>
                            <ControlTemplate>
                                <Border Background="{StaticResource AccentBrush}" BorderBrush="White" BorderThickness="1.5" CornerRadius="2"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <Thumb x:Name="ThumbT" Width="20" Height="10" Cursor="SizeNS" DragDelta="ThumbT_DragDelta" Margin="-10,-5,0,0">
                        <Thumb.Template>
                            <ControlTemplate>
                                <Border Background="{StaticResource AccentBrush}" BorderBrush="White" BorderThickness="1.5" CornerRadius="2"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <Thumb x:Name="ThumbTR" Width="14" Height="14" Cursor="SizeNESW" DragDelta="ThumbTR_DragDelta" Margin="-7,-7,0,0">
                        <Thumb.Template>
                            <ControlTemplate>
                                <Border Background="{StaticResource AccentBrush}" BorderBrush="White" BorderThickness="1.5" CornerRadius="2"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <Thumb x:Name="ThumbR" Width="10" Height="20" Cursor="SizeWE" DragDelta="ThumbR_DragDelta" Margin="-5,-10,0,0">
                        <Thumb.Template>
                            <ControlTemplate>
                                <Border Background="{StaticResource AccentBrush}" BorderBrush="White" BorderThickness="1.5" CornerRadius="2"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <Thumb x:Name="ThumbBR" Width="14" Height="14" Cursor="SizeNWSE" DragDelta="ThumbBR_DragDelta" Margin="-7,-7,0,0">
                        <Thumb.Template>
                            <ControlTemplate>
                                <Border Background="{StaticResource AccentBrush}" BorderBrush="White" BorderThickness="1.5" CornerRadius="2"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <Thumb x:Name="ThumbB" Width="20" Height="10" Cursor="SizeNS" DragDelta="ThumbB_DragDelta" Margin="-10,-5,0,0">
                        <Thumb.Template>
                            <ControlTemplate>
                                <Border Background="{StaticResource AccentBrush}" BorderBrush="White" BorderThickness="1.5" CornerRadius="2"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <Thumb x:Name="ThumbBL" Width="14" Height="14" Cursor="SizeNESW" DragDelta="ThumbBL_DragDelta" Margin="-7,-7,0,0">
                        <Thumb.Template>
                            <ControlTemplate>
                                <Border Background="{StaticResource AccentBrush}" BorderBrush="White" BorderThickness="1.5" CornerRadius="2"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <Thumb x:Name="ThumbL" Width="10" Height="20" Cursor="SizeWE" DragDelta="ThumbL_DragDelta" Margin="-5,-10,0,0">
                        <Thumb.Template>
                            <ControlTemplate>
                                <Border Background="{StaticResource AccentBrush}" BorderBrush="White" BorderThickness="1.5" CornerRadius="2"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>

                    <!-- 4-CORNER DESKEW / WHATSAPP UNWARP OVERLAY -->
                    <Polygon x:Name="QuadPolygon" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" 
                             StrokeDashArray="3 1" Fill="#2800BCD4" Visibility="Collapsed" IsHitTestVisible="False"/>

                    <Thumb x:Name="QuadThumbTL" Width="24" Height="24" DragDelta="QuadThumbTL_DragDelta" Visibility="Collapsed" Margin="-12,-12,0,0" Cursor="Hand">
                        <Thumb.Template>
                            <ControlTemplate>
                                <Grid>
                                    <Ellipse Fill="#FF00BCD4" Stroke="White" StrokeThickness="2"/>
                                    <TextBlock Text="TL" FontSize="9" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <Thumb x:Name="QuadThumbTR" Width="24" Height="24" DragDelta="QuadThumbTR_DragDelta" Visibility="Collapsed" Margin="-12,-12,0,0" Cursor="Hand">
                        <Thumb.Template>
                            <ControlTemplate>
                                <Grid>
                                    <Ellipse Fill="#FF00BCD4" Stroke="White" StrokeThickness="2"/>
                                    <TextBlock Text="TR" FontSize="9" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <Thumb x:Name="QuadThumbBR" Width="24" Height="24" DragDelta="QuadThumbBR_DragDelta" Visibility="Collapsed" Margin="-12,-12,0,0" Cursor="Hand">
                        <Thumb.Template>
                            <ControlTemplate>
                                <Grid>
                                    <Ellipse Fill="#FF00BCD4" Stroke="White" StrokeThickness="2"/>
                                    <TextBlock Text="BR" FontSize="9" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <Thumb x:Name="QuadThumbBL" Width="24" Height="24" DragDelta="QuadThumbBL_DragDelta" Visibility="Collapsed" Margin="-12,-12,0,0" Cursor="Hand">
                        <Thumb.Template>
                            <ControlTemplate>
                                <Grid>
                                    <Ellipse Fill="#FF00BCD4" Stroke="White" StrokeThickness="2"/>
                                    <TextBlock Text="BL" FontSize="9" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Canvas>
            </Border>

            <!-- RIGHT: SIDEBAR PRESETS & TOOLS -->
            <ScrollViewer Grid.Column="1" Margin="10,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Aspect Ratio Presets -->
                    <GroupBox Header="Aspect Ratio Preset" Margin="0,0,0,10">
                        <StackPanel Margin="4,6">
                            <RadioButton x:Name="RbPassport" Content="👤 Passport (3.5 × 4.5 cm / Ratio: 0.78)" 
                                         Checked="Preset_Checked" Margin="0,0,0,8" FontWeight="SemiBold"/>
                            <RadioButton x:Name="RbStamp" Content="🔖 Stamp / SSC (2.5 × 3.0 cm / Ratio: 0.83)" 
                                         Checked="Preset_Checked" Margin="0,0,0,8"/>
                            <RadioButton x:Name="RbIdCard" Content="💳 Standard ID Card&#x0a;    8.50 × 5.50 cm (Ratio: 1.55)" 
                                         IsChecked="True" Checked="Preset_Checked" Margin="0,0,0,8" FontWeight="SemiBold"/>
                            <RadioButton x:Name="RbRation" Content="🍚 Ration / Pocket Card&#x0a;    8.00 × 5.4 cm (1.48)" 
                                         Checked="Preset_Checked" Margin="0,0,0,8"/>
                            <RadioButton x:Name="RbFreeform" Content="📄 Freeform / Full Page" 
                                         Checked="Preset_Checked" Margin="0,0,0,2"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- WhatsApp / Mobile Tools -->
                    <GroupBox Header="📱 WhatsApp &amp; Mobile Fixer" Margin="0,0,0,10">
                        <StackPanel Margin="4,6">
                            <CheckBox x:Name="ChkRemoveShadows" Content="🪄 Remove Mobile Shadows (Magic White)" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,8" ToolTip="Cleans uneven room lighting, hand shadows, and turns paper pure white"/>
                            <Button Content="🤖 Auto-Detect 4 Corners" Click="AutoDetectCorners_Click" Style="{StaticResource AccentButton}" Height="32" Margin="0,0,0,6" ToolTip="Automatically finds 4 card corners in angled photo"/>
                            <Button Content="📐 Snap Corners to Card" Click="SnapCornersToCard_Click" Style="{StaticResource OutlineButton}" Height="30" Margin="0,0,0,6" ToolTip="Resets 4 corners to standard ID card proportion"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Quick Tools -->
                    <GroupBox Header="Quick Tools" Margin="0,0,0,10">
                        <StackPanel Margin="4,6">
                            <Button Content="👤 Snap to Passport (3.5×4.5)" Click="SnapToPassportRatio_Click" Style="{StaticResource AccentButton}" Height="30" Margin="0,0,0,6" ToolTip="Snap crop box to standard 3.5 × 4.5 cm passport ratio"/>
                            <Button Content="📏 Snap to ID Ratio (8.5×5.5)" Click="SnapToIdRatio_Click" Style="{StaticResource OutlineButton}" Height="30" Margin="0,0,0,6" ToolTip="Snap crop box to exact 8.56 × 5.4 cm aspect ratio"/>
                            <Button Content="🔄 Rotate 90° Clockwise" Click="Rotate90_Click" Style="{StaticResource OutlineButton}" Height="30" Margin="0,0,0,6" ToolTip="Rotate photo 90 degrees clockwise"/>
                            <Button Content="↺ Reset to Full Photo" Click="ResetToFull_Click" Style="{StaticResource OutlineButton}" Height="30"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Instructions / Tips -->
                    <Border Background="#10111A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                        <StackPanel>
                            <TextBlock Text="💡 Pro Tips:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="• In 4-Corner mode, drag the 4 pins (TL, TR, BR, BL) to card corners to unwarp slanted photos." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                            <TextBlock Text="• Check 'Remove Mobile Shadows' to eliminate phone shadows and make paper pure white." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                            <TextBlock Text="• Drag any edge handle to move that side independently." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- BOTTOM BAR -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Text="Ready to crop" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text=" | " Foreground="{StaticResource BorderBrush}" Margin="8,0"/>
                    <TextBlock x:Name="TxtOriginalDimensions" Text="Original: 0 × 0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text=" | " Foreground="{StaticResource BorderBrush}" Margin="8,0"/>
                    <TextBlock x:Name="TxtCropDimensions" Text="Crop: 0 × 0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource OutlineButton}" Width="90" Height="36" Margin="0,0,10,0" IsCancel="True"/>
                    <Button Content="✅ Apply Crop" Click="ApplyCrop_Click" Style="{StaticResource PrimaryButton}" Width="130" Height="36" FontWeight="Bold" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
