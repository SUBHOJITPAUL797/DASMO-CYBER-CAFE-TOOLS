<Application x:Class="SmartSaver.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SmartSaver.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
            <converters:InverseBooleanConverter x:Key="InverseBool"/>
            <converters:FileSizeFormatConverter x:Key="FileSizeConverter"/>
            <converters:StringEqualsConverter x:Key="StringEquals"/>
            <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
